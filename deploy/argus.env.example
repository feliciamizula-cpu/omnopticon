# Copy this file to deploy/argus.env before running docker compose.

ARGUS_POSTGRES_PASSWORD=change-me
ARGUS_RABBITMQ_PASSWORD=change-me-too
ARGUS_WEB_PORT=8080
ARGUS_GATEWAY_PORT=8081
ARGUS_REALTIME_PORT=8082

# Set to false only if an upstream platform provides health probes another way.
ARGUS_EXPOSE_HEALTH_ENDPOINTS=true

# Provider API keys passed to agent-service for CLI auth checks.
OPENCODE_AUTH_TOKEN=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=

# Optional Codex usage caps. When set above 0, the provider usage endpoint
# reports remaining usage by subtracting local Codex DB usage from these caps.
CODEX_FIVE_HOUR_LIMIT=0
CODEX_TWENTY_FOUR_HOUR_LIMIT=0
CODEX_WEEKLY_LIMIT=0
CODEX_MONTHLY_LIMIT=0
