# Copy this file to deploy/argus.env before running docker compose.

ARGUS_POSTGRES_PASSWORD=change-me
ARGUS_RABBITMQ_PASSWORD=change-me-too
ARGUS_WEB_PORT=8080
ARGUS_GATEWAY_PORT=8081
ARGUS_REALTIME_PORT=8082

# Set to false only if an upstream platform provides health probes another way.
ARGUS_EXPOSE_HEALTH_ENDPOINTS=true

# Provider API keys passed to agent-service for CLI auth checks.
OPENCODE_API_KEY=
OPENCODE_AUTH_TOKEN=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=

# Optional Codex usage caps. When set above 0, the provider usage endpoint
# reports remaining usage by subtracting local Codex DB usage from these caps.
CODEX_FIVE_HOUR_LIMIT=0
CODEX_FIVE_HOUR_USED=
CODEX_FIVE_HOUR_REMAINING=
CODEX_FIVE_HOUR_RESETS_AT=
CODEX_TWENTY_FOUR_HOUR_LIMIT=0
CODEX_TWENTY_FOUR_HOUR_USED=
CODEX_TWENTY_FOUR_HOUR_REMAINING=
CODEX_TWENTY_FOUR_HOUR_RESETS_AT=
CODEX_WEEKLY_LIMIT=0
CODEX_WEEKLY_USED=
CODEX_WEEKLY_REMAINING=
CODEX_WEEKLY_RESETS_AT=
CODEX_MONTHLY_LIMIT=0
CODEX_MONTHLY_USED=
CODEX_MONTHLY_REMAINING=
CODEX_MONTHLY_RESETS_AT=

# Optional OpenCode Go live usage copied from the OpenCode console.
# Limits are documented by OpenCode as $12/5h, $30/week, and $60/month.
OPENCODE_GO_FIVE_HOUR_USED=
OPENCODE_GO_FIVE_HOUR_REMAINING=
OPENCODE_GO_FIVE_HOUR_RESETS_AT=
OPENCODE_GO_WEEKLY_USED=
OPENCODE_GO_WEEKLY_REMAINING=
OPENCODE_GO_WEEKLY_RESETS_AT=
OPENCODE_GO_MONTHLY_USED=
OPENCODE_GO_MONTHLY_REMAINING=
OPENCODE_GO_MONTHLY_RESETS_AT=
