# syntax=docker/dockerfile:1

ARG DOTNET_VERSION=10.0
ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown
ARG PROJECT_PATH=src/Argus.Web/Argus.Web.csproj
ARG ASSEMBLY_NAME=Argus.Web
ARG AMASS_VERSION=4.2.0
ARG AMASS_LINUX_AMD64_SHA256=abef624f84b21fb45d4b9d39693863c6bf4e9ddb94830f797c129d03937a7f03
ARG SUBFINDER_VERSION=2.14.0
ARG SUBFINDER_LINUX_AMD64_SHA256=6529294788f56a20ed96a9b70e71f8f3c247f1d6104ba1e2c2e9e58d8a32c6cb

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION} AS build
WORKDIR /src

ARG PROJECT_PATH
ARG ASSEMBLY_NAME

COPY global.json Directory.Build.props Directory.Build.targets Directory.Packages.props ./
COPY nuget.config ./

COPY src/Argus.ServiceDefaults/Argus.ServiceDefaults.csproj                       src/Argus.ServiceDefaults/
COPY src/Contracts/Argus.Contracts/Argus.Contracts.csproj                         src/Contracts/Argus.Contracts/
COPY src/BuildingBlocks/Argus.BuildingBlocks.Artifacts/Argus.BuildingBlocks.Artifacts.csproj             src/BuildingBlocks/Argus.BuildingBlocks.Artifacts/
COPY src/BuildingBlocks/Argus.BuildingBlocks.EventBus/Argus.BuildingBlocks.EventBus.csproj               src/BuildingBlocks/Argus.BuildingBlocks.EventBus/
COPY src/BuildingBlocks/Argus.BuildingBlocks.EventDrivenWorkers/Argus.BuildingBlocks.EventDrivenWorkers.csproj src/BuildingBlocks/Argus.BuildingBlocks.EventDrivenWorkers/
COPY src/BuildingBlocks/Argus.BuildingBlocks.RateLimiting/Argus.BuildingBlocks.RateLimiting.csproj       src/BuildingBlocks/Argus.BuildingBlocks.RateLimiting/
COPY src/BuildingBlocks/Argus.BuildingBlocks.WorkerDistribution/Argus.BuildingBlocks.WorkerDistribution.csproj src/BuildingBlocks/Argus.BuildingBlocks.WorkerDistribution/
COPY src/BuildingBlocks/Argus.BuildingBlocks.Workers/Argus.BuildingBlocks.Workers.csproj                 src/BuildingBlocks/Argus.BuildingBlocks.Workers/
COPY ${PROJECT_PATH} ${PROJECT_PATH}

RUN dotnet restore ${PROJECT_PATH}

COPY src/ src/
RUN dotnet publish ${PROJECT_PATH} \
    -c Release \
    -o /app/publish \
    -p:TreatWarningsAsErrors=false

# dotnet publish auto-copies blazor.web.js from the SDK package via MSBuild target.
# The --no-restore flag skips this on .NET 10; restore the file manually if missing.
RUN if [ ! -f /app/publish/wwwroot/_framework/blazor.web.js ]; then \
      mkdir -p /app/publish/wwwroot/_framework; \
      cp "$(find /root/.nuget/packages/microsoft.aspnetcore.app.ref -name 'ref/net*/Microsoft.AspNetCore.Components.Web.dll' 2>/dev/null | head -1 | sed 's|.DLL$|.js|;s|ref/|dist/|i')" /app/publish/wwwroot/_framework/blazor.web.js 2>/dev/null || \
      cp "$(find /root/.nuget/packages/microsoft.aspnetcore.app.internal.assets -name 'blazor.web.js' 2>/dev/null | head -1)" /app/publish/wwwroot/_framework/blazor.web.js 2>/dev/null || \
      cp "/tmp/publish-test/wwwroot/_framework/blazor.web.js" /app/publish/wwwroot/_framework/blazor.web.js 2>/dev/null || \
      echo "WARNING: blazor.web.js not found, interactive Blazor may not work"; \
    fi

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION}
WORKDIR /app

ARG GIT_SHA
ARG BUILD_DATE
ARG ASSEMBLY_NAME=Argus.Web
ARG AMASS_VERSION
ARG AMASS_LINUX_AMD64_SHA256
ARG SUBFINDER_VERSION
ARG SUBFINDER_LINUX_AMD64_SHA256

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgssapi-krb5-2 python3 python3-pip \
    && if [ "$ASSEMBLY_NAME" = "Argus.Workers.Amass" ]; then \
        apt-get install -y --no-install-recommends curl unzip \
        && curl -fsSL -o /tmp/amass.zip "https://github.com/owasp-amass/amass/releases/download/v${AMASS_VERSION}/amass_Linux_amd64.zip" \
        && echo "${AMASS_LINUX_AMD64_SHA256}  /tmp/amass.zip" | sha256sum -c - \
        && unzip -q /tmp/amass.zip -d /tmp/amass \
        && install -m 0755 "/tmp/amass/amass_Linux_amd64/amass" /usr/local/bin/amass \
        && rm -rf /tmp/amass /tmp/amass.zip; \
    fi \
    && if [ "$ASSEMBLY_NAME" = "Argus.Workers.Subfinder" ]; then \
        apt-get install -y --no-install-recommends curl unzip \
        && curl -fsSL -o /tmp/subfinder.zip "https://github.com/projectdiscovery/subfinder/releases/download/v${SUBFINDER_VERSION}/subfinder_${SUBFINDER_VERSION}_linux_amd64.zip" \
        && echo "${SUBFINDER_LINUX_AMD64_SHA256}  /tmp/subfinder.zip" | sha256sum -c - \
        && unzip -q /tmp/subfinder.zip -d /tmp/subfinder \
        && install -m 0755 /tmp/subfinder/subfinder /usr/local/bin/subfinder \
        && rm -rf /tmp/subfinder /tmp/subfinder.zip; \
    fi \
    && if [ "$ASSEMBLY_NAME" = "Argus.Workers.Sublist3r" ]; then \
        pip3 install --no-cache-dir --break-system-packages sublist3r; \
    fi \
    && if [ "$ASSEMBLY_NAME" = "Argus.AgentService" ]; then apt-get install -y --no-install-recommends nodejs npm && npm install -g @openai/codex@0.133.0; fi \
    && rm -rf /var/lib/apt/lists/*

LABEL org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="${ASSEMBLY_NAME}"

ENV ARGUS_VERSION=${GIT_SHA}
ENV ARGUS_GIT_SHA=${GIT_SHA}
ENV ARGUS_BUILD_DATE=${BUILD_DATE}
ENV ASPNETCORE_URLS=http://+:8080
ENV DOTNET_EnableDiagnostics=0
ENV DOTNET_GCConserveMemory=9
ENV ASSEMBLY_DLL=${ASSEMBLY_NAME}.dll

EXPOSE 8080

COPY --from=build /app/publish .

RUN if [ -d /app/wwwroot ]; then echo "window.__ARGUS_BUILD__ = { version: \"${GIT_SHA}\", date: \"${BUILD_DATE}\" };" > /app/wwwroot/version.js; fi

ENTRYPOINT ["sh", "-c", "exec dotnet $ASSEMBLY_DLL"]
