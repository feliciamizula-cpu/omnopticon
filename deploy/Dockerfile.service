# syntax=docker/dockerfile:1

ARG DOTNET_VERSION=10.0

ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION} AS build
WORKDIR /src

COPY . .

ARG PROJECT_PATH
RUN dotnet restore "$PROJECT_PATH"
RUN dotnet publish "$PROJECT_PATH" -c Release -o /app/publish --no-restore

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION}
WORKDIR /app

ARG GIT_SHA
ARG BUILD_DATE
ENV ARGUS_VERSION=${GIT_SHA}
ENV ARGUS_BUILD_DATE=${BUILD_DATE}
ENV PORT=8080

ARG ASSEMBLY_NAME
ENV ARGUS_ASSEMBLY_NAME=${ASSEMBLY_NAME}
ENV ASPNETCORE_URLS=http://+:8080
ENV DOTNET_EnableDiagnostics=0

EXPOSE 8080

# Copy published app
COPY --from=build /app/publish .

# Write version info for frontend
RUN echo "window.__ARGUS_BUILD__ = { version: '"$GIT_SHA"', date: '"$BUILD_DATE"' };" > /app/wwwroot/version.js

# Background CLI installer - runs Claude install in background after container starts
# This doesn't block startup and CLIs will be available once download completes
RUN echo '#!/bin/bash\n\
install_in_background() {\n\
  echo "[bg-cli] Starting background Claude installation..."\n\
  curl -fsSL https://downloads.anthropic.com/claude/Claude-latest-linux-x86_64 -o /usr/local/bin/claude 2>/dev/null &\n\
  CurlPid=$!\n\
  echo "[bg-cli] Download started in background (PID: $CurlPid)"\n\
  # Wait a bit for download to start, then return immediately\n\
  sleep 2\n\
  echo "[bg-cli] Claude will be available once download completes. Other CLIs install on-demand."\n\
}\n\
install_in_background\n\
' > /bg-cli-installer.sh && chmod +x /bg-cli-installer.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 CMD curl -f http://localhost:8080/ || exit 1

# Start background CLI installer, then run dotnet app
ENTRYPOINT ["/bin/bash", "-c", "/bg-cli-installer.sh && dotnet ${ARGUS_ASSEMBLY_NAME}.dll"]
