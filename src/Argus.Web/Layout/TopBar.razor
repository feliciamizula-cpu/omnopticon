@inject IConfiguration Configuration
@using System.Reflection

<header class="topbar">
  <div class="topbar-section topbar-brand">
    <div class="topbar-brand-name">ArgusEngine</div>
    <div class="topbar-build">@BuildLabel</div>
  </div>

  <div class="topbar-divider"></div>

  <div class="topbar-section">
    <div class="topbar-status">
      <span class="topbar-status-dot"></span>
      <span>Operational</span>
    </div>
  </div>
  
  <div class="topbar-divider"></div>
  
  <div class="topbar-section">
    <select class="input" style="width: 180px;">
      <option value="">All Targets</option>
    </select>
  </div>
  
  <div class="topbar-section right">
    @if (!string.IsNullOrWhiteSpace(DashboardUrl))
    {
      <a class="btn" href="@DashboardUrl" target="_blank" rel="noopener" title="Open Aspire dashboard (logs, traces, metrics)">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" style="margin-right:6px;"><path d="M2 2h5v5H2V2zm7 0h5v3H9V2zM9 7h5v7H9V7zM2 9h5v5H2V9z"/></svg>
        Aspire
      </a>
    }
    <button class="btn btn-icon" title="Notifications">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1a5 5 0 00-5 5v2H2a1 1 0 00-1 1v2a3 3 0 006 0h4a3 3 0 006 0v-2a1 1 0 00-1-1h-1V6a5 5 0 00-5-5zm-3 12a1 1 0 112 0 1 1 0 01-2 0z"/></svg>
    </button>

    <button class="btn btn-icon" title="Settings">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 10a2 2 0 100-4 2 2 0 000 4zM13 8l-1-2h-4L3 8M14 6l-2-1.5M2 6l2-1.5"/></svg>
    </button>
  </div>
</header>

@code {
  private string? DashboardUrl => Configuration["ARGUS_DASHBOARD_URL"];

  private string BuildLabel
  {
    get
    {
      var version = Configuration["ARGUS_VERSION"];
      var buildDate = Configuration["ARGUS_BUILD_DATE"];
      if (string.IsNullOrWhiteSpace(version) || version.Equals("unknown", StringComparison.OrdinalIgnoreCase))
      {
        version = typeof(TopBar).Assembly
          .GetCustomAttribute<AssemblyInformationalVersionAttribute>()
          ?.InformationalVersion;
      }

      if (string.IsNullOrWhiteSpace(version))
      {
        return "dev build";
      }

      var revisionIndex = version.IndexOf('+', StringComparison.Ordinal);
      if (revisionIndex >= 0 && revisionIndex < version.Length - 1)
      {
        version = version[(revisionIndex + 1)..];
      }

      var shortVersion = version.Length > 7 ? version[..7] : version;
      return string.IsNullOrWhiteSpace(buildDate) || buildDate.Equals("unknown", StringComparison.OrdinalIgnoreCase)
        ? $"v{shortVersion}"
        : $"v{shortVersion} · {buildDate}";
    }
  }
}
