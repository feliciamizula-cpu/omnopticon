@inject NavigationManager Nav

<aside class="sidebar @(Collapsed ? "collapsed" : "")">
  <div class="sidebar-header">
    <button class="sidebar-toggle" @onclick="OnToggle" title="@(Collapsed ? "Expand" : "Collapse")">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        @if (Collapsed)
        {
          <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        }
        else
        {
          <path d="M10 4l-4 4 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        }
      </svg>
    </button>
    <span class="sidebar-brand">ArgusEngine</span>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-section">
      <div class="nav-section-title">Reconnaissance</div>
      <NavLink href="/command-center" class="nav-item" ActiveClass="active">
        <span class="nav-item-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1a7 7 0 100 14A7 7 0 008 1zm0 12.5A5.5 5.5 0 118 2.5a5.5 5.5 0 010 11z"/></svg>
        </span>
        <span class="nav-item-text">Command Center</span>
      </NavLink>
      <NavLink href="/targets" class="nav-item" ActiveClass="active">
        <span class="nav-item-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="3"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2"/></svg>
        </span>
        <span class="nav-item-text">Targets</span>
      </NavLink>
      <NavLink href="/assets" class="nav-item" ActiveClass="active">
        <span class="nav-item-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/><rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/></svg>
        </span>
        <span class="nav-item-text">Assets</span>
      </NavLink>
      <NavLink href="/asset-types" class="nav-item" ActiveClass="active">
        <span class="nav-item-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M4 2h8l4 4v8H4V2zM2 2v12h12"/></svg>
        </span>
        <span class="nav-item-text">Asset Types</span>
      </NavLink>
      <NavLink href="/operations" class="nav-item" ActiveClass="active">
        <span class="nav-item-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M2 4h12v2H2zM2 9h8v2H2zM2 14h5v-2H2z"/><circle cx="12" cy="11" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M14.5 13.5l1.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </span>
        <span class="nav-item-text">Operations</span>
      </NavLink>
    </div>

    <div class="nav-section">
      <div class="nav-section-title">Workers</div>
      <NavLink href="/workers" class="nav-item" ActiveClass="active">
        <span class="nav-item-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="5" r="3"/><path d="M2 14c0-3 2.5-5 6-5s6 2 6 5"/></svg>
        </span>
        <span class="nav-item-text">Workers</span>
      </NavLink>
      <NavLink href="/worker-types" class="nav-item" ActiveClass="active">
        <span class="nav-item-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 2l1.5 3 3.5.5-2.5 2.5.5 3.5L8 9.5l-3 2 .5-3.5L3 5.5 6.5 5z"/></svg>
        </span>
        <span class="nav-item-text">Worker Types</span>
      </NavLink>
    </div>

    <div class="nav-section">
      <div class="nav-section-title">Programs</div>
      <NavLink href="/subscriptions" class="nav-item" ActiveClass="active">
        <span class="nav-item-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M3 4h10v8H3zM1 4h2M13 4h2M1 12h2M13 12h2"/></svg>
        </span>
        <span class="nav-item-text">Subscriptions</span>
      </NavLink>
      <NavLink href="/tasks" class="nav-item" ActiveClass="active">
        <span class="nav-item-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="2" y="2" width="12" height="12" rx="2"/><path d="M5 8l2 2 4-4"/></svg>
        </span>
        <span class="nav-item-text">Tasks / Runs</span>
      </NavLink>
      <NavLink href="/contexts" class="nav-item" ActiveClass="active">
        <span class="nav-item-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="6"/><path d="M8 5v3l2 2"/></svg>
        </span>
        <span class="nav-item-text">Contexts / Checkpoints</span>
      </NavLink>
    </div>

    <div class="nav-section">
      <div class="nav-section-title">Findings</div>
      <NavLink href="/findings" class="nav-item" ActiveClass="active">
        <span class="nav-item-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l2 5h5l-4 3.5 1.5 5L8 12l-4.5 2.5 1.5-5L1 6h5z"/></svg>
        </span>
        <span class="nav-item-text">Findings</span>
      </NavLink>
      <NavLink href="/events" class="nav-item" ActiveClass="active">
        <span class="nav-item-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="2" y="3" width="12" height="10" rx="1"/><path d="M5 1v4M11 1v4M2 7h12"/></svg>
        </span>
        <span class="nav-item-text">Events</span>
      </NavLink>
    </div>

    <div class="nav-section">
      <div class="nav-section-title">Development</div>
      <NavLink href="/agents" class="nav-item" ActiveClass="active">
        <span class="nav-item-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><circle cx="5" cy="4" r="1.5"/><circle cx="11" cy="4" r="1.5"/><path d="M3 7h4M9 7h4M2 10l.5-1h11l.5 1M4 14h8"/></svg>
        </span>
        <span class="nav-item-text">Agent Config</span>
      </NavLink>
      <NavLink href="/development/environments" class="nav-item" ActiveClass="active">
        <span class="nav-item-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M2 3h12v7H2zM4 12h8v1H4zM6 14h4v1H6z"/></svg>
        </span>
        <span class="nav-item-text">Environments</span>
      </NavLink>
      <NavLink href="/agent-tasks" class="nav-item" ActiveClass="active">
        <span class="nav-item-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="2" y="2" width="12" height="12" rx="2"/><path d="M5 8l2 2 4-4"/></svg>
        </span>
        <span class="nav-item-text">Agent Tasks</span>
      </NavLink>

<NavLink href="/provider-usage" class="nav-item" ActiveClass="active">
  <span class="nav-item-icon">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M2 12h12v2H2zM3 9h2v2H3zM7 6h2v5H7zM11 3h2v8h-2z"/></svg>
  </span>
  <span class="nav-item-text">Provider Usage</span>
</NavLink>
<NavLink href="/todos" class="nav-item" ActiveClass="active">
  <span class="nav-item-icon">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M2 2h12v12H2z"/></svg>
  </span>
  <span class="nav-item-text">Todos</span>
</NavLink>
    </div>

    <div class="nav-section">
      <div class="nav-section-title">System</div>
      <NavLink href="/settings" class="nav-item" ActiveClass="active">
        <span class="nav-item-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 10a2 2 0 100-4 2 2 0 000 4zM13 8l-1-2h-4L3 8M14 6l-2-1.5M2 6l2-1.5"/></svg>
        </span>
        <span class="nav-item-text">Settings</span>
      </NavLink>
    </div>
  </nav>
</aside>

@code {
  [Parameter] public bool Collapsed { get; set; }
  [Parameter] public EventCallback OnToggle { get; set; }
}
