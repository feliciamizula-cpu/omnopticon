@typeparam TItem
@implements IAsyncDisposable

<CascadingValue Value="this" IsFixed="true">
<div class="ag" style="--ag-cols: @_colsTemplate">
    @ChildContent

    @* ── Toolbar ── *@
    <div class="ag-bar">
        <input class="ag-search" type="search" placeholder="search…"
               value="@_search" @oninput="OnSearch" @onkeydown="OnSearchKey" />
        @if (_hasFilterable)
        {
            <button class="ag-icon-btn @(_showFilters ? "active" : "")"
                    title="Toggle column filters" @onclick="ToggleFilters">⊟</button>
        }
        @if (_sortable.Count > 0)
        {
            <select class="ag-select" value="@(_sortCol ?? "")" @onchange="OnSortChange" title="Sort by">
                <option value="">sort…</option>
                @foreach (var h in _sortable)
                {
                    <option value="@h">@h</option>
                }
            </select>
        }
        @if (ToolbarContent is not null)
        {
            @ToolbarContent
        }
        <span class="ag-count">@_processed.Count<span class="ag-count-sep">/</span>@Items.Count</span>
    </div>

    @* ── Scrollable region: sticky header + virtual rows ── *@
    <div class="ag-scroll">

        @* Sticky header *@
        <div class="ag-head ag-row-grid">
            @foreach (var col in ActiveColumns)
            {
                var c = col;
                <div class="ag-th @HeadCls(c)"
                     style="@(col.Width is not null ? $"min-width:{col.Width};width:{col.Width}" : "")"
                     @onclick="() => ClickSort(c)" title="@c.Header">@c.Header</div>
            }
        </div>

        @* Optional per-column filter row *@
        @if (_showFilters)
        {
            <div class="ag-filter-row ag-row-grid">
                @foreach (var col in ActiveColumns)
                {
                    var c = col;
                    <div class="ag-fc">
                        @if (c.Searchable && c.Value is not null)
                        {
                            <input class="ag-fi"
                                   value="@GetFilter(c)"
                                   @oninput="e => SetFilter(c, e.Value?.ToString())"
                                   placeholder="…" />
                        }
                    </div>
                }
            </div>
        }

        @* Virtualized body *@
        <Virtualize Items="_processed" ItemSize="28" OverscanCount="8" Context="item">
            <div class="ag-row ag-row-grid @(IsSelected(item) ? "ag-sel" : "")"
                 @onclick="() => ClickRow(item)">
                @foreach (var col in ActiveColumns)
                {
                    var c = col;
                    <div class="ag-td @(c.Primary ? "ag-primary" : "")"
                         style="@(c.Width is not null ? $"width:{c.Width};min-width:{c.Width}" : "")">
                        @if (c.CellTemplate is not null)
                        {
                            @c.CellTemplate(item)
                        }
                        else
                        {
                            @c.Value?.Invoke(item)
                        }
                    </div>
                }
            </div>
        </Virtualize>

        @if (_processed.Count == 0)
        {
            <div class="ag-empty">@(EmptyMessage ?? "// no results")</div>
        }
    </div>
</div>
</CascadingValue>

@code {
    [Parameter, EditorRequired] public List<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public List<GridColumn<TItem>> Columns { get; set; } = [];
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public TItem? SelectedItem { get; set; }
    [Parameter] public Func<TItem, object?>? ItemKey { get; set; }
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }
    [Parameter] public string? EmptyMessage { get; set; }
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    [Parameter] public int LiveRefreshSeconds { get; set; }
    [Parameter] public EventCallback OnLiveRefresh { get; set; }

    private string _colsTemplate = "";
    private bool _hasFilterable;
    private List<string> _sortable = [];

    private string _search = "";
    private bool _showFilters;
    private string? _sortCol;
    private bool _sortAsc = true;
    private Dictionary<string, string> _colFilters = new(StringComparer.Ordinal);

    private List<TItem> _processed = [];
    private readonly List<GridColumn<TItem>> _registeredColumns = [];

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    private IReadOnlyList<GridColumn<TItem>> ActiveColumns =>
        Columns.Count > 0 ? Columns : _registeredColumns;

    protected override void OnParametersSet()
    {
        var activeColumns = ActiveColumns;

        var newTemplate = string.Join(" ", activeColumns.Select(c => c.Width ?? "minmax(0, 1fr)"));
        if (newTemplate != _colsTemplate)
        {
            _colsTemplate = newTemplate;
            _hasFilterable = activeColumns.Any(c => c.Searchable && c.Value is not null);
            _sortable = activeColumns.Where(c => c.Sortable && c.Value is not null).Select(c => c.Header).ToList();
        }
        Recompute();

        if (LiveRefreshSeconds > 0 && _timer is null)
        {
            _cts = new CancellationTokenSource();
            _timer = new PeriodicTimer(TimeSpan.FromSeconds(LiveRefreshSeconds));
            _ = RunTimerAsync(_cts.Token);
        }
    }

    private void Recompute()
    {
        var activeColumns = ActiveColumns;
        IEnumerable<TItem> rows = Items;

        if (_search.Length > 0)
        {
            var q = _search;
            rows = rows.Where(item => activeColumns.Any(c =>
                c.Searchable && c.Value?.Invoke(item)?.Contains(q, StringComparison.OrdinalIgnoreCase) == true));
        }

        foreach (var (header, filter) in _colFilters)
        {
            if (filter.Length == 0) continue;
            var col = activeColumns.FirstOrDefault(c => c.Header == header);
            if (col?.Value is null) continue;
            var fv = filter;
            rows = rows.Where(item =>
                col.Value(item)?.Contains(fv, StringComparison.OrdinalIgnoreCase) == true);
        }

        if (_sortCol is not null)
        {
            var col = activeColumns.FirstOrDefault(c => c.Header == _sortCol);
            if (col?.Value is not null)
            {
                rows = _sortAsc
                    ? rows.OrderBy(col.Value, StringComparer.OrdinalIgnoreCase)
                    : rows.OrderByDescending(col.Value, StringComparer.OrdinalIgnoreCase);
            }
        }

        _processed = rows.ToList();
    }

    private async Task RunTimerAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested && _timer is not null)
        {
            try
            {
                if (!await _timer.WaitForNextTickAsync(ct)) break;
                await OnLiveRefresh.InvokeAsync();
            }
            catch (OperationCanceledException) { break; }
            catch { }
        }
    }

    private void OnSearch(ChangeEventArgs e) { _search = e.Value?.ToString() ?? ""; Recompute(); }
    private void OnSearchKey(KeyboardEventArgs e) { if (e.Key == "Escape") { _search = ""; Recompute(); } }
    private void ToggleFilters() => _showFilters = !_showFilters;

    private void OnSortChange(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _sortCol = string.IsNullOrEmpty(v) ? null : v;
        Recompute();
    }

    public void RegisterColumn(ArgusGridColumn<TItem> column)
    {
        var mapped = new GridColumn<TItem>
        {
            Header = column.Header,
            Value = column.Value,
            CellTemplate = column.CellTemplate,
            Width = column.Width,
            Sortable = column.Sortable,
            Searchable = column.Searchable
        };
        _registeredColumns.RemoveAll(c => c.Header == column.Header);
        _registeredColumns.Add(mapped);
    }

    public void RemoveColumn(ArgusGridColumn<TItem> column)
    {
        _registeredColumns.RemoveAll(c => c.Header == column.Header);
    }

    private string GetFilter(GridColumn<TItem> col) =>
        _colFilters.TryGetValue(col.Header, out var v) ? v : "";

    private void SetFilter(GridColumn<TItem> col, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) _colFilters.Remove(col.Header);
        else _colFilters[col.Header] = value;
        Recompute();
    }

    private void ClickSort(GridColumn<TItem> col)
    {
        if (!col.Sortable || col.Value is null) return;
        if (_sortCol == col.Header) _sortAsc = !_sortAsc;
        else { _sortCol = col.Header; _sortAsc = true; }
        Recompute();
    }

    private async Task ClickRow(TItem item) => await OnRowClick.InvokeAsync(item);

    private bool IsSelected(TItem item)
    {
        if (SelectedItem is null) return false;
        if (ItemKey is not null) return Equals(ItemKey(item), ItemKey(SelectedItem));
        return EqualityComparer<TItem>.Default.Equals(item, SelectedItem);
    }

    private string HeadCls(GridColumn<TItem> col)
    {
        if (!col.Sortable || col.Value is null) return "";
        if (_sortCol != col.Header) return "ag-sortable";
        return _sortAsc ? "ag-sortable ag-asc" : "ag-sortable ag-desc";
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts is not null) { await _cts.CancelAsync(); _cts.Dispose(); }
        _timer?.Dispose();
        _timer = null;
    }
}