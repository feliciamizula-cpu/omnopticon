@typeparam TItem
@implements IDisposable

<div class="argus-grid">
    @* Render column definitions so they can register themselves *@
    <CascadingValue Value="this" IsFixed="true">
        @Columns
    </CascadingValue>

    <div class="argus-grid-toolbar">
        <input class="argus-grid-search"
               type="text"
               placeholder="search…"
               value="@_search"
               @oninput="OnSearchInput" />

        <button class="btn ghost tiny" @onclick="ToggleFilters" title="Column filters">
            @(_showFilters ? "▼ Filters" : "▷ Filters")
        </button>

        @if (_groupableColumns.Count > 0)
        {
            <select class="argus-grid-search" style="width:140px;" value="@_groupByCol" @onchange="OnGroupByChange">
                <option value="">— no grouping —</option>
                @foreach (var col in _groupableColumns)
                {
                    <option value="@col.Header">@col.Header</option>
                }
            </select>
        }

        @if (!string.IsNullOrEmpty(_sortHeader))
        {
            <span class="argus-grid-count" style="margin-left:0;">
                sorted by @_sortHeader @(_sortAsc ? "↑" : "↓")
            </span>
        }

        @ToolbarExtra

        <span class="argus-grid-count">@_flatRows.Count rows</span>
    </div>

    <div class="argus-grid-table-wrap">
        <table>
            <colgroup>
                @foreach (var col in _columns)
                {
                    <col style="@(col.Width is not null ? $"width:{col.Width}" : "")" />
                }
            </colgroup>
            <thead>
                <tr>
                    @foreach (var col in _columns)
                    {
                        var colRef = col;
                        var thClass = col.Sortable
                            ? (_sortHeader == col.Header
                                ? (_sortAsc ? "sorted-asc" : "sorted-desc")
                                : "")
                            : "no-sort";
                        <th class="@thClass @(col.Sticky ? "sticky-col" : "")"
                            @onclick="() => { if (colRef.Sortable) SortBy(colRef); }">
                            @col.Header
                        </th>
                    }
                </tr>
                @if (_showFilters)
                {
                    <tr class="filter-row">
                        @foreach (var col in _columns)
                        {
                            <td>
                                <input class="argus-grid-filter-input"
                                       placeholder="filter…"
                                       value="@GetFilter(col.Header)"
                                       @oninput="e => SetFilter(col.Header, e.Value?.ToString())" />
                            </td>
                        }
                    </tr>
                }
            </thead>
            <tbody>
                <Virtualize Items="_flatRows" ItemSize="28" Context="gridRow">
                    @RenderRow(gridRow)
                </Virtualize>
            </tbody>
        </table>
    </div>
</div>

@code {
    // ── Parameters ──────────────────────────────────────────────────────────────

    [Parameter] public IReadOnlyList<TItem> Items { get; set; } = Array.Empty<TItem>();
    [Parameter] public Func<TItem, bool>? Filter { get; set; }
    [Parameter] public string? SearchQuery { get; set; }
    [Parameter] public string? GroupBy { get; set; }
    [Parameter] public RenderFragment? ToolbarExtra { get; set; }
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }
    [Parameter] public TItem? SelectedItem { get; set; }
    [Parameter] public RenderFragment? Columns { get; set; }

    // ── Internal state ───────────────────────────────────────────────────────────

    internal List<ArgusGridColumn<TItem>> _columns = new();
    private List<GridRow> _flatRows = new();

    private string _search = "";
    private bool _showFilters;
    private string? _sortHeader;
    private bool _sortAsc = true;
    private string _groupByCol = "";
    private readonly Dictionary<string, string> _colFilters = new();

    private List<ArgusGridColumn<TItem>> _groupableColumns => _columns.Where(c => c.Groupable).ToList();

    // ── Row renderer helper ──────────────────────────────────────────────────────

    private RenderFragment RenderRow(GridRow gridRow) => builder =>
    {
        if (gridRow is GroupHeaderRow ghr)
        {
            builder.OpenElement(0, "tr");
            builder.AddAttribute(1, "class", "group-header");
            builder.OpenElement(2, "td");
            builder.AddAttribute(3, "colspan", _columns.Count.ToString());
            builder.AddContent(4, $"{ghr.Key}  ·  {ghr.Count}");
            builder.CloseElement();
            builder.CloseElement();
        }
        else if (gridRow is DataRow<TItem> dr)
        {
            var item = dr.Item;
            var isSelected = SelectedItem is not null && ReferenceEquals(SelectedItem, item);
            builder.OpenElement(0, "tr");
            builder.AddAttribute(1, "class", isSelected ? "selected" : "");
            builder.AddAttribute(2, "onclick", EventCallback.Factory.Create(this, () => OnRowClick.InvokeAsync(item)));
            int seq = 3;
            foreach (var col in _columns)
            {
                builder.OpenElement(seq++, "td");
                var tdClass = (col.Class ?? "") + (col.Sticky ? " sticky-col" : "");
                builder.AddAttribute(seq++, "class", tdClass.Trim());
                if (col.CellTemplate is not null)
                {
                    builder.AddContent(seq++, col.CellTemplate(item));
                }
                else
                {
                    builder.AddContent(seq++, col.Value(item));
                }
                builder.CloseElement();
            }
            builder.CloseElement();
        }
    };

    // ── Column registration ──────────────────────────────────────────────────────

    internal void RegisterColumn(ArgusGridColumn<TItem> col)
    {
        _columns.Add(col);
        RebuildRows();
        StateHasChanged();
    }

    internal void RemoveColumn(ArgusGridColumn<TItem> col)
    {
        _columns.Remove(col);
        RebuildRows();
    }

    // ── Lifecycle ───────────────────────────────────────────────────────────────

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(SearchQuery))
        {
            _search = SearchQuery;
        }

        if (!string.IsNullOrEmpty(GroupBy) && string.IsNullOrEmpty(_groupByCol))
        {
            _groupByCol = GroupBy;
        }

        RebuildRows();
    }

    public void Dispose() { }

    // ── Row building ─────────────────────────────────────────────────────────────

    private void RebuildRows()
    {
        var q = Items.AsEnumerable();

        // External filter
        if (Filter is not null)
        {
            q = q.Where(Filter);
        }

        // Global search
        var search = _search.Trim();
        if (!string.IsNullOrEmpty(search))
        {
            q = q.Where(item =>
                _columns.Any(col =>
                    col.Searchable &&
                    (col.Value(item)?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)));
        }

        // Per-column filters
        foreach (var (header, filterVal) in _colFilters)
        {
            if (string.IsNullOrEmpty(filterVal)) continue;
            var col = _columns.FirstOrDefault(c => c.Header == header);
            if (col is null) continue;
            q = q.Where(item =>
                col.Value(item)?.Contains(filterVal, StringComparison.OrdinalIgnoreCase) ?? false);
        }

        // Sort
        if (!string.IsNullOrEmpty(_sortHeader))
        {
            var sortCol = _columns.FirstOrDefault(c => c.Header == _sortHeader);
            if (sortCol is not null)
            {
                q = _sortAsc
                    ? q.OrderBy(item => sortCol.Value(item), StringComparer.OrdinalIgnoreCase)
                    : q.OrderByDescending(item => sortCol.Value(item), StringComparer.OrdinalIgnoreCase);
            }
        }

        var filtered = q.ToList();

        // Grouping
        var flat = new List<GridRow>();
        if (!string.IsNullOrEmpty(_groupByCol))
        {
            var groupCol = _columns.FirstOrDefault(c => c.Header == _groupByCol);
            if (groupCol is not null)
            {
                var groups = filtered
                    .GroupBy(item => groupCol.Value(item) ?? "")
                    .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase);

                foreach (var g in groups)
                {
                    flat.Add(new GroupHeaderRow(g.Key, g.Count()));
                    flat.AddRange(g.Select(item => new DataRow<TItem>(item)));
                }
            }
            else
            {
                flat.AddRange(filtered.Select(item => new DataRow<TItem>(item)));
            }
        }
        else
        {
            flat.AddRange(filtered.Select(item => new DataRow<TItem>(item)));
        }

        _flatRows = flat;
    }

    // ── Event handlers ───────────────────────────────────────────────────────────

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        RebuildRows();
    }

    private void ToggleFilters()
    {
        _showFilters = !_showFilters;
    }

    private void OnGroupByChange(ChangeEventArgs e)
    {
        _groupByCol = e.Value?.ToString() ?? "";
        RebuildRows();
    }

    private void SortBy(ArgusGridColumn<TItem> col)
    {
        if (_sortHeader == col.Header)
        {
            if (!_sortAsc)
            {
                // Third click: clear sort
                _sortHeader = null;
            }
            else
            {
                _sortAsc = false;
            }
        }
        else
        {
            _sortHeader = col.Header;
            _sortAsc = true;
        }

        RebuildRows();
    }

    private string GetFilter(string header) =>
        _colFilters.TryGetValue(header, out var v) ? v : "";

    private void SetFilter(string header, string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            _colFilters.Remove(header);
        }
        else
        {
            _colFilters[header] = value;
        }

        RebuildRows();
    }

    // ── Row union ────────────────────────────────────────────────────────────────

    private abstract record GridRow;
    private record DataRow<T>(T Item) : GridRow;
    private record GroupHeaderRow(string Key, int Count) : GridRow;
}
