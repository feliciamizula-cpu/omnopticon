@typeparam TItem
@implements IAsyncDisposable

<div class="ag" style="--ag-cols: @_colsTemplate">

    @* ── Toolbar ── *@
    <div class="ag-bar">
        <input class="ag-search" type="search" placeholder="search…"
               value="@_search" @oninput="OnSearch" />
        @if (_hasFilterable)
        {
            <button class="ag-icon-btn @(_showFilters ? "active" : "")"
                    title="Toggle column filters" @onclick="ToggleFilters">⊟</button>
        }
        @if (_groupable.Count > 1)
        {
            <select class="ag-select" value="@(_groupBy ?? "")" @onchange="OnGroupChange" title="Group by">
                <option value="">group…</option>
                @foreach (var h in _groupable)
                {
                    <option value="@h">@h</option>
                }
            </select>
        }
        @if (ToolbarContent is not null)
        {
            @ToolbarContent
        }
        <span class="ag-count">@_processed.Count<span class="ag-count-sep">/</span>@Items.Count</span>
    </div>

    @* ── Scrollable region: sticky header + virtual rows ── *@
    <div class="ag-scroll">

        @* Sticky header *@
        <div class="ag-head ag-row-grid">
            @foreach (var col in Columns)
            {
                var c = col;
                <div class="ag-th @HeadCls(c)" @onclick="() => ClickSort(c)" title="@c.Header">@c.Header</div>
            }
        </div>

        @* Optional per-column filter row *@
        @if (_showFilters)
        {
            <div class="ag-filter-row ag-row-grid">
                @foreach (var col in Columns)
                {
                    var c = col;
                    <div class="ag-fc">
                        @if (c.Searchable && c.Value is not null)
                        {
                            <input class="ag-fi"
                                   value="@GetFilter(c)"
                                   @oninput="e => SetFilter(c, e.Value?.ToString())"
                                   placeholder="…" />
                        }
                    </div>
                }
            </div>
        }

        @* Virtualized body (no grouping) *@
        @if (_groupBy is null)
        {
            <Virtualize Items="_processed" ItemSize="28" OverscanCount="8" Context="item">
                <div class="ag-row ag-row-grid @(IsSelected(item) ? "ag-sel" : "")"
                     @onclick="() => ClickRow(item)">
                    @foreach (var col in Columns)
                    {
                        var c = col;
                        <div class="ag-td @(c.Primary ? "ag-primary" : "")">
                            @if (c.Cell is not null) { @c.Cell(item) }
                            else { @c.Value?.Invoke(item) }
                        </div>
                    }
                </div>
            </Virtualize>
        }
        else
        {
            @* Grouped body: sorted by group key, visual group-header rows *@
            string? lastGroup = null;
            @foreach (var item in _processed)
            {
                var groupKey = _groupCol?.Value?.Invoke(item) ?? "";
                @if (groupKey != lastGroup)
                {
                    lastGroup = groupKey;
                    var gk = groupKey;
                    var gcount = _processed.Count(r => (_groupCol?.Value?.Invoke(r) ?? "") == gk);
                    <div class="ag-group-row ag-row-grid">
                        <div class="ag-group-cell" style="grid-column: 1 / -1">
                            <span class="ag-group-key">@(string.IsNullOrEmpty(gk) ? "—" : gk)</span>
                            <span class="ag-group-count">@gcount</span>
                        </div>
                    </div>
                }
                var it = item;
                <div class="ag-row ag-row-grid @(IsSelected(it) ? "ag-sel" : "")"
                     @onclick="() => ClickRow(it)">
                    @foreach (var col in Columns)
                    {
                        var c = col;
                        <div class="ag-td @(c.Primary ? "ag-primary" : "")">
                            @if (c.Cell is not null) { @c.Cell(it) }
                            else { @c.Value?.Invoke(it) }
                        </div>
                    }
                </div>
            }
        }

        @if (_processed.Count == 0)
        {
            <div class="ag-empty">@(EmptyMessage ?? "// no results")</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public List<GridColumn<TItem>> Columns { get; set; } = [];

    /// <summary>Highlighted row. Uses ItemKey for comparison when set, otherwise reference equality.</summary>
    [Parameter] public TItem? SelectedItem { get; set; }

    /// <summary>Extracts a stable key for identity comparison across reloads (e.g. a => a.Id).</summary>
    [Parameter] public Func<TItem, object?>? ItemKey { get; set; }

    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }
    [Parameter] public string? EmptyMessage { get; set; }

    /// <summary>Renders inside the toolbar, after the built-in controls.</summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    /// <summary>Seconds between live-refresh ticks. 0 = disabled.</summary>
    [Parameter] public int LiveRefreshSeconds { get; set; }

    /// <summary>Invoked every LiveRefreshSeconds. Parent should reload Items and re-render.</summary>
    [Parameter] public EventCallback OnLiveRefresh { get; set; }

    // ── Column metadata (stable across re-renders until Columns changes) ──
    private string _colsTemplate = "";
    private bool _hasFilterable;
    private List<string> _groupable = [];
    private GridColumn<TItem>? _groupCol;

    // ── Interaction state ──
    private string _search = "";
    private bool _showFilters;
    private string? _sortCol;
    private bool _sortAsc = true;
    private string? _groupBy;
    private readonly Dictionary<string, string> _colFilters = new(StringComparer.Ordinal);

    // ── Cached result (rebuilt only on state changes, not every render) ──
    private List<TItem> _processed = [];

    // ── Live-refresh timer ──
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override void OnParametersSet()
    {
        // Column metadata — cheap to recompute; guards against column list changes
        var newTemplate = string.Join(" ", Columns.Select(c => c.Width ?? "minmax(0, 1fr)"));
        if (newTemplate != _colsTemplate)
        {
            _colsTemplate = newTemplate;
            _hasFilterable = Columns.Any(c => c.Searchable && c.Value is not null);
            _groupable = Columns.Where(c => c.Sortable && c.Value is not null).Select(c => c.Header).ToList();
        }
        _groupCol = _groupBy is not null ? Columns.FirstOrDefault(c => c.Header == _groupBy) : null;

        Recompute();

        // Start timer once (idempotent)
        if (LiveRefreshSeconds > 0 && _timer is null)
        {
            _cts = new CancellationTokenSource();
            _timer = new PeriodicTimer(TimeSpan.FromSeconds(LiveRefreshSeconds));
            _ = RunTimerAsync(_cts.Token);
        }
    }

    // ── Pipeline ─────────────────────────────────────────────────────────────────

    private void Recompute()
    {
        IEnumerable<TItem> rows = Items;

        // 1. Global search
        if (_search.Length > 0)
        {
            var q = _search;
            rows = rows.Where(item => Columns.Any(c =>
                c.Searchable && c.Value?.Invoke(item)
                    ?.Contains(q, StringComparison.OrdinalIgnoreCase) == true));
        }

        // 2. Per-column filters
        foreach (var (header, filter) in _colFilters)
        {
            if (filter.Length == 0) continue;
            var col = Columns.FirstOrDefault(c => c.Header == header);
            if (col?.Value is null) continue;
            var fv = filter;
            rows = rows.Where(item =>
                col.Value(item)?.Contains(fv, StringComparison.OrdinalIgnoreCase) == true);
        }

        // 3. Sort
        if (_sortCol is not null)
        {
            var col = Columns.FirstOrDefault(c => c.Header == _sortCol);
            if (col?.Value is not null)
            {
                rows = _sortAsc
                    ? rows.OrderBy(col.Value, StringComparer.OrdinalIgnoreCase)
                    : rows.OrderByDescending(col.Value, StringComparer.OrdinalIgnoreCase);
            }
        }

        // 4. Group sort (appended; preserves explicit sort within groups)
        if (_groupBy is not null && _groupCol?.Value is { } gv)
        {
            rows = _sortCol is null
                ? rows.OrderBy(gv, StringComparer.OrdinalIgnoreCase)
                : ((IOrderedEnumerable<TItem>)rows).ThenBy(gv, StringComparer.OrdinalIgnoreCase);
        }

        _processed = rows.ToList();
    }

    // ── Timer ─────────────────────────────────────────────────────────────────────

    private async Task RunTimerAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested && _timer is not null)
        {
            try
            {
                if (!await _timer.WaitForNextTickAsync(ct)) break;
                await OnLiveRefresh.InvokeAsync();
            }
            catch (OperationCanceledException) { break; }
            catch { /* swallow transient errors; timer keeps running */ }
        }
    }

    // ── Event handlers ────────────────────────────────────────────────────────────

    private void OnSearch(ChangeEventArgs e) { _search = e.Value?.ToString() ?? ""; Recompute(); }
    private void ToggleFilters() => _showFilters = !_showFilters;

    private void OnGroupChange(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _groupBy = string.IsNullOrEmpty(v) ? null : v;
        _groupCol = _groupBy is not null ? Columns.FirstOrDefault(c => c.Header == _groupBy) : null;
        Recompute();
    }

    private string GetFilter(GridColumn<TItem> col) =>
        _colFilters.TryGetValue(col.Header, out var v) ? v : "";

    private void SetFilter(GridColumn<TItem> col, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) _colFilters.Remove(col.Header);
        else _colFilters[col.Header] = value;
        Recompute();
    }

    private void ClickSort(GridColumn<TItem> col)
    {
        if (!col.Sortable || col.Value is null) return;
        if (_sortCol == col.Header) _sortAsc = !_sortAsc;
        else { _sortCol = col.Header; _sortAsc = true; }
        Recompute();
    }

    private async Task ClickRow(TItem item) => await OnRowClick.InvokeAsync(item);

    private bool IsSelected(TItem item)
    {
        if (SelectedItem is null) return false;
        if (ItemKey is not null) return Equals(ItemKey(item), ItemKey(SelectedItem));
        return EqualityComparer<TItem>.Default.Equals(item, SelectedItem);
    }

    private string HeadCls(GridColumn<TItem> col)
    {
        if (!col.Sortable || col.Value is null) return "";
        if (_sortCol != col.Header) return "ag-sortable";
        return _sortAsc ? "ag-sortable ag-asc" : "ag-sortable ag-desc";
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts is not null) { await _cts.CancelAsync(); _cts.Dispose(); }
        _timer?.Dispose();
        _timer = null;
    }
}
