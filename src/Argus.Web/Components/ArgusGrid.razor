@typeparam TItem
@using Microsoft.JSInterop
@implements IDisposable
@inject IJSRuntime JS

<div id="@_gridId" class="argus-grid-container" style="@(string.IsNullOrEmpty(Height) ? "" : $"height:{Height}")"></div>

@code {
    [Parameter, EditorRequired] public List<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public List<GridColumn<TItem>> Columns { get; set; } = [];
    [Parameter] public object? SelectedItem { get; set; }
    [Parameter] public EventCallback<object> OnRowClicked { get; set; }
    [Parameter] public EventCallback<object> OnRowDoubleClicked { get; set; }
    [Parameter] public EventCallback<AgGridContextMenuEvent> OnCellContextMenu { get; set; }
    [Parameter] public string Height { get; set; } = "100%";

    private string _gridId = $"ag-grid-{Guid.NewGuid():N}";
    private bool _initialized;
    private DotNetObjectReference<ArgusGrid<TItem>>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await InitializeGrid();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && _dotNetRef != null)
        {
            await UpdateData();
        }
    }

    private async Task InitializeGrid()
    {
        var columnDefs = Columns.Select(c => c.ToAgGridColumn().ToDict()).ToList();
        var rowData = Items.Cast<object>().ToList();

        await JS.InvokeVoidAsync("ArgusGrid.create", _gridId, _dotNetRef, new
        {
            rowHeight = 28,
            headerHeight = 32,
            columnDefs,
            rowData
        });

        _initialized = true;
    }

    private async Task UpdateData()
    {
        if (!_initialized) return;

        var rowData = Items.Cast<object>().ToList();
        await JS.InvokeVoidAsync("ArgusGrid.setRowData", _gridId, rowData);
    }

    [JSInvokable]
    public void OnGridRowClicked(object rowData)
    {
        SelectedItem = rowData;
        _ = OnRowClicked.InvokeAsync(rowData);
    }

    [JSInvokable]
    public void OnGridRowDoubleClicked(object rowData)
    {
        _ = OnRowDoubleClicked.InvokeAsync(rowData);
    }

    [JSInvokable]
    public void OnGridCellContextMenu(int mouseX, int mouseY, object rowData)
    {
        _ = OnCellContextMenu.InvokeAsync(new AgGridContextMenuEvent
        {
            Data = rowData,
            MouseX = mouseX,
            MouseY = mouseY
        });
    }

    [JSInvokable]
    public void OnGridSelectionChanged(object? rowData)
    {
        if (rowData != null)
        {
            SelectedItem = rowData;
        }
    }

    public async Task RefreshAsync()
    {
        if (_initialized)
        {
            await JS.InvokeVoidAsync("ArgusGrid.refreshCells", _gridId);
        }
    }

    public async Task SizeColumnsToFitAsync()
    {
        if (_initialized)
        {
            await JS.InvokeVoidAsync("ArgusGrid.sizeColumnsToFit", _gridId);
        }
    }

    public void Dispose()
    {
        if (_initialized)
        {
            _ = JS.InvokeVoidAsync("ArgusGrid.destroy", _gridId);
        }
        _dotNetRef?.Dispose();
    }
}