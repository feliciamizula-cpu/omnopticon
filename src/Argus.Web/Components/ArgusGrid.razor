@typeparam TItem

<div class="argus-grid-wrap" @oncontextmenu:preventDefault="true">
    <MudDataGrid T="TItem"
                 Items="Items"
                 Dense="Dense"
                 Loading="Loading"
                 Filterable="Filterable"
                 Virtualize="Virtualize"
                 Height="@(Virtualize ? Height : null)"
                 SortMode="SortMode.Single"
                 Hover="true"
                 MultiSelection="false"
                 SelectOnRowClick="false"
                 RowClassFunc="ComputeRowClass"
                 RowClick="HandleRowClick"
                 RowContextMenuClick="HandleContextMenuClick"
                 Elevation="0"
                 Style="height:100%;min-height:0">
        <Columns>
            @if (Columns is { Count: > 0 })
            {
                @foreach (var col in Columns)
                {
                    var c = col;
                    <TemplateColumn T="TItem" Title="@c.Header" Sortable="@c.Sortable">
                        <CellTemplate>
                            <span class="@(c.Primary ? "argus-cell-primary" : "")">
                                @c.Value?.Invoke(context.Item)
                            </span>
                        </CellTemplate>
                    </TemplateColumn>
                }
            }
            @ChildContent
        </Columns>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="pa-4">@EmptyMessage</MudText>
        </NoRecordsContent>
    </MudDataGrid>
</div>

@if (ContextMenuItems is not null)
{
    <div style="position:fixed;left:@(_ctxX)px;top:@(_ctxY)px;width:1px;height:1px;pointer-events:none">
        <MudMenu @ref="_contextMenu"
                 AnchorOrigin="Origin.TopLeft"
                 TransformOrigin="Origin.TopLeft"
                 Dense="true">
            <ActivatorContent>
                <span style="display:block;width:1px;height:1px;pointer-events:all" />
            </ActivatorContent>
            <ChildContent>
                @foreach (var item in _ctxItems)
                {
                    @if (item.IsSeparator)
                    {
                        <MudDivider />
                    }
                    else
                    {
                        <MudMenuItem Disabled="@item.IsDisabled"
                                     OnClick="@(async () => await (item.Action?.Invoke() ?? Task.CompletedTask))">@item.Label</MudMenuItem>
                    }
                }
            </ChildContent>
        </MudMenu>
    </div>
}

@code {
    [Parameter, EditorRequired] public IEnumerable<TItem> Items { get; set; } = [];
    [Parameter] public List<GridColumn<TItem>>? Columns { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public TItem? SelectedItem { get; set; }
    [Parameter] public EventCallback<TItem?> SelectedItemChanged { get; set; }
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }
    [Parameter] public Func<TItem, List<ArgusMenuItem>>? ContextMenuItems { get; set; }
    [Parameter] public Func<TItem, int, string>? RowClassFunc { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = "No records";
    [Parameter] public bool Dense { get; set; } = true;
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Filterable { get; set; }
    [Parameter] public bool Virtualize { get; set; }
    [Parameter] public string Height { get; set; } = "100%";

    private MudMenu? _contextMenu;
    private double _ctxX;
    private double _ctxY;
    private List<ArgusMenuItem> _ctxItems = [];

    private string ComputeRowClass(TItem item, int index)
    {
        var custom = RowClassFunc?.Invoke(item, index) ?? "";
        var selected = SelectedItem is not null && EqualityComparer<TItem>.Default.Equals(item, SelectedItem)
            ? "argus-row-selected"
            : "";
        return $"{custom} {selected}".Trim();
    }

    private async Task HandleRowClick(DataGridRowClickEventArgs<TItem> args)
    {
        await SelectedItemChanged.InvokeAsync(args.Item);
        await OnRowClick.InvokeAsync(args.Item);
    }

    private async Task HandleContextMenuClick(DataGridRowClickEventArgs<TItem> args)
    {
        if (ContextMenuItems is null) return;
        _ctxX = args.MouseEventArgs.ClientX;
        _ctxY = args.MouseEventArgs.ClientY;
        _ctxItems = ContextMenuItems(args.Item);
        if (_ctxItems.Count == 0) return;
        StateHasChanged();
        if (_contextMenu is not null)
            await _contextMenu.OpenMenuAsync(EventArgs.Empty, false);
    }
}
