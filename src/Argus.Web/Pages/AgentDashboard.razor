@page "/agent-dashboard"
@page "/development/agent-dashboard"
@implements IAsyncDisposable
@using System.Net.Http.Json
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using Argus.Contracts.Agents
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject DevelopmentRealtimeClient Realtime

<PageTitle>Agent Dashboard</PageTitle>

<style>
    .agent-dashboard-page .ad-shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 380px;
        gap: 1px;
        min-height: 0;
        background: var(--line-1);
    }

    .agent-dashboard-page .ad-main,
    .agent-dashboard-page .ad-side {
        min-height: 0;
        background: var(--bg-0);
    }

    .agent-dashboard-page .ad-main {
        overflow: auto;
    }

    .agent-dashboard-page .ad-side {
        overflow: auto;
        border-left: 1px solid var(--line-1);
    }

    .agent-dashboard-page .ad-section {
        border-bottom: 1px solid var(--line-1);
    }

    .agent-dashboard-page .ad-section-head {
        min-height: 36px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 12px;
        border-bottom: 1px solid var(--line-1);
        background: var(--bg-1);
    }

    .agent-dashboard-page .ad-section-title {
        color: var(--fg-1);
        font-family: var(--font-mono);
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

    .agent-dashboard-page .ad-section-count {
        margin-left: auto;
        color: var(--fg-3);
        font-family: var(--font-mono);
        font-size: 9.5px;
    }

    .agent-dashboard-page .ad-card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1px;
        background: var(--line-1);
    }

    .agent-dashboard-page .ad-agent-card {
        min-height: 156px;
        display: flex;
        flex-direction: column;
        background: var(--bg-0);
        border-top: 2px solid var(--line-2);
    }

    .agent-dashboard-page .ad-agent-card.running {
        border-top-color: var(--cyan);
    }

    .agent-dashboard-page .ad-agent-card.error {
        border-top-color: var(--red);
    }

    .agent-dashboard-page .ad-agent-card.paused {
        opacity: .58;
    }

    .agent-dashboard-page .ad-agent-body {
        flex: 1;
        padding: 10px 12px;
    }

    .agent-dashboard-page .ad-agent-name {
        margin-top: 8px;
        color: var(--fg-0);
        font-size: 15px;
        font-weight: 650;
        line-height: 1.25;
    }

    .agent-dashboard-page .ad-agent-meta,
    .agent-dashboard-page .ad-muted {
        color: var(--fg-3);
        font-family: var(--font-mono);
        font-size: 10.5px;
        line-height: 1.4;
    }

    .agent-dashboard-page .ad-current-task {
        margin-top: 10px;
        padding: 8px;
        border: 1px solid var(--line-1);
        background: var(--bg-1);
        color: var(--fg-2);
        font-family: var(--font-mono);
        font-size: 10.5px;
        line-height: 1.45;
    }

    .agent-dashboard-page .ad-side-block {
        padding: 12px;
        border-bottom: 1px solid var(--line-1);
    }

    .agent-dashboard-page .ad-side-title {
        margin-bottom: 10px;
        color: var(--fg-2);
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

    .agent-dashboard-page .ad-compact-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .agent-dashboard-page .ad-config-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 8px;
        align-items: center;
        padding: 8px;
        border: 1px solid var(--line-1);
        background: var(--bg-1);
    }

    .agent-dashboard-page .ad-config-name {
        color: var(--fg-1);
        font-size: 12px;
        font-weight: 650;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .agent-dashboard-page .ad-mini-actions {
        display: flex;
        gap: 4px;
        justify-content: flex-end;
    }

    .agent-dashboard-page .ad-form-stack {
        display: grid;
        gap: 9px;
    }

    .agent-dashboard-page .ad-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .agent-dashboard-page .ad-attachments {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .agent-dashboard-page .ad-attachment {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        padding: 5px 7px;
        border: 1px solid var(--line-1);
        color: var(--fg-2);
        font-family: var(--font-mono);
        font-size: 10px;
    }

    .agent-dashboard-page .ad-table td:last-child {
        white-space: nowrap;
    }

    @media (max-width: 1180px) {
        .agent-dashboard-page .ad-shell {
            grid-template-columns: 1fr;
        }

        .agent-dashboard-page .ad-side {
            border-left: 0;
        }
    }

    @media (max-width: 720px) {
        .agent-dashboard-page .ad-form-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<PageHeader Title="Agent Dashboard" Subtitle="@($"{RunningAgents.Count:N0} running · {_agents.Count:N0} configurations · {QueueTasks.Count:N0} queued")" />

<div class="deployment-freshness @DeploymentFreshnessClass">
    <span class="freshness-dot"></span>
    <span class="freshness-label">@DeploymentFreshnessText</span>
</div>

<div class="page-body dev-page agent-dashboard-page">
    <div class="dev-main">
        <div class="page-tabs">
            <a class="page-tab active" href="/agent-dashboard">Dashboard</a>
            <a class="page-tab" href="/agents">Agent Config <span class="tab-count">@_agents.Count</span></a>
            <a class="page-tab" href="/agent-tasks">Agent Tasks <span class="tab-count">@_tasks.Count</span></a>
            <a class="page-tab" href="/provider-usage">Provider Usage</a>
            <div class="page-tab-spacer"></div>
            <div class="page-tab-actions">
                <button class="btn primary tiny" @onclick="ResetComposer">+ Ad-Hoc Task</button>
                <button class="btn ghost tiny" @onclick="() => LoadData()">Refresh</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="dev-alert">@_error</div>
        }
        @if (!string.IsNullOrWhiteSpace(_notice))
        {
            <div class="dev-alert" style="background: var(--green-bg); color: var(--green);">@_notice</div>
        }

        <div class="dev-stats-strip">
            <DevStat Label="Running Agents" Value="@RunningAgents.Count.ToString()" Tone="cyan" Sub="working or assigned now" />
            <DevStat Label="Idle Agents" Value="@_agents.Count(a => IsActive(a) && !IsRunning(a)).ToString()" Tone="green" Sub="enabled and available" />
            <DevStat Label="Paused" Value="@_agents.Count(a => !IsActive(a)).ToString()" Sub="disabled configurations" />
            <DevStat Label="Queued Tasks" Value="@QueueTasks.Count.ToString()" Sub="pending, claimed, blocked" />
            <DevStat Label="Scheduled" Value="@ScheduledTasks.Count.ToString()" Tone="amber" Sub="tasks with cron mirrors" />
            <DevStat Label="Failed" Value="@_tasks.Count(t => StatusKey(t.Status) == "failed").ToString()" Tone="red" Sub="needs attention" />
        </div>

        @if (_loading)
        {
            <div class="dev-empty">
                <div>
                    <div class="app-loading-spinner" style="margin: 0 auto 12px;"></div>
                    <div>// loading agent dashboard</div>
                </div>
            </div>
        }
        else
        {
            <div class="ad-shell">
                <div class="ad-main">
                    <section class="ad-section">
                        <div class="ad-section-head">
                            <span class="ad-section-title">Currently Running</span>
                            <span class="ad-section-count">@RunningAgents.Count agent@(RunningAgents.Count == 1 ? "" : "s")</span>
                        </div>

                        @if (RunningAgents.Count == 0)
                        {
                            <div class="dev-empty" style="padding: 28px 16px;">// no agents are currently running</div>
                        }
                        else
                        {
                            <div class="ad-card-grid">
                                @foreach (var agent in RunningAgents)
                                {
                                    <div class="ad-agent-card @AgentCardClass(agent)">
                                        <div class="ad-agent-body">
                                            <div class="type-row">
                                                <span class="dot @AgentDot(agent)"></span>
                                                <span class="dev-pill @RoleTone(agent.Role)">@RoleLabel(agent.Role)</span>
                                                <span class="dev-pill @AgentPriorityTone(agent.Priority)">@AgentPriorityLabel(agent.Priority)</span>
                                                <span class="asset-id">@ShortId(agent.AgentId)</span>
                                            </div>
                                            <div class="ad-agent-name">@agent.Name</div>
                                            <div class="ad-agent-meta">
                                                <span class="tone-@ToolTone(agent.Tool)">@ToolLabel(agent.Tool)</span>
                                                <span> / @ProviderLabel(agent)</span>
                                                <span> / @agent.Model</span>
                                            </div>
                                            <div class="ad-current-task">
                                                <div>task: @(string.IsNullOrWhiteSpace(agent.CurrentTaskId) ? "unknown" : agent.CurrentTaskId)</div>
                                                <div>status: @(string.IsNullOrWhiteSpace(agent.WorkStatus) ? "working" : agent.WorkStatus)</div>
                                                <div>heartbeat: @Relative(agent.LastHeartbeatAt)</div>
                                            </div>
                                        </div>
                                        <div class="dev-action-row">
                                            <button class="btn ghost tiny" @onclick="() => StartAgent(agent)">Start</button>
                                            <button class="btn danger tiny" @onclick="() => StopAgent(agent)">Stop</button>
                                            <button class="btn ghost tiny" @onclick="() => PauseAgent(agent.AgentId)">Pause</button>
                                            <button class="btn ghost tiny" @onclick="() => OpenEditAgent(agent)">Modify</button>
                                            <button class="btn danger tiny" @onclick="() => DeleteAgent(agent)">Delete</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    <section class="ad-section">
                        <div class="ad-section-head">
                            <span class="ad-section-title">Agent Work Queue</span>
                            <span class="ad-section-count">@QueueRows.Count visible</span>
                        </div>
                        <div class="ac-table-wrap">
                            <table class="ac-table ad-table">
                                <thead>
                                    <tr>
                                        <th style="width: 26px;"></th>
                                        <th style="width: 105px;">Task</th>
                                        <th>Description</th>
                                        <th style="width: 95px;">Priority</th>
                                        <th style="width: 100px;">Status</th>
                                        <th style="width: 170px;">Agent</th>
                                        <th style="width: 94px;">Next</th>
                                        <th style="width: 210px;">Controls</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var task in QueueRows)
                                    {
                                        <tr class="@(_selectedTaskId == task.TaskId ? "selected" : "")">
                                            <td><span class="dot @TaskDot(task.Status)"></span></td>
                                            <td class="mono tone-cyan">@task.TaskId</td>
                                            <td class="primary-cell">@task.Description</td>
                                            <td><span class="dev-pill @PriorityTone(task.Priority)">@PriorityLabel(task.Priority)</span></td>
                                            <td><span class="dev-pill @TaskStatusTone(task.Status)">@TaskStatusLabel(task.Status)</span></td>
                                            <td>@AgentChip(task.AssignedTo)</td>
                                            <td class="tabular">@Relative(task.NextRunAt)</td>
                                            <td>
                                                <button class="btn primary tiny" @onclick="() => RunTask(task)">Start</button>
                                                <button class="btn ghost tiny" @onclick="() => SelectTask(task)">Schedule</button>
                                                <button class="btn ghost tiny" @onclick='() => QuickStatus(task, "blocked")'>Pause</button>
                                                <button class="btn danger tiny" @onclick="() => DeleteTask(task)">Delete</button>
                                            </td>
                                        </tr>
                                    }
                                    @if (QueueRows.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="8" style="padding: 28px; text-align: center; color: var(--fg-3);">// no queued agent tasks</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <section class="ad-section">
                        <div class="ad-section-head">
                            <span class="ad-section-title">Schedule</span>
                            <span class="ad-section-count">@ScheduledTasks.Count scheduled task@(ScheduledTasks.Count == 1 ? "" : "s")</span>
                        </div>
                        <div class="ac-table-wrap">
                            <table class="ac-table ad-table">
                                <thead>
                                    <tr>
                                        <th style="width: 105px;">Task</th>
                                        <th>Description</th>
                                        <th style="width: 130px;">Cron</th>
                                        <th style="width: 115px;">Next Run</th>
                                        <th style="width: 160px;">Assigned</th>
                                        <th style="width: 92px;">Controls</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var task in ScheduledTasks)
                                    {
                                        <tr class="@(_selectedTaskId == task.TaskId ? "selected" : "")">
                                            <td class="mono tone-cyan">@task.TaskId</td>
                                            <td class="primary-cell">@task.Description</td>
                                            <td class="mono">@task.ScheduleExpression</td>
                                            <td class="tabular">@Relative(task.NextRunAt)</td>
                                            <td>@AgentChip(task.AssignedTo)</td>
                                            <td>
                                                <button class="btn ghost tiny" @onclick="() => SelectTask(task)">Edit</button>
                                            </td>
                                        </tr>
                                    }
                                    @if (ScheduledTasks.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="6" style="padding: 28px; text-align: center; color: var(--fg-3);">// no scheduled agent tasks</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                </div>

                <aside class="ad-side">
                    <div class="ad-side-block">
                        <div class="ad-side-title">Ad-Hoc Task</div>
                        <div class="ad-form-stack">
                            <div class="dev-form-field">
                                <label>Worker type</label>
                                <select class="dev-input" @bind="_newTask.TargetRole">
                                    @foreach (var role in WorkerTypeOptions)
                                    {
                                        <option value="@role.Value">@role.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="dev-form-field">
                                <label>Assign agent</label>
                                <select class="dev-input" @bind="_newTask.AssignedTo">
                                    <option value="">auto-route</option>
                                    @foreach (var agent in _agents.OrderBy(a => a.Name))
                                    {
                                        <option value="@agent.AgentId">@agent.Name - @ToolLabel(agent.Tool) / @RoleLabel(agent.Role)</option>
                                    }
                                </select>
                            </div>
                            <div class="ad-form-row">
                                <div class="dev-form-field">
                                    <label>Priority</label>
                                    <select class="dev-input" @bind="_newTask.Priority">
                                        <option value="critical">critical</option>
                                        <option value="high">high</option>
                                        <option value="normal">normal</option>
                                        <option value="low">low</option>
                                    </select>
                                </div>
                                <div class="dev-form-field">
                                    <label>Runtime</label>
                                    <select class="dev-input" @bind="_newTask.Runtime">
                                        <option value="default">default</option>
                                        <option value="in_pod">in_pod</option>
                                        <option value="workspace">workspace</option>
                                    </select>
                                </div>
                            </div>
                            <div class="dev-form-field">
                                <label>Task description</label>
                                <input class="dev-input" @bind="_newTask.Description" @bind:event="oninput" placeholder="Investigate the failing worker run." />
                            </div>
                            <div class="dev-form-field">
                                <label>Instructions</label>
                                <textarea class="dev-input" rows="5" @bind="_newTask.Instructions" @bind:event="oninput" placeholder="What should the agent do?"></textarea>
                            </div>
                            <div class="ad-form-row">
                                <div class="dev-form-field">
                                    <label>Schedule cron</label>
                                    <input class="dev-input" @bind="_newTask.ScheduleExpression" @bind:event="oninput" placeholder="optional" />
                                </div>
                                <div class="dev-form-field">
                                    <label>Task type</label>
                                    <input class="dev-input" @bind="_newTask.TaskType" @bind:event="oninput" placeholder="adhoc" />
                                </div>
                            </div>
                            <div class="dev-form-field">
                                <label>Attached files</label>
                                <InputFile OnChange="OnFilesSelected" multiple class="dev-input" />
                                @if (_attachments.Count > 0)
                                {
                                    <div class="ad-attachments" style="margin-top: 6px;">
                                        @foreach (var file in _attachments)
                                        {
                                            <div class="ad-attachment">
                                                <span>@file.Name</span>
                                                <span>@FormatBytes(file.Size)</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <label class="ac-cap-row">
                                <input type="checkbox" @bind="_newTask.StartImmediately" />
                                <span class="ac-cap-name">Start immediately</span>
                            </label>
                            <div class="dev-action-row" style="padding: 0;">
                                <button class="btn primary tiny" @onclick="CreateTask" disabled="@(!CanCreateTask)">Create Task</button>
                                <button class="btn ghost tiny" @onclick="ResetComposer">Reset</button>
                            </div>
                        </div>
                    </div>

                    <div class="ad-side-block">
                        <div class="ad-side-title">Compact Configuration</div>
                        <div class="dev-action-row" style="padding: 0 0 8px;">
                            <button class="btn primary tiny" @onclick="OpenCreateAgent">+ New Config</button>
                        </div>
                        <div class="ad-compact-list">
                            @foreach (var agent in _agents.OrderByDescending(IsActive).ThenByDescending(IsRunning).ThenBy(a => a.Name))
                            {
                                <div class="ad-config-row">
                                    <div>
                                        <div class="ad-config-name">
                                            <span class="dot @AgentDot(agent)" style="margin-right: 5px;"></span>@agent.Name
                                        </div>
                                        <div class="ad-agent-meta">
                                            @RoleLabel(agent.Role) / <span class="tone-@ToolTone(agent.Tool)">@ToolLabel(agent.Tool)</span> / @agent.Model
                                        </div>
                                    </div>
                                    <div class="ad-mini-actions">
                                        @if (IsActive(agent))
                                        {
                                            <button class="btn ghost tiny" @onclick="() => PauseAgent(agent.AgentId)">Pause</button>
                                        }
                                        else
                                        {
                                            <button class="btn ghost tiny" @onclick="() => ResumeAgent(agent.AgentId)">Start</button>
                                        }
                                        <button class="btn ghost tiny" @onclick="() => OpenEditAgent(agent)">Edit</button>
                                        <button class="btn danger tiny" @onclick="() => DeleteAgent(agent)">x</button>
                                    </div>
                                </div>
                            }
                            @if (_agents.Count == 0)
                            {
                                <div class="dev-empty">// no agent configurations</div>
                            }
                        </div>
                    </div>

                    <div class="ad-side-block">
                        <div class="ad-side-title">Selected Task Schedule</div>
                        @if (SelectedTask is null)
                        {
                            <div class="dev-empty">// select a scheduled or queued task</div>
                        }
                        else
                        {
                            <div class="ad-muted" style="margin-bottom: 8px;">
                                <span class="mono tone-cyan">@SelectedTask.TaskId</span><br />
                                @SelectedTask.Description
                            </div>

                            @if (_schedules.Count == 0)
                            {
                                <div class="dev-empty" style="padding: 12px;">// on-demand only</div>
                            }
                            else
                            {
                                <table class="kv-table">
                                    <thead>
                                        <tr><th>Cron</th><th>Next</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var schedule in _schedules)
                                        {
                                            <tr>
                                                <td class="mono">@schedule.Cron</td>
                                                <td class="tabular">@Relative(schedule.NextRunAt)</td>
                                                <td>
                                                    <input type="checkbox" checked="@schedule.Enabled"
                                                           @onchange="async e => await ToggleSchedule(schedule.ScheduleId, (bool)e.Value!)" />
                                                    <button class="btn danger tiny" @onclick="async () => await DeleteSchedule(schedule.ScheduleId)">x</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            <div class="ad-form-stack" style="margin-top: 8px;">
                                <div class="dev-form-field">
                                    <label>New cron</label>
                                    <input class="dev-input" @bind="_newScheduleCron" @bind:event="oninput" placeholder="*/15 * * * *" />
                                </div>
                                <div class="dev-form-field">
                                    <label>Label</label>
                                    <input class="dev-input" @bind="_newScheduleLabel" @bind:event="oninput" placeholder="optional" />
                                </div>
                                <div class="dev-action-row" style="padding: 0;">
                                    <button class="btn primary tiny" @onclick="AddSchedule" disabled="@string.IsNullOrWhiteSpace(_newScheduleCron)">Add Schedule</button>
                                </div>
                            </div>
                        }
                    </div>
                </aside>
            </div>
        }
    </div>
</div>

@if (_showAgentModal)
{
    <div class="dev-page">
        <div class="dev-modal-overlay" @onclick="CloseAgentModal">
            <div class="dev-modal" @onclick:stopPropagation="true">
                <div class="dev-modal-head">
                    <span class="dot amber"></span>
                    @(_editingAgentId is null ? "New Agent Configuration" : "Edit Agent Configuration")
                    <button class="dev-icon-btn" @onclick="CloseAgentModal">x</button>
                </div>
                <div class="dev-modal-body">
                    <div class="dev-form-grid">
                        <div class="dev-form-field">
                            <label>Name</label>
                            <input class="dev-input" @bind="_agentForm.Name" @bind:event="oninput" />
                        </div>
                        <div class="dev-form-field">
                            <label>Role</label>
                            <select class="dev-input" @bind="_agentForm.Role">
                                @foreach (var role in WorkerTypeOptions)
                                {
                                    <option value="@role.Value">@role.Label</option>
                                }
                            </select>
                        </div>
                        <div class="dev-form-field">
                            <label>CLI</label>
                            <select class="dev-input" @bind="_agentForm.Tool">
                                <option value="claude">Claude</option>
                                <option value="codex">Codex</option>
                                <option value="gemini">Gemini</option>
                                <option value="openai">OpenAI</option>
                                <option value="opencode">Opencode</option>
                            </select>
                        </div>
                        <div class="dev-form-field">
                            <label>Provider</label>
                            <input class="dev-input" @bind="_agentForm.Provider" @bind:event="oninput" placeholder="auto-detect" />
                        </div>
                        <div class="dev-form-field">
                            <label>Model</label>
                            <input class="dev-input" @bind="_agentForm.Model" @bind:event="oninput" />
                        </div>
                        <div class="dev-form-field">
                            <label>Priority</label>
                            <select class="dev-input" @bind="_agentForm.Priority">
                                <option value="low">Low</option>
                                <option value="standard">Standard</option>
                                <option value="critical">Critical</option>
                            </select>
                        </div>
                        <div class="dev-form-field">
                            <label>Runtime</label>
                            <select class="dev-input" @bind="_agentForm.DefaultRuntime">
                                <option value="">resolved default</option>
                                <option value="in_pod">in_pod</option>
                                <option value="workspace">workspace</option>
                            </select>
                        </div>
                        <div class="dev-form-field">
                            <label>Sort order</label>
                            <input class="dev-input" type="number" @bind="_agentForm.SortOrder" />
                        </div>
                        <div class="dev-form-field full">
                            <label>Responsibilities</label>
                            <textarea class="dev-input" rows="4" @bind="_agentForm.ResponsibilitiesText" @bind:event="oninput"></textarea>
                        </div>
                    </div>
                </div>
                <div class="dev-modal-foot">
                    <button class="btn ghost" @onclick="CloseAgentModal">Cancel</button>
                    <button class="btn primary" @onclick="SaveAgent" disabled="@(!CanSaveAgent)">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly JsonSerializerOptions _jsonOptions = new(JsonSerializerDefaults.Web)
    {
