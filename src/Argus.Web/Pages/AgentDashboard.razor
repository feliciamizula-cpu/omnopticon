    private void CloseAgentModal()
    {
        _showAgentModal = false;
        _editingAgentId = null;
    }

    private async Task SaveAgent()
    {
        if (!CanSaveAgent)
        {
            return;
        }

        _error = null;
        _notice = null;

        try
        {
            var responsibilities = SplitResponsibilities(_agentForm.ResponsibilitiesText);
            var provider = string.IsNullOrWhiteSpace(_agentForm.Provider) ? null : _agentForm.Provider.Trim();
            var runtime = string.IsNullOrWhiteSpace(_agentForm.DefaultRuntime) ? null : _agentForm.DefaultRuntime;
            HttpResponseMessage response;

            if (_editingAgentId is Guid id)
            {
                response = await Http.PutAsJsonAsync(
                    Ui($"/ui/agents/{id}"),
                    new UpdateAgentRequest(
                        Name: _agentForm.Name.Trim(),
                        Role: _agentForm.Role.Trim(),
                        SortOrder: _agentForm.SortOrder,
                        Responsibilities: responsibilities,
                        Tool: _agentForm.Tool.Trim(),
                        Model: _agentForm.Model.Trim(),
                        Provider: provider,
                        ClearProvider: provider is null,
                        Priority: _agentForm.Priority,
                        DefaultRuntime: runtime));
            }
            else
            {
                response = await Http.PostAsJsonAsync(
                    Ui("/ui/agents"),
                    new CreateAgentRequest(
                        _agentForm.Name.Trim(),
                        _agentForm.Role.Trim(),
                        responsibilities,
                        _agentForm.Tool.Trim(),
                        _agentForm.Model.Trim(),
                        SortOrder: _agentForm.SortOrder,
                        Provider: provider,
                        Priority: _agentForm.Priority,
                        DefaultRuntime: runtime));
            }

            if (!response.IsSuccessStatusCode)
            {
                _error = $"Save failed with status {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
                return;
            }

            var wasEdit = _editingAgentId is not null;
            CloseAgentModal();
            _notice = wasEdit ? "Agent configuration updated." : "Agent configuration saved.";
            await LoadData(showLoading: false);
        }
        catch (Exception ex)
        {
            _error = $"Unable to save agent: {ex.Message}";
        }
    }

    private static string[] SplitResponsibilities(string value) =>
        value.Split([',', '\n', ';'], StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private MarkupString AgentChip(string? id)
    {
        if (string.IsNullOrWhiteSpace(id))
        {
            return new MarkupString("""<span class="mono" style="color: var(--fg-3);">auto</span>""");
        }

        var agent = _agents.FirstOrDefault(a => string.Equals(a.AgentId.ToString(), id, StringComparison.OrdinalIgnoreCase)
                                                || string.Equals(a.Name, id, StringComparison.OrdinalIgnoreCase));
        if (agent is null)
        {
            return new MarkupString($"""<span class="mono" style="font-size: 10.5px;">{Escape(id)}</span>""");
        }

        return new MarkupString($"""
<span class="agent-chip">
  <span class="dot {AgentDot(agent)}"></span>
  <span class="name">{Escape(agent.Name)}</span>
  <span class="meta">{Escape(ToolLabel(agent.Tool))}</span>
</span>
""");
    }

    private static bool IsQueueTask(AgentTaskDto task) =>
        StatusKey(task.Status) is "pending" or "claimed" or "in_progress" or "blocked";

    private static bool AssignedToAgent(AgentTaskDto task, AgentDto agent) =>
        string.Equals(task.AssignedTo, agent.AgentId.ToString(), StringComparison.OrdinalIgnoreCase)
        || string.Equals(task.AssignedTo, agent.Name, StringComparison.OrdinalIgnoreCase);

    private static bool IsRunning(AgentDto agent) =>
        agent.WorkStatus.Equals("working", StringComparison.OrdinalIgnoreCase)
        || agent.WorkStatus.Equals("running", StringComparison.OrdinalIgnoreCase)
        || !string.IsNullOrWhiteSpace(agent.CurrentTaskId);

    private static bool IsActive(AgentDto agent) =>
        agent.Status.Equals("active", StringComparison.OrdinalIgnoreCase)
        || agent.Status.Equals("enabled", StringComparison.OrdinalIgnoreCase)
        || string.IsNullOrWhiteSpace(agent.Status);

    private static string AgentCardClass(AgentDto agent)
    {
        if (!IsActive(agent)) return "paused";
        if (!string.IsNullOrWhiteSpace(agent.LastError)) return "error";
        return IsRunning(agent) ? "running" : "";
    }

    private static string AgentDot(AgentDto agent)
    {
        if (!IsActive(agent)) return "";
        if (!string.IsNullOrWhiteSpace(agent.LastError)) return "red";
        if (IsRunning(agent)) return "cyan pulse";
        return "green";
    }

    private static string StatusKey(string status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "pending";
        var key = status.Trim().ToLowerInvariant();
        return key switch
        {
            "active" or "running" => "in_progress",
            "succeeded" or "success" or "done" => "completed",
            "queued" => "pending",
            _ => key
        };
    }

    private static string PriorityKey(string priority)
    {
        if (string.IsNullOrWhiteSpace(priority)) return "normal";
        var key = priority.Trim().ToLowerInvariant();
        return key == "medium" ? "normal" : key;
    }

    private static int PriorityRank(AgentTaskDto task) => PriorityRank(task.Priority);

    private static int PriorityRank(string priority) => PriorityKey(priority) switch
    {
        "critical" => 0,
        "high" => 1,
        "normal" => 2,
        "low" => 3,
        _ => 4
    };

    private static string PriorityLabel(string priority) => PriorityKey(priority);

    private static string PriorityTone(string priority) => PriorityKey(priority) switch
    {
        "critical" => "red",
        "high" => "amber",
        "normal" => "cyan",
        _ => "dim"
    };

    private static string TaskStatusTone(string status) => StatusKey(status) switch
    {
        "completed" => "green",
        "failed" => "red",
        "blocked" => "amber",
        "claimed" or "in_progress" => "cyan",
        _ => "dim"
    };

    private static string TaskDot(string status) => StatusKey(status) switch
    {
        "completed" => "green",
        "failed" => "red",
        "blocked" => "amber",
        "claimed" or "in_progress" => "cyan",
        _ => ""
    };

    private static string TaskStatusLabel(string status) => StatusKey(status).Replace("_", " ");

    private static string NormalizeRole(string role) =>
        string.IsNullOrWhiteSpace(role) ? "developer" : role.Trim().ToLowerInvariant();

    private static string RoleLabel(string role) => NormalizeRole(role) switch
    {
        "junior_developer" => "Junior Developer",
        "developer" => "Developer",
        "senior_developer" => "Senior Developer",
        "junior_system_architect" => "Jr. System Architect",
        "senior_system_architect" => "Sr. System Architect",
        "junior_devops" => "Junior DevOps",
        "senior_devops" => "Senior DevOps",
        "devops_architect" => "DevOps Architect",
        _ => role
    };

    private static string RoleTone(string role) => NormalizeRole(role) switch
    {
        "junior_developer" or "developer" => "amber",
        "senior_developer" => "magenta",
        "junior_system_architect" => "cyan",
        "senior_system_architect" => "red",
        "junior_devops" or "senior_devops" => "green",
        "devops_architect" => "violet",
        _ => "dim"
    };

    private static string NormalizeTool(string tool) =>
        string.IsNullOrWhiteSpace(tool) ? "cli" : tool.Trim().ToLowerInvariant();

    private static string ToolLabel(string tool) => NormalizeTool(tool) switch
    {
        "claude" => "Claude",
        "codex" => "Codex",
        "gemini" => "Gemini",
        "openai" => "OpenAI",
        "opencode" => "Opencode",
        _ => string.IsNullOrWhiteSpace(tool) ? "CLI" : tool
    };

    private static string ToolTone(string tool) => NormalizeTool(tool) switch
    {
        "claude" => "violet",
        "codex" => "green",
        "gemini" => "cyan",
        "openai" => "green",
        "opencode" => "cyan",
        _ => "amber"
    };

    private static string ProviderLabel(AgentDto agent)
    {
        if (!string.IsNullOrWhiteSpace(agent.Provider)) return agent.Provider.Trim();
        return NormalizeTool(agent.Tool) switch
        {
            "claude" => "Claude",
            "gemini" => "Gemini",
            "codex" or "openai" => "OpenAI",
            "opencode" => DeriveOpenCodeProvider(agent.Model),
            _ => "Unknown"
        };
    }

    private static string DeriveOpenCodeProvider(string model)
    {
        var m = (model ?? string.Empty).ToLowerInvariant();
        if (m.StartsWith("nvidia/") || m.Contains("nvidia")) return "NVIDIA";
        if (m.StartsWith("openai/") || m.StartsWith("gpt-") || m.Contains("/gpt-")) return "OpenAI";
        if (m.StartsWith("anthropic/") || m.StartsWith("claude-") || m.Contains("/claude-")) return "Claude";
        if (m.StartsWith("google/") || m.StartsWith("gemini-") || m.Contains("/gemini-")) return "Gemini";
        return "OpenRouter";
    }

    private static string AgentPriorityLabel(string priority)
    {
        if (string.IsNullOrWhiteSpace(priority)) return "standard";
        return priority.ToLowerInvariant() switch
        {
            "critical" => "critical",
            "low" => "low",
            _ => "standard"
        };
    }

    private static string AgentPriorityTone(string priority) => AgentPriorityLabel(priority) switch
    {
        "critical" => "red",
        "low" => "dim",
        _ => "cyan"
    };

    private static string ShortId(Guid id) => id.ToString("N")[..8];

    private static string Relative(DateTimeOffset? value) => value is null ? "never" : Relative(value.Value);

    private static string Relative(DateTimeOffset value)
    {
        var span = DateTimeOffset.UtcNow - value.ToUniversalTime();
        var suffix = span < TimeSpan.Zero ? "from now" : "ago";
        span = span.Duration();
        if (span.TotalSeconds < 60) return $"{Math.Max(1, (int)span.TotalSeconds)}s {suffix}";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m {suffix}";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h {suffix}";
        return $"{(int)span.TotalDays}d {suffix}";
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024d:F1} KB";
        return $"{bytes / 1024d / 1024d:F1} MB";
    }

    private static string Escape(string value) =>
        value.Replace("&", "&amp;", StringComparison.Ordinal)
            .Replace("<", "&lt;", StringComparison.Ordinal)
            .Replace(">", "&gt;", StringComparison.Ordinal)
            .Replace("\"", "&quot;", StringComparison.Ordinal);

