    private IReadOnlyList<AgentTaskDto> QueueTasks =>
        _tasks.Where(IsQueueTask)
            .OrderBy(PriorityRank)
            .ThenByDescending(t => t.CreatedAt)
            .ToList();

    private IReadOnlyList<AgentTaskDto> QueueRows => QueueTasks.Take(12).ToList();

    private IReadOnlyList<AgentTaskDto> ScheduledTasks =>
        _tasks.Where(t => !string.IsNullOrWhiteSpace(t.ScheduleExpression) || t.NextRunAt is not null)
            .OrderBy(t => t.NextRunAt ?? DateTimeOffset.MaxValue)
            .ThenBy(t => t.Description)
            .ToList();

    private AgentTaskDto? SelectedTask =>
        _tasks.FirstOrDefault(t => t.TaskId == _selectedTaskId);

    private bool CanCreateTask => !string.IsNullOrWhiteSpace(_newTask.Description);

    private bool CanSaveAgent =>
        !string.IsNullOrWhiteSpace(_agentForm.Name)
        && !string.IsNullOrWhiteSpace(_agentForm.Role)
        && !string.IsNullOrWhiteSpace(_agentForm.Tool)
        && !string.IsNullOrWhiteSpace(_agentForm.Model);

    private string DeploymentFreshnessText
    {
        get
        {
            var age = DateTimeOffset.UtcNow - AppStartedAt;
            if (age.TotalMinutes <= 5) return "Fresh Deployment";
            if (age.TotalMinutes <= 60) return "Deployment Ok";
            return "Deployment Stale";
        }
    }

    private string DeploymentFreshnessClass
    {
        get
        {
            var age = DateTimeOffset.UtcNow - AppStartedAt;
            if (age.TotalMinutes <= 5) return "fresh";
            if (age.TotalMinutes <= 60) return "ok";
            return "stale";
        }
    }

    private static readonly (string Value, string Label)[] WorkerTypeOptions =
    [
        ("developer", "Developer"),
        ("junior_developer", "Junior Developer"),
        ("senior_developer", "Senior Developer"),
        ("junior_system_architect", "Jr. System Architect"),
        ("senior_system_architect", "Sr. System Architect"),
        ("junior_devops", "Junior DevOps"),
        ("senior_devops", "Senior DevOps"),
        ("devops_architect", "DevOps Architect")
    ];

    protected override async Task OnInitializedAsync()
    {
        Realtime.Changed += OnDevelopmentDataChanged;
        await Realtime.StartAsync();
        await LoadData();
    }

    private async Task LoadData(bool showLoading = true)
    {
        _loading = showLoading && _agents.Count == 0 && _tasks.Count == 0;
        _error = null;

        try
        {
            await Task.WhenAll(LoadAgentsAsync(), LoadTasksAsync());
        }
        catch (Exception ex)
        {
            _error = $"Unable to load agent dashboard: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAgentsAsync()
    {
        var response = await Http.GetAsync(Ui("/ui/agents"));
        _agents = await ReadItemsAsync<AgentDto>(response);
    }

    private async Task LoadTasksAsync()
    {
        var response = await Http.GetAsync(Ui("/ui/agent-tasks"));
        _tasks = await ReadItemsAsync<AgentTaskDto>(response);
        if (_selectedTaskId is not null && _tasks.All(t => t.TaskId != _selectedTaskId))
        {
            _selectedTaskId = null;
            _schedules = new();
        }
    }

    private Task OnDevelopmentDataChanged(DevelopmentDataChangedEvent change)
    {
        if (change.Area is "agents" or "agent-tasks" or "todos")
        {
            return InvokeAsync(() => LoadData(showLoading: false));
        }

        return Task.CompletedTask;
    }

    public ValueTask DisposeAsync()
    {
        Realtime.Changed -= OnDevelopmentDataChanged;
        return ValueTask.CompletedTask;
    }

    private string Ui(string path) => Nav.ToAbsoluteUri(path).ToString();

    private async Task<List<T>> ReadItemsAsync<T>(HttpResponseMessage response)
    {
        if (!response.IsSuccessStatusCode)
        {
            _error = $"Backend returned {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
            return new List<T>();
        }

        await using var stream = await response.Content.ReadAsStreamAsync();
        using var document = await JsonDocument.ParseAsync(stream);

        if (document.RootElement.ValueKind == JsonValueKind.Array)
        {
            return JsonSerializer.Deserialize<List<T>>(document.RootElement.GetRawText(), _jsonOptions) ?? new List<T>();
        }

        if (document.RootElement.ValueKind == JsonValueKind.Object
            && document.RootElement.TryGetProperty("items", out var items)
            && items.ValueKind == JsonValueKind.Array)
        {
            return JsonSerializer.Deserialize<List<T>>(items.GetRawText(), _jsonOptions) ?? new List<T>();
        }

        return new List<T>();
    }

    private async Task<T?> ReadSingleAsync<T>(HttpResponseMessage response)
    {
        if (!response.IsSuccessStatusCode)
        {
            _error = $"Backend returned {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
            return default;
        }

        return await response.Content.ReadFromJsonAsync<T>(_jsonOptions);
    }

    private void ResetComposer()
    {
        _newTask = TaskComposer.Default();
        _attachments = new();
        _notice = "Ad-hoc task composer is ready.";
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        _attachments = e.GetMultipleFiles(12)
            .Select(f => new AttachmentReference(f.Name, f.Size, f.ContentType, f.LastModified))
            .ToList();
    }

    private async Task CreateTask()
    {
        if (!CanCreateTask)
        {
            return;
        }

        _error = null;
        _notice = null;

        try
        {
            var request = new CreateAgentTaskRequest(
                _newTask.Description.Trim(),
                _newTask.Priority,
                Instructions: BuildTaskInstructions(),
                AssignedTo: string.IsNullOrWhiteSpace(_newTask.AssignedTo) ? null : _newTask.AssignedTo,
                TargetRole: string.IsNullOrWhiteSpace(_newTask.TargetRole) ? "developer" : _newTask.TargetRole,
                TaskType: string.IsNullOrWhiteSpace(_newTask.TaskType) ? "adhoc" : _newTask.TaskType.Trim(),
                Runtime: string.IsNullOrWhiteSpace(_newTask.Runtime) ? "default" : _newTask.Runtime,
                RequiredCapabilities: null,
                ScheduleExpression: string.IsNullOrWhiteSpace(_newTask.ScheduleExpression) ? null : _newTask.ScheduleExpression.Trim());

            var response = await Http.PostAsJsonAsync(Ui("/ui/agent-tasks"), request);
            var created = await ReadSingleAsync<AgentTaskDto>(response);
            if (created is null)
            {
                return;
            }

            _selectedTaskId = created.TaskId;
            if (_newTask.StartImmediately)
            {
                await RunTask(created, showNotice: false);
            }

            _notice = _newTask.StartImmediately ? "Task created and started." : "Task created.";
            _newTask = TaskComposer.Default();
            _attachments = new();
            await LoadData(showLoading: false);
        }
        catch (Exception ex)
        {
            _error = $"Unable to create task: {ex.Message}";
        }
    }

    private string? BuildTaskInstructions()
    {
        var text = _newTask.Instructions?.Trim();
        if (_attachments.Count == 0)
        {
            return string.IsNullOrWhiteSpace(text) ? null : text;
        }

        var builder = new StringBuilder();
        if (!string.IsNullOrWhiteSpace(text))
        {
            builder.AppendLine(text);
            builder.AppendLine();
        }

        builder.AppendLine("Attached file references:");
        foreach (var file in _attachments)
        {
            builder.Append("- ");
            builder.Append(file.Name);
            builder.Append(" (");
            builder.Append(FormatBytes(file.Size));
            if (!string.IsNullOrWhiteSpace(file.ContentType))
            {
                builder.Append(", ");
                builder.Append(file.ContentType);
            }
            builder.AppendLine(")");
        }

        return builder.ToString();
    }

    private async Task StartAgent(AgentDto agent)
    {
        var assignedTask = QueueTasks.FirstOrDefault(t => AssignedToAgent(t, agent));
        if (assignedTask is not null)
        {
            await RunTask(assignedTask);
            return;
        }

        _newTask = TaskComposer.Default();
        _newTask.AssignedTo = agent.AgentId.ToString();
        _newTask.TargetRole = agent.Role;
        _newTask.Runtime = string.IsNullOrWhiteSpace(agent.DefaultRuntime) ? "default" : agent.DefaultRuntime;
        _newTask.Priority = AgentPriorityLabel(agent.Priority) == "critical" ? "critical" : "normal";
        _notice = $"Composer assigned to {agent.Name}. Add a description to start a new task.";
    }

    private async Task RunTask(AgentTaskDto task, bool showNotice = true)
    {
        _error = null;
        _notice = null;

        try
        {
            var response = await Http.PostAsync(Ui($"/ui/agent-tasks/{Uri.EscapeDataString(task.TaskId)}/run"), null);
            if (!response.IsSuccessStatusCode)
            {
                _error = $"Start failed with status {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
                return;
            }

            if (showNotice)
            {
                _notice = $"Started task {task.TaskId}.";
            }
            await LoadData(showLoading: false);
        }
        catch (Exception ex)
        {
            _error = $"Unable to start task: {ex.Message}";
        }
    }

    private async Task StopAgent(AgentDto agent)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Stop {agent.Name}? This clears the dashboard running state and blocks the current task if one is recorded."))
        {
            return;
        }

        _error = null;
        _notice = null;

        try
        {
            if (!string.IsNullOrWhiteSpace(agent.CurrentTaskId))
            {
                await Http.PutAsJsonAsync(
                    Ui($"/ui/agent-tasks/{Uri.EscapeDataString(agent.CurrentTaskId)}"),
                    new UpdateAgentTaskRequest(Status: "blocked", ResultOutput: "Stopped from Agent Dashboard."));
            }

            var response = await Http.PutAsJsonAsync(
                Ui($"/ui/agents/{agent.AgentId}"),
                new UpdateAgentRequest(CurrentTaskId: "", WorkStatus: "idle", LastHeartbeatAt: DateTimeOffset.UtcNow, LastError: ""));

            if (!response.IsSuccessStatusCode)
            {
                _error = $"Stop failed with status {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
                return;
            }

            _notice = $"{agent.Name} stopped.";
            await LoadData(showLoading: false);
        }
        catch (Exception ex)
        {
            _error = $"Unable to stop agent: {ex.Message}";
        }
    }

