    private string _newScheduleLabel = "";

    private bool _showAgentModal;
    private Guid? _editingAgentId;
    private AgentForm _agentForm = new();
    private TaskComposer _newTask = TaskComposer.Default();

    private static readonly DateTimeOffset AppStartedAt = DateTimeOffset.UtcNow;

    private IReadOnlyList<AgentDto> RunningAgents =>
        _agents.Where(IsRunning)
            .OrderByDescending(a => a.LastHeartbeatAt ?? DateTimeOffset.MinValue)
            .ThenBy(a => a.Name)
