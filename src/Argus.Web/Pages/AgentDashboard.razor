    private void OpenEditAgent(AgentDto agent)
    {
        _editingAgentId = agent.AgentId;
        _agentForm = new AgentForm
        {
            Name = agent.Name,
            Role = agent.Role,
            Tool = agent.Tool,
            Model = agent.Model,
            Provider = agent.Provider ?? "",
            Priority = agent.Priority,
