@page "/todos"
@page "/development/todos"
@implements IAsyncDisposable
@using System.Net.Http.Json
@using System.Text.Json
@using Argus.Contracts.Agents
@inject HttpClient Http
@inject NavigationManager Nav
@inject DevelopmentRealtimeClient Realtime

<PageHeader Title="Todos" Subtitle="@($"{_todos?.Count ?? 0} total")" />

<ErrorBoundary>
    <div class="page-body dev-page">
        <div class="dev-action-row" style="margin-bottom: 12px;">
            <button class="btn primary" @onclick="OpenCreateModal">+ New Todo</button>
            <button class="btn ghost" @onclick="() => LoadTodos()" style="margin-left: 8px;">Refresh</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="dev-alert">@_error</div>
        }
        @if (_loading)
        {
            <div class="empty-state">
                <div class="app-loading-spinner"></div>
                <p>Loading todos…</p>
            </div>
        }
        else if (_todos == null || !_todos.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">📝</div>
                <div class="empty-state-title">No todos yet</div>
                <div class="empty-state-description">Create a todo to get started.</div>
            </div>
        }
        else
        {
            <table class="dev-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Instructions</th>
                        <th>Priority</th>
                        <th>Worker</th>
                        <th>Deadline</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Completed</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var todo in _todos)
                    {
                        <tr>
                            <td>@todo.Name</td>
                            <td class="mono">@todo.Instructions</td>
                            <td>@todo.Priority</td>
                            <td>@(todo.WorkerType ?? "-")</td>
                            <td>@(todo.Deadline?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>@todo.Status</td>
                            <td>@todo.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            <td>@(todo.CompletedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>
                                <button class="btn btn-sm" @onclick="() => OpenEditModal(todo)">Edit</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteTodo(todo.TodoId)" style="margin-left:4px;">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (_showModal)
    {
        <div class="dev-modal-overlay" @onclick="CloseModal">
            <div class="dev-modal" @onclick:stopPropagation="true">
                <div class="dev-modal-head">
                    <span class="dot @(IsEditing ? "amber" : "green")"></span>
                    @(IsEditing ? "Edit Todo" : "Create Todo")
                    <button class="dev-icon-btn" @onclick="CloseModal">×</button>
                </div>
                <div class="dev-modal-body">
                    <div class="dev-form-grid">
                        <div class="dev-form-field">
                            <label>Name</label>
                            <input class="dev-input" @bind="_form.Name" @bind:event="oninput" placeholder="Todo name" />
                        </div>
                        <div class="dev-form-field full">
                            <label>Instructions</label>
                            <textarea class="dev-input" rows="3" @bind="_form.Instructions" @bind:event="oninput"></textarea>
                        </div>
                        <div class="dev-form-field">
                            <label>Priority</label>
                            <select class="dev-input" @bind="_form.Priority">
                                <option value="critical">critical</option>
                                <option value="high">high</option>
                                <option value="normal">normal</option>
                                <option value="medium">medium</option>
                                <option value="low">low</option>
                            </select>
                        </div>
                        <div class="dev-form-field">
                            <label>Worker Type</label>
                            <select class="dev-input" @bind="_form.WorkerType" required>
                                <option value="">— select role —</option>
                                <option value="junior_developer">Junior Developer</option>
                                <option value="developer">Developer</option>
                                <option value="senior_developer">Senior Developer</option>
                                <option value="system_architect">System Architect</option>
                                <option value="devops">DevOps</option>
                                <option value="product_manager">Product Manager</option>
                                <option value="chief_technology_officer">Chief Technology Officer</option>
                            </select>
                        </div>
                        <div class="dev-form-field">
                            <label>Deadline (EST)</label>
                            <input type="datetime-local" class="dev-input" @bind="_deadline" />
                        </div>
                        @if (IsEditing)
                        {
                            <div class="dev-form-field">
                                <label>Status</label>
                                <select class="dev-input" @bind="_status">
                                    <option value="pending">pending</option>
                                    <option value="in_progress">in_progress</option>
                                    <option value="completed">completed</option>
                                    <option value="cancelled">cancelled</option>
                                </select>
                            </div>
                        }
                    </div>
                </div>
                <div class="dev-modal-foot">
                    <button class="btn ghost" @onclick="CloseModal">Cancel</button>
                    <button class="btn primary" @onclick="SaveTodo" disabled="@(string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.Instructions) || string.IsNullOrWhiteSpace(_form.WorkerType))">
                        @(IsEditing ? "Save" : "Create")
                    </button>
                </div>
            </div>
        </div>
    }
</ErrorBoundary>

@code {
    private static readonly TimeZoneInfo EstTimeZone = ResolveEasternTimeZone();

    private List<TodoItemDto> _todos = new();
    private bool _loading = true;
    private string? _error;
    private bool _showModal = false;
    private Guid? _editingTodoId;
    private bool IsEditing => _editingTodoId.HasValue;
    private class TodoForm
    {
        public string Name { get; set; } = string.Empty;
        public string Instructions { get; set; } = string.Empty;
        public string Priority { get; set; } = "normal";
        public string WorkerType { get; set; } = string.Empty;
    }
    private TodoForm _form = new();
    private DateTime? _deadline;
    private string _status = "pending";

    private DateTime GetDefaultDeadline() =>
        TimeZoneInfo.ConvertTimeFromUtc(DateTimeOffset.UtcNow.AddHours(24).UtcDateTime, EstTimeZone);

    protected override async Task OnInitializedAsync()
    {
        Realtime.Changed += OnDevelopmentDataChanged;
        await Realtime.StartAsync();
        await LoadTodos();
    }

    private record TodoListResponse(List<TodoItemDto> Items, int Count);

    private async Task LoadTodos(bool showLoading = true)
    {
        _loading = showLoading && _todos.Count == 0;
        try
        {
            var response = await Http.GetFromJsonAsync<TodoListResponse>("/ui/todos");
            _todos = response?.Items ?? new();
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"Unable to load todos: {ex.Message}";
            _todos = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OnDevelopmentDataChanged(DevelopmentDataChangedEvent change)
    {
        if (change.Area is "todos" or "agent-tasks")
        {
            return InvokeAsync(() => LoadTodos(showLoading: false));
        }

        return Task.CompletedTask;
    }

    public ValueTask DisposeAsync()
    {
        Realtime.Changed -= OnDevelopmentDataChanged;
        return ValueTask.CompletedTask;
    }

    private static TimeZoneInfo ResolveEasternTimeZone()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time");
        }
        catch (TimeZoneNotFoundException)
        {
            return TimeZoneInfo.FindSystemTimeZoneById("America/New_York");
        }
    }

    private void OpenCreateModal()
    {
        _editingTodoId = null;
        _form = new TodoForm();
        _deadline = GetDefaultDeadline();
        _status = "pending";
        _showModal = true;
    }

    private void OpenEditModal(TodoItemDto todo)
    {
        _editingTodoId = todo.TodoId;
        _form = new TodoForm { Name = todo.Name, Instructions = todo.Instructions, Priority = todo.Priority, WorkerType = todo.WorkerType ?? "" };
        _deadline = todo.Deadline.HasValue ? TimeZoneInfo.ConvertTimeFromUtc(todo.Deadline.Value.UtcDateTime, EstTimeZone) : null;
        _status = todo.Status;
        _showModal = true;
    }

    private async Task SaveTodo()
    {
        DateTimeOffset? deadline = null;
        if (_deadline.HasValue)
        {
            deadline = new DateTimeOffset(_deadline.Value, EstTimeZone.GetUtcOffset(_deadline.Value));
        }

        if (IsEditing && _editingTodoId.HasValue)
        {
            var update = new UpdateTodoRequest(
                Name: _form.Name,
                Instructions: _form.Instructions,
                Priority: _form.Priority,
                WorkerType: string.IsNullOrWhiteSpace(_form.WorkerType) ? null : _form.WorkerType,
                Deadline: deadline,
                Status: _status
            );
            var resp = await Http.PutAsJsonAsync($"/ui/todos/{_editingTodoId}", update);
            await resp.Content.ReadAsStringAsync();
        }
        else
        {
            var create = new CreateTodoRequest(
                Name: _form.Name,
                Instructions: _form.Instructions,
                Priority: _form.Priority,
                WorkerType: string.IsNullOrWhiteSpace(_form.WorkerType) ? null : _form.WorkerType,
                Deadline: deadline
            );
            var resp = await Http.PostAsJsonAsync("/ui/todos", create);
            await resp.Content.ReadAsStringAsync();
        }
        await LoadTodos();
        CloseModal();
    }

    private async Task DeleteTodo(Guid todoId)
    {
        await Http.DeleteAsync($"/ui/todos/{todoId}");
        await LoadTodos();
    }

    private void CloseModal()
    {
        _showModal = false;
    }
}
