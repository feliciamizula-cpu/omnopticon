@page "/agent-schedules"
@page "/development/schedules"
@implements IAsyncDisposable
@using System.Net.Http.Json
@using System.Text.Json
@using Argus.Contracts.Agents
@inject HttpClient Http
@inject NavigationManager Nav
@inject DevelopmentRealtimeClient Realtime

<PageHeader Title="Agent Schedules" Subtitle="@($"{FilteredSchedules.Count:N0} visible · {_schedules.Count:N0} jobs")" />

<div class="page-body dev-page">
    <div class="dev-main">
        <div class="page-tabs">
            @foreach (var tab in ScheduleTabs)
            {
                <button class="page-tab @(_filter == tab.Id ? "active" : "")" @onclick="() => SetFilter(tab.Id)">
                    <span>@tab.Label</span>
                    <span class="tab-count">@tab.Count</span>
                </button>
            }
            <div class="page-tab-spacer"></div>
            <div class="page-tab-actions">
                <button class="btn primary tiny" @onclick="OpenCreateModal">+ Add Schedule</button>
                <button class="btn ghost tiny" @onclick="() => LoadData()">Refresh</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="dev-alert">@_error</div>
        }

        <div class="dev-stats-strip">
            <DevStat Label="Recurring jobs" Value='@(_schedules.Count.ToString("N0"))' Sub="persisted agent tasks" />
            <DevStat Label="Enabled" Value='@(_schedules.Count(s => s.Enabled).ToString("N0"))' Tone="green" Sub="eligible to run" />
            <DevStat Label="Paused" Value='@(_schedules.Count(s => !s.Enabled).ToString("N0"))' Tone="amber" Sub="blocked/manual resume" />
            <DevStat Label="Agents" Value='@(_agents.Count.ToString("N0"))' Sub="from agent service" />
            <DevStat Label="Due soon" Value='@(_schedules.Count(s => s.Enabled && IsDueSoon(s)).ToString("N0"))' Tone="cyan" Sub="next 30 minutes" />
        </div>

        @if (_loading)
        {
            <div class="dev-empty">
                <div>
                    <div class="app-loading-spinner" style="margin: 0 auto 12px;"></div>
                    <div>// loading schedules</div>
                </div>
            </div>
        }
        else
        {
            <div class="dev-list-pane">
                <div class="mono-label">RECURRING AND TRIGGERED JOBS · @FilteredSchedules.Count</div>

                @if (FilteredSchedules.Count == 0)
                {
                    <div class="dev-empty">// no schedules match this filter</div>
                }
                else
                {
                    <div class="schedule-grid">
                        @foreach (var schedule in FilteredSchedules)
                        {
                            <div class="schedule-card @(schedule.Enabled ? "enabled" : "paused")">
                                <div class="type-row">
                                    <span class="dot @(schedule.Enabled ? "green" : "") @(IsDueSoon(schedule) ? "pulse" : "")"></span>
                                    <span class="dev-pill @RoleTone(schedule.AgentRole)">@RoleLabel(schedule.AgentRole)</span>
                                    <span class="dev-card-title">@schedule.Label</span>
                                    <span class="asset-id">@schedule.Id</span>
                                </div>

                                <div class="dev-command-line">
                                    <span class="tone-@ToolTone(schedule.AgentTool)">@schedule.AgentName</span>
                                    <span style="color: var(--fg-3);"> · </span>
                                    <span style="color: var(--amber);">@schedule.Cron</span>
                                </div>

                                <div class="dev-current-task active">
                                    <div class="label">PROMPT TEMPLATE</div>
                                    <div class="body">@schedule.Prompt</div>
                                </div>

                                <div class="dev-mini-grid">
                                    <div class="dev-mini"><div class="l">last run</div><div class="v">@Relative(schedule.LastRunAt)</div></div>
                                    <div class="dev-mini"><div class="l">next run</div><div class="v @(IsDueSoon(schedule) ? "tone-cyan" : "")">@RelativeFuture(schedule.NextRunAt)</div></div>
                                    <div class="dev-mini"><div class="l">source</div><div class="v">@schedule.Source</div></div>
                                    <div class="dev-mini"><div class="l">status</div><div class="v">@(schedule.Enabled ? "scheduled" : "blocked")</div></div>
                                </div>

                                <div class="dev-action-row" style="padding: 10px 0 0;">
                                    <button class="btn ghost tiny" @onclick="() => ToggleSchedule(schedule.Id)">@(schedule.Enabled ? "Pause" : "Resume")</button>
                                    <button class="btn primary tiny" @onclick="() => RunNow(schedule.Id)">Run Now</button>
                                    <button class="btn danger tiny" @onclick="() => DeleteSchedule(schedule.Id)">Remove</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (_showModal)
{
    <div class="dev-page">
        <div class="dev-modal-overlay" @onclick="CloseModal">
            <div class="dev-modal" @onclick:stopPropagation="true">
                <div class="dev-modal-head">
                    <span class="dot amber"></span>
                    Add Recurring Agent Job
                    <button class="dev-icon-btn" @onclick="CloseModal">x</button>
                </div>
                <div class="dev-modal-body">
                    <div class="dev-form-grid">
                        <div class="dev-form-field">
                            <label>Target role</label>
                            <select class="dev-input" @bind="_form.TargetRole">
                                <option value="junior_developer">Junior Developer</option>
                                <option value="developer">Developer</option>
                                <option value="senior_developer">Senior Developer</option>
                                <option value="system_architect">System Architect</option>
                                <option value="devops">DevOps</option>
                                <option value="product_manager">Product Manager</option>
                                <option value="chief_technology_officer">Chief Technology Officer</option>
                            </select>
                        </div>
                        <div class="dev-form-field">
                            <label>Schedule</label>
                            <select class="dev-input" @bind="_form.Cron">
                                <option value="* * * * *">Every minute</option>
                                <option value="*/15 * * * *">Every 15 minutes</option>
                                <option value="0 * * * *">Hourly</option>
                                <option value="0 */4 * * *">Every 4 hours</option>
                                <option value="0 9 * * 1-5">Weekdays at 09:00</option>
                            </select>
                        </div>
                        <div class="dev-form-field full">
                            <label>Job label</label>
                            <input class="dev-input" @bind="_form.Label" @bind:event="oninput" placeholder="Review open development tasks" />
                        </div>
                        <div class="dev-form-field full">
                            <label>Prompt template</label>
                            <textarea class="dev-input" rows="5" @bind="_form.Prompt" @bind:event="oninput" placeholder="Inspect pending tasks, pick the highest-priority unassigned item, and produce an implementation plan."></textarea>
                        </div>
                    </div>
                </div>
                <div class="dev-modal-foot">
                    <button class="btn ghost" @onclick="CloseModal">Cancel</button>
                    <button class="btn primary" @onclick="CreateSchedule" disabled="@(!CanCreateSchedule)">Add Schedule</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly JsonSerializerOptions _jsonOptions = new(JsonSerializerDefaults.Web)
    {
        PropertyNameCaseInsensitive = true
    };

    private List<AgentDto> _agents = new();
    private List<AgentTaskDto> _tasks = new();
    private bool _loading = true;
    private string _filter = "all";
    private string? _error;
    private bool _showModal;
    private ScheduleForm _form = new();

    private List<AgentSchedule> _schedules => _tasks
        .Where(t => !string.IsNullOrWhiteSpace(t.ScheduleExpression) || !string.IsNullOrWhiteSpace(t.TriggerEvent))
        .Select(ToSchedule)
        .OrderBy(s => s.NextRunAt)
        .ToList();

    private List<ScheduleTab> ScheduleTabs =>
    [
        new("all", "All Schedules", _schedules.Count),
        new("enabled", "Enabled", _schedules.Count(s => s.Enabled)),
        new("paused", "Paused", _schedules.Count(s => !s.Enabled)),
        new("due", "Due Soon", _schedules.Count(IsDueSoon))
    ];

    private List<AgentSchedule> FilteredSchedules => _filter switch
    {
        "enabled" => _schedules.Where(s => s.Enabled).ToList(),
        "paused" => _schedules.Where(s => !s.Enabled).ToList(),
        "due" => _schedules.Where(IsDueSoon).ToList(),
        _ => _schedules
    };

    private bool CanCreateSchedule =>
        !string.IsNullOrWhiteSpace(_form.TargetRole)
        && !string.IsNullOrWhiteSpace(_form.Label)
        && !string.IsNullOrWhiteSpace(_form.Cron)
        && !string.IsNullOrWhiteSpace(_form.Prompt);

    protected override async Task OnInitializedAsync()
    {
        Realtime.Changed += OnDevelopmentDataChanged;
        await Realtime.StartAsync();
        await LoadData();
    }

    private async Task LoadData(bool showLoading = true)
    {
        _loading = showLoading && _agents.Count == 0 && _tasks.Count == 0;
        _error = null;
        try
        {
            await Task.WhenAll(LoadAgentsAsync(), LoadTasksAsync());
        }
        catch (Exception ex)
        {
            _error = $"Unable to load schedules: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAgentsAsync()
    {
        _agents = await ReadItemsAsync<AgentDto>(await Http.GetAsync(Nav.ToAbsoluteUri("/ui/agents")));
        StateHasChanged();
    }

    private async Task LoadTasksAsync()
    {
        _tasks = await ReadItemsAsync<AgentTaskDto>(await Http.GetAsync(Nav.ToAbsoluteUri("/ui/agent-tasks")));
        StateHasChanged();
    }

    private Task OnDevelopmentDataChanged(DevelopmentDataChangedEvent change)
    {
        if (change.Area is "agents" or "agent-tasks" or "todos")
        {
            return InvokeAsync(() => LoadData(showLoading: false));
        }

        return Task.CompletedTask;
    }

    public ValueTask DisposeAsync()
    {
        Realtime.Changed -= OnDevelopmentDataChanged;
        return ValueTask.CompletedTask;
    }

    private async Task<List<T>> ReadItemsAsync<T>(HttpResponseMessage response)
    {
        if (!response.IsSuccessStatusCode)
        {
            _error = $"Backend returned {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
            return new List<T>();
        }

        await using var stream = await response.Content.ReadAsStreamAsync();
        using var document = await JsonDocument.ParseAsync(stream);
        if (document.RootElement.ValueKind == JsonValueKind.Object
            && document.RootElement.TryGetProperty("items", out var items)
            && items.ValueKind == JsonValueKind.Array)
        {
            return JsonSerializer.Deserialize<List<T>>(items.GetRawText(), _jsonOptions) ?? new List<T>();
        }

        return new List<T>();
    }

    private void SetFilter(string filter) => _filter = filter;

    private void OpenCreateModal()
    {
        _form = new ScheduleForm
        {
            TargetRole = "developer",
            Label = "Review open development tasks",
            Cron = "*/15 * * * *",
            Prompt = "Inspect pending tasks, pick the highest-priority unassigned item, and produce an implementation plan."
        };
        _showModal = true;
    }

    private void CloseModal() => _showModal = false;

    private async Task CreateSchedule()
    {
        if (!CanCreateSchedule)
            return;

        var request = new CreateAgentTaskRequest(
            Description: $"{_form.Label.Trim()}\n\n{_form.Prompt.Trim()}",
            Priority: "normal",
            TargetRole: _form.TargetRole.Trim(),
            TaskType: "scheduled",
            ScheduleExpression: _form.Cron.Trim());

        var response = await Http.PostAsJsonAsync(Nav.ToAbsoluteUri("/ui/agent-tasks"), request);
        if (!response.IsSuccessStatusCode)
        {
            _error = $"Create failed with status {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
            return;
        }

        _showModal = false;
        await LoadData();
    }

    private async Task ToggleSchedule(string id)
    {
        var task = _tasks.FirstOrDefault(t => t.TaskId == id);
        if (task is null)
            return;

        var next = task.Status.Equals("scheduled", StringComparison.OrdinalIgnoreCase) ? "blocked" : "scheduled";
        await Http.PutAsJsonAsync(Nav.ToAbsoluteUri($"/ui/agent-tasks/{Uri.EscapeDataString(id)}"), new UpdateAgentTaskRequest(Status: next));
        await LoadData();
    }

    private async Task RunNow(string id)
    {
        await Http.PostAsync(Nav.ToAbsoluteUri($"/ui/agent-tasks/{Uri.EscapeDataString(id)}/run"), null);
        await LoadData();
    }

    private async Task DeleteSchedule(string id)
    {
        await Http.DeleteAsync(Nav.ToAbsoluteUri($"/ui/agent-tasks/{Uri.EscapeDataString(id)}"));
        await LoadData();
    }

    private AgentSchedule ToSchedule(AgentTaskDto task)
    {
        var agent = Guid.TryParse(task.AssignedTo, out var agentId)
            ? _agents.FirstOrDefault(a => a.AgentId == agentId)
            : null;

        return new AgentSchedule(
            task.TaskId,
            agent?.AgentId ?? Guid.Empty,
            agent?.Name ?? "role pool",
            task.TargetRole ?? agent?.Role ?? "developer",
            agent?.Tool ?? "pool",
            task.TaskType ?? "Scheduled task",
            task.ScheduleExpression ?? $"trigger: {task.TriggerEvent}",
            task.Description,
            task.Status.Equals("scheduled", StringComparison.OrdinalIgnoreCase),
            task.LastRunAt,
            task.NextRunAt ?? DateTimeOffset.UtcNow,
            task.TriggerEvent is null ? "schedule" : "trigger");
    }

    private static bool IsDueSoon(AgentSchedule schedule) =>
        schedule.Enabled && schedule.NextRunAt <= DateTimeOffset.UtcNow.AddMinutes(30);

    private static string RoleLabel(string role) => NormalizeRole(role) switch
    {
        "product_manager" => "Product Manager",
        "chief_technology_officer" => "CTO",
        "junior_developer" => "Junior Developer",
        "developer" => "Developer",
        "senior_developer" => "Senior Developer",
        "system_architect" => "System Architect",
        "junior_designer" => "Junior Designer",
        "senior_designer" => "Senior Designer",
        "devops" => "DevOps",
        _ => role
    };

    private static string RoleTone(string role) => NormalizeRole(role) switch
    {
        "system_architect" or "devops" => "cyan",
        "senior_developer" => "magenta",
        "junior_designer" or "senior_designer" => "violet",
        "chief_technology_officer" => "red",
        "product_manager" => "green",
        _ => "amber"
    };

    private static string NormalizeRole(string role) =>
        string.IsNullOrWhiteSpace(role) ? "developer" : role.Trim().ToLowerInvariant();

    private static string ToolTone(string tool) => tool.ToLowerInvariant() switch
    {
        "claude" => "violet",
        "codex" => "green",
        "gemini" => "cyan",
        "openai" => "green",
        "opencode" => "cyan",
        _ => "amber"
    };

    private static string Relative(DateTimeOffset? value) => value is null ? "never" : Relative(value.Value);

    private static string Relative(DateTimeOffset value)
    {
        var span = DateTimeOffset.UtcNow - value.ToUniversalTime();
        if (span < TimeSpan.Zero)
            span = TimeSpan.Zero;

        if (span.TotalSeconds < 60)
            return $"{Math.Max(1, (int)span.TotalSeconds)}s ago";

        if (span.TotalMinutes < 60)
            return $"{(int)span.TotalMinutes}m ago";

        if (span.TotalHours < 24)
            return $"{(int)span.TotalHours}h ago";

        return $"{(int)span.TotalDays}d ago";
    }

    private static string RelativeFuture(DateTimeOffset value)
    {
        var span = value.ToUniversalTime() - DateTimeOffset.UtcNow;
        if (span <= TimeSpan.Zero)
            return "due now";

        if (span.TotalMinutes < 60)
            return $"in {(int)Math.Ceiling(span.TotalMinutes)}m";

        if (span.TotalHours < 24)
            return $"in {(int)Math.Ceiling(span.TotalHours)}h";

        return $"in {(int)Math.Ceiling(span.TotalDays)}d";
    }

    private sealed record ScheduleTab(string Id, string Label, int Count);

    private sealed record AgentSchedule(
        string Id,
        Guid AgentId,
        string AgentName,
        string AgentRole,
        string AgentTool,
        string Label,
        string Cron,
        string Prompt,
        bool Enabled,
        DateTimeOffset? LastRunAt,
        DateTimeOffset NextRunAt,
        string Source);

    private sealed class ScheduleForm
    {
        public string TargetRole { get; set; } = "developer";
        public string Label { get; set; } = "";
        public string Cron { get; set; } = "*/15 * * * *";
        public string Prompt { get; set; } = "";
    }
}
