@page "/provider-usage"
@page "/development/provider-usage"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Http.Json
@using Argus.Contracts.Agents
@inject HttpClient Http
@inject NavigationManager Nav

<PageHeader Title="Provider Usage" Subtitle="CLI authentication, tool health, usage windows, and automatic task routing" />

<div class="page-body dev-page provider-usage-page">
    <div class="dev-main">
        <div class="page-tabs">
            <a class="page-tab" href="/agents">Agents</a>
            <a class="page-tab" href="/agent-tasks">Agent Tasks</a>
            <a class="page-tab" href="/agent-schedules">Schedules</a>
            <a class="page-tab active" href="/provider-usage">Provider Usage <span class="tab-count">@(_overview?.Providers.Length ?? 0)</span></a>
            <span class="page-tab-spacer"></span>
            <div class="page-tab-actions">
                <button class="btn ghost tiny" @onclick="Load" disabled="@_loading">Refresh</button>
                <button class="btn primary tiny" @onclick="RefreshAll" disabled="@_refreshing">Run Checks</button>
            </div>
        </div>

        <div class="dev-stats-strip">
            <DevStat Label="Providers" Value='@((_overview?.Providers.Length ?? 0).ToString("N0"))' Sub="configured CLI accounts" />
            <DevStat Label="Logged In" Value='@(Providers.Count(p => p.IsAuthenticated).ToString("N0"))' Sub="auth checks passing" />
            <DevStat Label="CLI Tools" Value='@(Providers.Count(p => p.ToolStatus.IsAvailable).ToString("N0"))' Sub="version command succeeded" />
            <DevStat Label="Auto Route" Value='@(RouteLabel)' Sub='@(_routing?.Reason ?? _overview?.RecommendedRoute?.Reason ?? "waiting for provider checks")' />
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="dev-alert">@_error</div>
        }
        @if (!string.IsNullOrWhiteSpace(_notice))
        {
            <div class="dev-note provider-notice">@_notice</div>
        }

        @if (_loading && _overview is null)
        {
            <div class="dev-empty">Loading provider usage and CLI status…</div>
        }
        else
        {
            <div class="provider-layout">
                <div class="provider-grid-wrap">
                    <div class="provider-grid">
                        @foreach (var provider in Providers)
                        {
                            <section class="provider-card">
                                <div class="provider-card-head">
                                    <div class="provider-title-line">
                                        <span class="dot @ProviderDot(provider)"></span>
                                        <div>
                                            <div class="provider-title">@provider.ProviderName</div>
                                            <div class="provider-subtitle mono">@provider.ToolStatus.Executable --version</div>
                                        </div>
                                    </div>
                                    <div class="provider-score">
                                        <span class="score-value">@provider.RoutingScore.ToString("0.#")</span>
                                        <span class="score-label">route</span>
                                    </div>
                                </div>

                                <div class="dev-chipline compact">
                                    <span class="dev-pill @ToolTone(provider)">@ToolStatusText(provider)</span>
                                    <span class="dev-pill @AuthTone(provider)">@(provider.IsAuthenticated ? "logged in" : "not logged in")</span>
                                    <span class="dev-pill @RoutingTone(provider)">@provider.RoutingStatus</span>
                                </div>

                                <table class="kv-table provider-kv">
                                    <tbody>
                                    <tr><td>Provider</td><td>@provider.DisplayModelHint</td></tr>
                                    <tr><td>Tool status</td><td>@ToolStatusLine(provider)</td></tr>
                                    <tr><td>Version</td><td class="mono">@(provider.ToolStatus.Version ?? "—")</td></tr>
                                    <tr><td>Auth status</td><td>@provider.AuthStatus</td></tr>
                                    <tr><td>Reset data</td><td>@KnownUsageCount(provider)/3 windows configured</td></tr>
                                    </tbody>
                                </table>

                                <div class="usage-window-stack">
                                    <UsageWindow Window="provider.FiveHour" />
                                    <UsageWindow Window="provider.Weekly" />
                                    <UsageWindow Window="provider.Monthly" />
                                </div>

                                @if (!string.IsNullOrWhiteSpace(provider.LastError))
                                {
                                    <div class="dev-error">@provider.LastError</div>
                                }

                                <div class="provider-command-box">
                                    <div class="mono-label">LOGIN COMMAND</div>
                                    <div class="provider-command mono">@provider.LoginCommand</div>
                                    <div class="provider-login-help">@provider.LoginInstructions</div>
                                </div>

                                <div class="provider-actions">
                                    <button class="btn primary tiny" @onclick="() => Login(provider)" disabled="@(_refreshing || _loading || _busyProviderIds.Contains(provider.ProviderId))">Login / Recheck</button>
                                    <button class="btn ghost tiny" @onclick="() => RefreshProvider(provider)" disabled="@(_refreshing || _loading || _busyProviderIds.Contains(provider.ProviderId))">Refresh Provider</button>
                                </div>
                            </section>
                        }
                    </div>
                </div>

                <aside class="dev-inspector provider-inspector">
                    <div class="dev-inspector-head">
                        <div class="type-row">
                            <span class="dev-pill @(IsRouteRunnable ? "green" : "red")">routing</span>
                            <span class="asset-id">AUTO</span>
                        </div>
                        <div class="value-big">Task Routing</div>
                        <div class="submeta">
                            <span>policy <b>highest available usage first</b></span>
                        </div>
                    </div>
                    <div class="dev-inspector-body">
                        <div class="section-label">CURRENT DECISION</div>
                        <table class="kv-table">
                            <tbody>
                            <tr><td>Runnable</td><td><span class="dev-pill @(IsRouteRunnable ? "green" : "red")">@(IsRouteRunnable ? "yes" : "no")</span></td></tr>
                            <tr><td>Provider</td><td>@(_routing?.ProviderName ?? _overview?.RecommendedRoute?.ProviderName ?? "—")</td></tr>
                            <tr><td>CLI</td><td class="mono">@(_routing?.ToolId ?? _overview?.RecommendedRoute?.ToolId ?? "—")</td></tr>
                            <tr><td>Agent</td><td>@(_routing?.AgentName ?? "—")</td></tr>
                            <tr><td>Score</td><td>@((_routing?.RoutingScore ?? _overview?.RecommendedRoute?.RoutingScore ?? 0).ToString("0.#"))</td></tr>
                            <tr><td>Reason</td><td>@(_routing?.Reason ?? _overview?.RecommendedRoute?.Reason ?? "No routing decision yet.")</td></tr>
                            </tbody>
                        </table>

                        <div class="section-label">ROUTING RULES</div>
                        <div class="dev-note">
Tasks created without an explicit assignee are routed automatically. The AgentService checks provider CLI availability, authentication, and available usage windows. It selects the active agent whose CLI maps to the provider with the highest remaining usage score. Explicit task assignment still overrides automatic routing.
                        </div>

                        <div class="section-label">USAGE DATA SOURCE</div>
                        <div class="dev-note">
Usage windows are populated from configured provider usage commands or configured window values. CLI version and auth state are checked directly by running each configured CLI command on the server host.
                        </div>

                        <div class="dev-action-row">
                            <button class="btn ghost tiny" @onclick="Load" disabled="@_loading">Reload</button>
                            <button class="btn primary tiny" @onclick="RefreshAll" disabled="@_refreshing">Run All Checks</button>
                        </div>
                    </div>
                </aside>
            </div>
        }
    </div>
</div>

@code {
    private ProviderUsageOverviewDto? _overview;
    private ProviderRouteSelectionDto? _routing;
    private readonly HashSet<string> _busyProviderIds = new(StringComparer.OrdinalIgnoreCase);
    private bool _loading;
    private bool _refreshing;
    private string? _error;
    private string? _notice;

    private IReadOnlyList<ProviderUsageDto> Providers => _overview?.Providers ?? Array.Empty<ProviderUsageDto>();

    private bool IsRouteRunnable => _routing?.IsRunnable ?? _overview?.RecommendedRoute?.IsRunnable ?? false;

    private string RouteLabel =>
        _routing?.ProviderName
        ?? _overview?.RecommendedRoute?.ProviderName
        ?? "—";

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        _error = null;
        _notice = null;
        try
        {
            _overview = await Http.GetFromJsonAsync<ProviderUsageOverviewDto>(Ui("/ui/provider-usage"));
            _routing = await Http.GetFromJsonAsync<ProviderRouteSelectionDto>(Ui("/ui/provider-usage/routing-preview"));
        }
        catch (Exception ex)
        {
            _error = $"Unable to load provider usage: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAll()
    {
        _refreshing = true;
        _error = null;
        _notice = null;
        try
        {
            var response = await Http.PostAsync(Ui("/ui/provider-usage/refresh"), null);
            if (!response.IsSuccessStatusCode)
            {
                _error = $"Provider refresh failed with status {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
                return;
            }

            _overview = await response.Content.ReadFromJsonAsync<ProviderUsageOverviewDto>()
                ?? new ProviderUsageOverviewDto(DateTimeOffset.UtcNow, [], null);
            _routing = await Http.GetFromJsonAsync<ProviderRouteSelectionDto>(Ui("/ui/provider-usage/routing-preview"));
            _notice = "Provider CLI, auth, usage, and routing status refreshed.";
        }
        catch (Exception ex)
        {
            _error = $"Unable to refresh provider usage: {ex.Message}";
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task RefreshProvider(ProviderUsageDto provider)
    {
        _busyProviderIds.Add(provider.ProviderId);
        _error = null;
        _notice = null;
        try
        {
            var response = await Http.PostAsync(Ui($"/ui/provider-usage/{provider.ProviderId}/refresh"), null);
            if (!response.IsSuccessStatusCode)
            {
                _error = $"{provider.ProviderName} refresh failed with status {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
                return;
            }

            await Load();
            _notice = $"{provider.ProviderName} status refreshed.";
        }
        catch (Exception ex)
        {
            _error = $"Unable to refresh {provider.ProviderName}: {ex.Message}";
        }
        finally
        {
            _busyProviderIds.Remove(provider.ProviderId);
        }
    }

    private async Task Login(ProviderUsageDto provider)
    {
        _busyProviderIds.Add(provider.ProviderId);
        _error = null;
        _notice = null;
        try
        {
            var response = await Http.PostAsync(Ui($"/ui/provider-usage/{provider.ProviderId}/login"), null);
            if (!response.IsSuccessStatusCode)
            {
                _error = $"{provider.ProviderName} login failed with status {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
                return;
            }

            var login = await response.Content.ReadFromJsonAsync<ProviderLoginResponseDto>();
            await Load();
            _notice = FormatLoginNotice(login);
        }
        catch (Exception ex)
        {
            _error = $"Unable to run {provider.ProviderName} login command: {ex.Message}";
        }
        finally
        {
            _busyProviderIds.Remove(provider.ProviderId);
        }
    }

    private string Ui(string path) => Nav.ToAbsoluteUri(path).ToString();

    private static string FormatLoginNotice(ProviderLoginResponseDto? login)
    {
        if (login is null)
        {
            return "Login command completed, but no response body was returned.";
        }

        var output = string.IsNullOrWhiteSpace(login.Output) ? string.Empty : $"\n\nOUTPUT\n{login.Output}";
        var error = string.IsNullOrWhiteSpace(login.Error) ? string.Empty : $"\n\nERROR\n{login.Error}";
        return $"{login.ProviderName}: {login.Message}\nCommand: {login.Command}{output}{error}";
    }

    private static string ProviderDot(ProviderUsageDto provider)
    {
        if (!provider.ToolStatus.IsAvailable)
        {
            return "red";
        }

        if (!provider.IsAuthenticated)
        {
            return "amber";
        }

        return provider.RoutingScore > 0 ? "green" : "red";
    }

    private static string ToolTone(ProviderUsageDto provider) => provider.ToolStatus.IsAvailable ? "green" : "red";

    private static string AuthTone(ProviderUsageDto provider)
    {
        if (!provider.ToolStatus.IsAvailable)
        {
            return "dim";
        }

        return provider.IsAuthenticated ? "green" : "amber";
    }

    private static string RoutingTone(ProviderUsageDto provider) => provider.RoutingScore switch
    {
        <= 0 => "red",
        < 20 => "amber",
        _ => "green"
    };

    private static string ToolStatusText(ProviderUsageDto provider) => provider.ToolStatus.IsAvailable ? "tool ready" : "tool missing";

    private static string ToolStatusLine(ProviderUsageDto provider)
    {
        if (provider.ToolStatus.IsAvailable)
        {
            return $"{provider.ToolStatus.Executable} available";
        }

        return string.IsNullOrWhiteSpace(provider.ToolStatus.Error)
            ? $"{provider.ToolStatus.Executable} missing"
            : provider.ToolStatus.Error;
    }

    private static int KnownUsageCount(ProviderUsageDto provider) =>
        new[] { provider.FiveHour, provider.Weekly, provider.Monthly }.Count(window => window.IsKnown);

    private static string FormatReset(DateTimeOffset? value)
    {
        if (value is null)
        {
            return "unknown";
        }

        return value.Value.ToLocalTime().ToString("MMM d, h:mm tt");
    }

    private static string FormatAmount(decimal value) => value == Math.Truncate(value)
        ? value.ToString("N0")
        : value.ToString("N1");

    private static double PercentWidth(ProviderUsageWindowDto window) => window.IsKnown
        ? Math.Clamp((double)window.RemainingPercent, 0, 100)
        : 0;

    private static string WindowTone(ProviderUsageWindowDto window)
    {
        if (!window.IsKnown)
        {
            return "unknown";
        }

        return window.RemainingPercent switch
        {
            <= 0 => "empty",
            < 20 => "low",
            < 60 => "medium",
            _ => "high"
        };
    }
}
