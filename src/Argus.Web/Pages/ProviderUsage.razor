@page "/provider-usage"
@page "/development/provider-usage"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@using System.Net.Http.Json
@using System.Text.Json
@using Argus.Contracts.Agents
@inject HttpClient Http
@inject NavigationManager Nav
@inject DevelopmentRealtimeClient Realtime

<PageHeader Title="Provider Usage" Subtitle="CLI authentication, tool health, usage windows, and automatic task routing" />

<ErrorBoundary><div class="page-body dev-page provider-usage-page">
    <div class="dev-main">
        <div class="page-tabs">
            <a class="page-tab" href="/agents">Agents</a>
            <a class="page-tab" href="/agent-tasks">Agent Tasks</a>
            <a class="page-tab" href="/agent-schedules">Schedules</a>
            <a class="page-tab active" href="/provider-usage">Provider Usage <span class="tab-count">@(_overview?.Providers.Length ?? 0)</span></a>
        </div>

        <div class="dev-stats-strip">
            <DevStat Label="Providers" Value="@((_overview?.Providers.Length ?? 0).ToString())" Sub="configured CLI accounts" />
            <DevStat Label="Logged In" Value="@LoggedInCount.ToString()" Sub="auth checks passing" />
            <DevStat Label="CLI Tools" Value="@CliToolsCount.ToString()" Sub="version command succeeded" />
            <DevStat Label="Auto Route" Value="@RouteLabel" Sub="@(_routing?.Reason ?? _overview?.RecommendedRoute?.Reason ?? "waiting for provider checks")" />
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="dev-alert">@_error</div>
        }
        @if (!string.IsNullOrWhiteSpace(_notice))
        {
            <div class="dev-note provider-notice">@_notice</div>
        }

        @if (_loading && _overview is null)
        {
            <div class="dev-empty">Loading provider usage and CLI status…</div>
        }
        else
        {
            <div class="provider-layout">
                <div class="provider-grid-wrap">
                    <div class="provider-grid">
                        @foreach (var provider in Providers)
                        {
                            <div class="provider-card @(IsSelected(provider) ? "selected" : "")" @onclick="() => SelectProvider(provider)">
                                <div class="provider-card-head">
                                    <div class="provider-title-line">
                                        <span class="dot @(ProviderDot(provider))"></span>
                                        <div>
                                            <div class="provider-title">@provider.ProviderName</div>
                                            <div class="provider-subtitle">@provider.DisplayModelHint</div>
                                        </div>
                                    </div>
                                    <div class="provider-score">
                                        <span class="score-value @ScoreTone(provider)">@provider.RoutingScore.ToString("0.#")</span>
                                        <span class="score-label">score</span>
                                    </div>
                                </div>
                                <div class="dev-chipline compact">
                                    <span class="dev-pill @ToolTone(provider)">@ToolStatusText(provider)</span>
                                    <span class="dev-pill @AuthTone(provider)">@(provider.IsAuthenticated ? "logged in" : "not logged in")</span>
                                    <span class="dev-pill @RoutingTone(provider)">@provider.RoutingStatus</span>
                                </div>
                                <div class="provider-windows">
                                    <ProviderWindowBar Window="provider.FiveHour" />
                                    <ProviderWindowBar Window="provider.TwentyFourHour" />
                                    <ProviderWindowBar Window="provider.Weekly" />
                                    <ProviderWindowBar Window="provider.Monthly" />
                                </div>
                                <div class="provider-card-foot">
                                    <span class="provider-checked">@FormatRelative(provider.LastCheckedAt)</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <aside class="dev-inspector provider-inspector">
                    @if (_selectedProvider is null)
                    {
                        <div class="dev-empty">Select a provider to view details</div>
                    }
                    else
                    {
                        <div class="dev-inspector-head">
                            <div class="type-row">
                                <span class="dev-pill @ToolTone(_selectedProvider)">@ToolStatusText(_selectedProvider)</span>
                                <span class="dev-pill @AuthTone(_selectedProvider)">@(_selectedProvider.IsAuthenticated ? "logged in" : "not logged in")</span>
                                <span class="asset-id">@_selectedProvider.ProviderId</span>
                            </div>
                            <div class="value-big">@_selectedProvider.ProviderName</div>
                            <div class="submeta">@_selectedProvider.DisplayModelHint</div>
                        </div>
                        <div class="dev-inspector-body">
                            <table class="kv-table">
                                <tbody>
                                    <tr><td>Routing Score</td><td><span class="dev-pill @RoutingTone(_selectedProvider)">@_selectedProvider.RoutingScore.ToString("0.#")</span></td></tr>
                                    <tr><td>Routing Status</td><td>@_selectedProvider.RoutingStatus</td></tr>
                                    <tr><td>Tool</td><td class="mono">@_selectedProvider.ToolStatus.Executable</td></tr>
                                    <tr><td>Tool Status</td><td>@ToolStatusLine(_selectedProvider)</td></tr>
                                    <tr><td>Version</td><td class="mono">@(_selectedProvider.ToolStatus.Version ?? "—")</td></tr>
                                    <tr><td>Auth Status</td><td>@_selectedProvider.AuthStatus</td></tr>
                                    <tr><td>Last Checked</td><td>@FormatRelative(_selectedProvider.LastCheckedAt)</td></tr>
                                </tbody>
                            </table>

                            @if (_selectedProvider.FiveHour.IsKnown || _selectedProvider.TwentyFourHour.IsKnown || _selectedProvider.Weekly.IsKnown || _selectedProvider.Monthly.IsKnown)
                            {
                                <div class="section-label">USAGE WINDOWS</div>
                                <div class="usage-window-stack">
                                    <UsageWindow Window="_selectedProvider.FiveHour" />
                                    <UsageWindow Window="_selectedProvider.TwentyFourHour" />
                                    <UsageWindow Window="_selectedProvider.Weekly" />
                                    <UsageWindow Window="_selectedProvider.Monthly" />
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(_selectedProvider.LastError) && _selectedProvider.ToolStatus.IsAvailable)
                            {
                                <div class="dev-error" style="margin-top: 8px;">@_selectedProvider.LastError</div>
                            }

                            @if (!_selectedProvider.IsAuthenticated)
                            {
                                <div class="section-label">LOGIN COMMAND</div>
                                <div class="provider-command-box">
                                    <div class="provider-command mono">@_selectedProvider.LoginCommand</div>
                                    <div class="provider-login-help">@_selectedProvider.LoginInstructions</div>
                                </div>
                            }

                            @if (!_selectedProvider.IsAuthenticated)
                            {
                                <div class="dev-action-row">
                                    <button class="btn primary tiny" @onclick="() => Login(_selectedProvider)" disabled="@(_loggingIn || _loading)">Login / Recheck</button>
                                </div>
                            }
                        </div>
                    }
                </aside>
            </div>
        }
    </div>
</div>
</ErrorBoundary>

@code {
    private ProviderUsageOverviewDto? _overview;
    private ProviderRouteSelectionDto? _routing;
    private ProviderUsageDto? _selectedProvider;
    private bool _loading;
    private bool _loggingIn;
    private string? _error;
    private string? _notice;

    private IReadOnlyList<ProviderUsageDto> Providers => _overview?.Providers ?? [];

    private string RouteLabel =>
        _routing?.ProviderName
        ?? _overview?.RecommendedRoute?.ProviderName
        ?? "—";

    protected override Task OnInitializedAsync()
    {
        Realtime.Changed += OnDevelopmentDataChanged;
        _ = Realtime.StartAsync();
        _ = InvokeAsync(() => LoadAsync());
        return Task.CompletedTask;
    }

    private async Task LoadAsync(bool showLoading = true)
    {
        _loading = showLoading && _overview is null && _routing is null;
        _error = null;
        _notice = null;
        StateHasChanged();
        try
        {
            await Task.WhenAll(LoadOverviewAsync(), LoadRoutingAsync());
        }
        catch (Exception ex)
        {
            _error = $"Unable to load provider usage: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadOverviewAsync()
    {
        _overview = await GetJsonAsync<ProviderUsageOverviewDto>(Ui("/ui/provider-usage"), "provider usage")
            ?? new ProviderUsageOverviewDto(DateTimeOffset.UtcNow, [], null);
        if (_selectedProvider is not null)
        {
            _selectedProvider = _overview.Providers.FirstOrDefault(p => p.ProviderId == _selectedProvider.ProviderId);
        }
        StateHasChanged();
    }

    private async Task LoadRoutingAsync()
    {
        _routing = await GetJsonAsync<ProviderRouteSelectionDto>(Ui("/ui/provider-usage/routing-preview"), "routing preview");
        StateHasChanged();
    }

    private Task OnDevelopmentDataChanged(DevelopmentDataChangedEvent change)
    {
        if (change.Area is "provider-usage" or "agents" or "agent-tasks")
        {
            return InvokeAsync(() => LoadAsync(showLoading: false));
        }

        return Task.CompletedTask;
    }

    public ValueTask DisposeAsync()
    {
        Realtime.Changed -= OnDevelopmentDataChanged;
        return ValueTask.CompletedTask;
    }

    private async Task Login(ProviderUsageDto provider)
    {
        _loggingIn = true;
        _error = null;
        _notice = null;
        try
        {
            var response = await Http.PostAsync(Ui($"/ui/provider-usage/{provider.ProviderId}/login"), null);
            if (!response.IsSuccessStatusCode)
            {
                _error = $"{provider.ProviderName} login failed with status {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
                return;
            }

            var login = await ReadJsonContentAsync<ProviderLoginResponseDto>(response, $"{provider.ProviderName} login");
            await LoadAsync();
            _notice = FormatLoginNotice(login);
        }
        catch (Exception ex)
        {
            _error = $"Unable to run {provider.ProviderName} login command: {ex.Message}";
        }
        finally
        {
            _loggingIn = false;
        }
    }

    private void SelectProvider(ProviderUsageDto provider)
    {
        _selectedProvider = _selectedProvider?.ProviderId == provider.ProviderId ? null : provider;
    }

    private string Ui(string path) => Nav.ToAbsoluteUri(path).ToString();

    private async Task<T?> GetJsonAsync<T>(string url, string label)
    {
        using var response = await Http.GetAsync(url);
        if (!response.IsSuccessStatusCode)
        {
            var body = await response.Content.ReadAsStringAsync();
            throw new InvalidOperationException($"{label} returned {(int)response.StatusCode}: {TrimBody(body)}");
        }

        return await ReadJsonContentAsync<T>(response, label);
    }

    private static async Task<T?> ReadJsonContentAsync<T>(HttpResponseMessage response, string label)
    {
        var mediaType = response.Content.Headers.ContentType?.MediaType ?? string.Empty;
        if (!mediaType.Contains("json", StringComparison.OrdinalIgnoreCase))
        {
            var body = await response.Content.ReadAsStringAsync();
            var contentType = string.IsNullOrWhiteSpace(mediaType) ? "unknown content type" : mediaType;
            throw new InvalidOperationException($"{label} returned {contentType}: {TrimBody(body)}");
        }

        return await response.Content.ReadFromJsonAsync<T>();
    }

    private static string TrimBody(string value)
    {
        value = value.ReplaceLineEndings(" ").Trim();
        return value.Length <= 180 ? value : value[..180] + "...";
    }

    private static string FormatLoginNotice(ProviderLoginResponseDto? login)
    {
        if (login is null)
        {
            return "Login command completed, but no response body was returned.";
        }

        var output = string.IsNullOrWhiteSpace(login.Output) ? string.Empty : $"\n\nOUTPUT\n{login.Output}";
        var error = string.IsNullOrWhiteSpace(login.Error) ? string.Empty : $"\n\nERROR\n{login.Error}";
        return $"{login.ProviderName}: {login.Message}\nCommand: {login.Command}{output}{error}";
    }

    private bool IsSelected(ProviderUsageDto provider) =>
        _selectedProvider?.ProviderId == provider.ProviderId;

    private static string ProviderDot(ProviderUsageDto provider)
    {
        if (!provider.ToolStatus.IsAvailable) return "red";
        if (!provider.IsAuthenticated) return "amber";
        return provider.RoutingScore > 0 ? "green" : "red";
    }

    private static string ScoreTone(ProviderUsageDto provider) => provider.RoutingScore switch
    {
        <= 0 => "tone-red",
        < 20 => "tone-amber",
        _ => "tone-green"
    };

    private static string ToolTone(ProviderUsageDto provider) => provider.ToolStatus.IsAvailable ? "green" : "red";

    private static string AuthTone(ProviderUsageDto provider)
    {
        if (!provider.ToolStatus.IsAvailable) return "dim";
        if (provider.IsAuthenticated) return "green";
        if (!string.IsNullOrWhiteSpace(provider.LastError)) return "red";
        return "dim";
    }

    private static string RoutingTone(ProviderUsageDto provider) => provider.RoutingScore switch
    {
        <= 0 => "red",
        < 20 => "amber",
        _ => "green"
    };

    private static string ToolStatusText(ProviderUsageDto provider) =>
        provider.ToolStatus.IsAvailable ? "tool ready" : "tool missing";

    private static string ToolStatusLine(ProviderUsageDto provider)
    {
        if (provider.ToolStatus.IsAvailable) return $"{provider.ToolStatus.Executable} available";
        return string.IsNullOrWhiteSpace(provider.ToolStatus.Error)
            ? $"{provider.ToolStatus.Executable} missing"
            : provider.ToolStatus.Error;
    }

    private static string FormatRelative(DateTimeOffset? value)
    {
        if (value is null) return "never";
        var diff = DateTimeOffset.UtcNow - value.Value;
        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }

    private int LoggedInCount => _overview?.Providers.Count(p => p.IsAuthenticated) ?? 0;
    private int CliToolsCount => _overview?.Providers.Count(p => p.ToolStatus.IsAvailable) ?? 0;
}
