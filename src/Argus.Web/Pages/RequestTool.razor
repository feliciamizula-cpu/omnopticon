    private static string StatusRowClass(int? code) => code switch
    {
        >= 200 and < 300 => "fuzz-row-success",
        >= 300 and < 400 => "fuzz-row-redirect",
        >= 400 and < 500 => "fuzz-row-client-error",
        >= 500 => "fuzz-row-server-error",
        _ => ""
    };

    private static string StatusClass(int? code) => code switch
    {
        >= 200 and < 300 => "status-ok",
        >= 300 and < 400 => "status-redirect",
        >= 400 => "status-error",
        _ => ""
    };

    private static string Truncate(string s, int max) =>
        s.Length <= max ? s : s[..max] + "…";

