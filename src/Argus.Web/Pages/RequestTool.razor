    private sealed class FuzzVarState
    {
        public string Name { get; set; } = "";
        public string SourceType { get; set; } = "List";
        public string ListText { get; set; } = "";
        public long CounterStart { get; set; }
        public long CounterEnd { get; set; } = 100;
        public long CounterStep { get; set; } = 1;
        public int CounterPad { get; set; }
        public string BuiltInName { get; set; } = "";
        public List<TransformState> Transforms { get; set; } = [];
        public List<string> PreviewValues { get; set; } = [];

        public int PayloadCount => SourceType switch
        {
            "List" => ListText.Split('\n', StringSplitOptions.RemoveEmptyEntries).Length,
            "Counter" => (int)Math.Max(0, (CounterEnd - CounterStart) / Math.Max(1, CounterStep)) + 1,
            "BuiltIn" => 1,  // unknown until fetched
            _ => 0
        };

        public void RefreshPreview()
        {
            var samples = SourceType switch
            {
                "List" => ListText.Split('\n', StringSplitOptions.RemoveEmptyEntries).Take(5).ToList(),
                "Counter" => Enumerable.Range(0, 5)
                    .Select(i => CounterPad > 0
                        ? (CounterStart + i * CounterStep).ToString().PadLeft(CounterPad, '0')
                        : (CounterStart + i * CounterStep).ToString())
                    .ToList(),
                "BuiltIn" => ["(from built-in list)"],
                _ => new List<string>()
            };
            PreviewValues = samples.Select(v => Transforms.Aggregate(v, ApplyTransform)).ToList();
        }

        private static string ApplyTransform(string v, TransformState t) => t.Type switch
        {
            "Uppercase"    => v.ToUpperInvariant(),
            "Lowercase"    => v.ToLowerInvariant(),
            "Trim"         => v.Trim(),
            "Reverse"      => new string(v.Reverse().ToArray()),
            "Base64Encode" => Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(v)),
            "UrlEncode"    => Uri.EscapeDataString(v),
            "Prefix"       => (t.Value ?? "") + v,
            "Suffix"       => v + (t.Value ?? ""),
            _              => v
        };

        public object BuildSource() => SourceType switch
        {
            "Counter" => new
            {
                sourceType = "Counter",
                counterStart = CounterStart,
                counterEnd = CounterEnd,
                counterStep = CounterStep,
                counterPadding = CounterPad,
                transformations = Transforms.Select(t => new { type = t.Type, value = t.Value }).ToList()
            },
            "BuiltIn" => new
            {
                sourceType = "BuiltIn",
                builtInName = BuiltInName,
                transformations = Transforms.Select(t => new { type = t.Type, value = t.Value }).ToList()
            },
            _ => new
            {
                sourceType = "List",
                values = ListText.Split('\n', StringSplitOptions.RemoveEmptyEntries).ToList(),
                transformations = Transforms.Select(t => new { type = t.Type, value = t.Value }).ToList()
            }
        };
    }

    private sealed class TransformState
    {
        public string Type { get; set; } = "";
        public string? Value { get; set; }
    }

    private sealed class ExtractPatternState
    {
        public string Name { get; set; } = "";
        public string Regex { get; set; } = "";
    }
