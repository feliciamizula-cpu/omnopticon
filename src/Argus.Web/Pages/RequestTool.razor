@page "/request-tool/{AssetId:guid}"
@inject HttpClient Http
@inject NavigationManager Navigation
@using System.Text.RegularExpressions
@implements IAsyncDisposable

<PageTitle>HTTP Request Tool - Argus</PageTitle>

<div class="request-tool-page">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="app-loading-spinner"></div>
            <p>Loading request tool...</p>
        </div>
    }
    else if (_error is not null)
    {
        <div class="error-state">
            <div class="error-icon">!</div>
            <h3>Failed to load</h3>
            <p>@_error</p>
            <button class="btn btn-primary" @onclick="LoadSession">Retry</button>
        </div>
    }
    else if (_session is not null)
    {
        <div class="request-tool-header">
            <div class="header-info">
                <h2>Request Tool</h2>
                <span class="asset-info">Asset: @_session.AssetId</span>
            </div>
            <div class="header-actions">
                <button class="btn btn-sm" @onclick="CloneSelected" disabled="@(_selectedExchangeId is null)">Clone</button>
                <button class="btn btn-sm" @onclick="ShowCompareDialog">Compare</button>
            </div>
        </div>

        <div class="request-tool-tabs">
            @foreach (var exchange in _session.Exchanges)
            {
                <div class="tab @(exchange.ExchangeId == _selectedExchangeId && !_fuzzMode ? "active" : "")"
                     @onclick="() => SwitchToExchange(exchange.ExchangeId)">
                    <span class="tab-title">@exchange.TabTitle</span>
                    @if (exchange.Origin == "OriginalEvidence")
                    {
                        <span class="tab-badge origin">Original</span>
                    }
                    else if (exchange.Outcome == "NetworkError")
                    {
                        <span class="tab-badge failed">Failed</span>
                    }
                    @if (exchange.IsPinned)
                    {
                        <span class="tab-pin">*</span>
                    }
                </div>
            }
            <button class="btn btn-sm btn-ghost tab-add" @onclick="CreateNewTab">+ New</button>
            <div style="flex:1"></div>
            <button class="btn btn-sm @(_fuzzMode ? "btn-primary" : "btn-ghost") tab-add"
                    @onclick="ToggleFuzzMode" title="Intruder — fuzz this request with variable payloads">
                ⚡ Intruder
            </button>
        </div>

        @* ── Intruder / Fuzz mode ── *@
        @if (_fuzzMode)
        {
        <div class="fuzz-layout">

          @* ─ Request template editor (shows §var§ markers) ─ *@
          <div class="fuzz-template-pane">
            <div class="pane-header">
              <h3>Request Template</h3>
              <span style="font-size:11px;color:#aaa;">Mark variables with §name§ syntax.
                Select text then press the button to wrap it.</span>
              <button class="btn btn-sm" @onclick="WrapSelectionAsVariable">Wrap § §</button>
            </div>
            <div class="form-row" style="margin-bottom:6px">
              <select class="input method-select" @bind="_draft.Method">
                <option>GET</option><option>POST</option><option>PUT</option>
                <option>PATCH</option><option>DELETE</option><option>HEAD</option>
              </select>
              <input type="text" class="input url-input" @bind="_draft.Url"
                     placeholder="https://example.com/§path§?id=§id§" />
            </div>
            <div class="form-section">
              <h4>Headers</h4>
              @foreach (var h in _draft.Headers)
              {
                <div class="header-row">
                  <input type="checkbox" @bind="h.Enabled" />
                  <input type="text" class="input" @bind="h.Name" placeholder="Header" />
                  <input type="text" class="input" @bind="h.Value" placeholder="Value — use §var§ here" />
                  <button class="btn btn-icon btn-ghost" @onclick="() => RemoveHeader(h)">x</button>
                </div>
              }
              <button class="btn btn-sm" @onclick="AddHeader">Add Header</button>
            </div>
            <div class="form-section">
              <h4>Body</h4>
              <textarea class="input body-textarea" @bind="_draft.Body"
                        placeholder='{"user":"§user§","pass":"§pass§"}'></textarea>
            </div>

            @* Detected variables *@
            <div class="fuzz-variables-section">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                <h4 style="margin:0">Variables</h4>
                <button class="btn btn-sm" @onclick="DetectVariables">Detect §vars§</button>
              </div>
              @if (_fuzzVariables.Count == 0)
              {
                <p style="color:#888;font-size:12px">No variables detected. Mark positions with §name§ then click Detect.</p>
              }
              else
              {
                @foreach (var v in _fuzzVariables)
                {
                  <div class="fuzz-var-row">
                    <span class="fuzz-var-name">§@v.Name§</span>
                    <span class="fuzz-var-count">@(v.PayloadCount) payloads</span>
                    <button class="btn btn-sm" @onclick="() => OpenVarConfig(v)">Configure</button>
                  </div>
                }
              }
            </div>
          </div>

          @* ─ Attack settings + results ─ *@
          <div class="fuzz-right-pane">
            <div class="fuzz-settings">
              <div class="fuzz-settings-row">
                <label>Attack type</label>
                <select class="input" @bind="_fuzzAttackType">
                  <option value="Pitchfork">Pitchfork (parallel, same index)</option>
                  <option value="ClusterBomb">Cluster Bomb (all permutations)</option>
                </select>
              </div>
              <div class="fuzz-settings-row">
                <label>Throttle (ms)</label>
                <input type="number" class="input" @bind="_fuzzThrottleMs" min="0" max="60000" style="width:90px" />
              </div>
              <div class="fuzz-settings-row">
                <label>Concurrency</label>
                <input type="number" class="input" @bind="_fuzzMaxConcurrent" min="1" max="50" style="width:70px" />
              </div>
              <div class="fuzz-settings-row">
                <label>Max requests</label>
                <input type="number" class="input" @bind="_fuzzMaxRequests" min="1" max="10000" style="width:80px" />
              </div>

              @* Extract patterns *@
              <div style="margin-top:12px">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
                  <h4 style="margin:0;font-size:12px">Extract Patterns</h4>
                  <button class="btn btn-sm" @onclick="AddExtractPattern">+ Add Column</button>
                </div>
                @foreach (var ep in _extractPatterns)
                {
                  <div class="header-row" style="margin-bottom:4px">
                    <input type="text" class="input" @bind="ep.Name" placeholder="Column name" style="width:100px" />
                    <input type="text" class="input" @bind="ep.Regex" placeholder="Regex pattern (group 1 = extracted)" />
                    <button class="btn btn-icon btn-ghost" @onclick="() => _extractPatterns.Remove(ep)">x</button>
                  </div>
                }
              </div>

              <div style="margin-top:12px;display:flex;gap:8px;align-items:center">
                @if (_currentRun is null || _currentRun.Status is "Completed" or "Stopped" or "Error")
                {
                  <button class="btn btn-primary" @onclick="StartAttack" disabled="@(_fuzzVariables.Count == 0)">
                    ▶ Start Attack
                  </button>
                }
                else
                {
                  <button class="btn btn-danger" @onclick="StopAttack">■ Stop</button>
                  <span style="font-size:12px;color:#aaa">
                    @_currentRun.CompletedCount / @_currentRun.TotalCount
                  </span>
                }
                @if (_fuzzError is not null)
                {
                  <span style="color:#f87272;font-size:12px">@_fuzzError</span>
                }
              </div>
            </div>

            @* ─ Results grid ─ *@
            @if (_fuzzResults.Count > 0 || _currentRun is not null)
            {
              <div class="fuzz-results-header">
                <span>Results
                  @if (_currentRun is not null)
                  {
                    <span style="font-size:11px;color:#aaa;margin-left:6px">
                      [@_currentRun.Status] @_currentRun.CompletedCount / @_currentRun.TotalCount
                    </span>
                  }
                </span>
                <button class="btn btn-sm btn-ghost" @onclick="ClearResults">Clear</button>
              </div>
              <div class="fuzz-results-table-wrap">
                <table class="fuzz-results-table">
                  <thead>
                    <tr>
                      <th>#</th>
                      @foreach (var v in _fuzzVariables)
                      {
                        <th>§@v.Name§</th>
                      }
                      <th>Status</th>
                      <th>Size</th>
                      <th>ms</th>
                      @foreach (var ep in _extractPatterns.Where(e => !string.IsNullOrWhiteSpace(e.Name)))
                      {
                        <th>@ep.Name</th>
                      }
                      <th>Error</th>
                    </tr>
                  </thead>
                  <tbody>
                    @foreach (var r in _fuzzResults.OrderBy(x => x.SequenceNumber))
                    {
                      <tr class="@StatusRowClass(r.StatusCode)" @onclick="() => ExpandFuzzResult(r)">
                        <td>@r.SequenceNumber</td>
                        @foreach (var v in _fuzzVariables)
                        {
                          <td class="fuzz-payload-cell">@(r.PayloadValues.TryGetValue(v.Name, out var pv) ? Truncate(pv, 30) : "")</td>
                        }
                        <td class="@StatusClass(r.StatusCode)">@(r.StatusCode?.ToString() ?? "—")</td>
                        <td>@(r.ResponseSizeBytes.HasValue ? FormatSize(r.ResponseSizeBytes.Value) : "—")</td>
                        <td>@(r.DurationMs?.ToString() ?? "—")</td>
                        @foreach (var ep in _extractPatterns.Where(e => !string.IsNullOrWhiteSpace(e.Name)))
                        {
                          <td>@(r.ExtractValues.TryGetValue(ep.Name, out var ev) ? Truncate(ev, 40) : "")</td>
                        }
                        <td class="fuzz-error-cell">@(r.NetworkError is not null ? Truncate(r.NetworkError, 40) : "")</td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>
            }
          </div>
        </div>

        @* ── Variable config modal ── *@
        @if (_configureVar is not null)
        {
        <div class="modal-overlay" @onclick="CloseVarConfig">
          <div class="modal modal-lg" @onclick:stopPropagation style="max-width:720px;width:95vw">
            <div class="modal-header">
              <h3>Configure §@_configureVar.Name§</h3>
              <button class="btn btn-icon btn-ghost" @onclick="CloseVarConfig">x</button>
            </div>
            <div class="modal-body">
              <div class="fuzz-settings-row" style="margin-bottom:12px">
                <label>Source type</label>
                <select class="input" @bind="_configureVar.SourceType">
                  <option value="List">List (paste values)</option>
                  <option value="Counter">Counter (number range)</option>
                  <option value="BuiltIn">Built-in list</option>
                  <option value="File">Upload file</option>
                </select>
              </div>

              @if (_configureVar.SourceType == "List")
              {
                <div class="form-section">
                  <h4>Payload values (one per line)</h4>
                  <textarea class="input body-textarea" rows="10" @bind="_configureVar.ListText"
                            placeholder="admin&#10;root&#10;test&#10;..."></textarea>
                  <span style="font-size:11px;color:#aaa">@_configureVar.PayloadCount payloads</span>
                </div>
              }
              else if (_configureVar.SourceType == "Counter")
              {
                <div class="form-row">
                  <label>Start</label><input type="number" class="input" @bind="_configureVar.CounterStart" style="width:80px" />
                  <label>End</label><input type="number" class="input" @bind="_configureVar.CounterEnd" style="width:80px" />
                  <label>Step</label><input type="number" class="input" @bind="_configureVar.CounterStep" style="width:80px" />
                  <label>Pad width</label><input type="number" class="input" @bind="_configureVar.CounterPad" min="0" max="20" style="width:70px" />
                </div>
              }
              else if (_configureVar.SourceType == "BuiltIn")
              {
                <div class="form-section">
                  <h4>Select built-in list</h4>
                  <select class="input" @bind="_configureVar.BuiltInName">
                    @foreach (var name in _builtInNames)
                    {
                      <option value="@name">@name</option>
                    }
                  </select>
                </div>
              }
              else if (_configureVar.SourceType == "File")
              {
                <div class="form-section">
                  <h4>Upload wordlist file (.txt, one value per line)</h4>
                  <InputFile OnChange="HandleFileUpload" accept=".txt,text/plain" />
                  @if (_configureVar.PayloadCount > 0)
                  {
                    <span style="font-size:11px;color:#aaa;margin-top:6px;display:block">
                      @_configureVar.PayloadCount payloads loaded
                    </span>
                  }
                </div>
              }

              @* Transformations *@
              <div style="margin-top:16px">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                  <h4 style="margin:0">Transformation Chain</h4>
                  <select class="input" @bind="_addTransformType" style="width:160px">
                    <option value="">+ Add transform</option>
                    <option value="Uppercase">Uppercase</option>
                    <option value="Lowercase">Lowercase</option>
                    <option value="Base64Encode">Base64 Encode</option>
                    <option value="Base64Decode">Base64 Decode</option>
                    <option value="UrlEncode">URL Encode</option>
                    <option value="UrlDecode">URL Decode</option>
                    <option value="HtmlEncode">HTML Encode</option>
                    <option value="HtmlDecode">HTML Decode</option>
                    <option value="Md5">MD5</option>
                    <option value="Sha1">SHA-1</option>
                    <option value="Reverse">Reverse</option>
                    <option value="Trim">Trim whitespace</option>
                    <option value="Prefix">Prefix string</option>
                    <option value="Suffix">Suffix string</option>
                    <option value="RegexExtract">Regex Extract</option>
                  </select>
                  <button class="btn btn-sm" @onclick="AddTransform">Add</button>
                </div>
                @foreach (var (t, ti) in _configureVar.Transforms.Select((x, i) => (x, i)))
                {
                  <div class="header-row" style="margin-bottom:4px">
                    <span class="badge" style="min-width:120px">@t.Type</span>
                    @if (t.Type is "Prefix" or "Suffix" or "RegexExtract")
                    {
                      <input type="text" class="input" @bind="t.Value" placeholder="@(t.Type == "RegexExtract" ? "regex pattern" : "string value")" />
                    }
                    <button class="btn btn-icon btn-ghost" @onclick="() => RemoveTransform(ti)">x</button>
                  </div>
                }
                @if (_configureVar.Transforms.Count == 0)
                {
                  <span style="font-size:11px;color:#aaa">No transforms applied. Values used as-is.</span>
                }
              </div>

              @* Live preview *@
              <div style="margin-top:14px">
                <h4>Preview (first 5 values after transforms)</h4>
                <div class="body-preview" style="font-size:11px;max-height:100px;overflow:auto">
                  @foreach (var p in _configureVar.PreviewValues)
                  {
                    <div>@p</div>
                  }
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <button class="btn" @onclick="SaveVarConfig">Save</button>
              <button class="btn btn-ghost" @onclick="CloseVarConfig">Cancel</button>
            </div>
          </div>
        </div>
        }
        }
        else
        {

        <div class="request-tool-content">
            <div class="request-pane">
                <div class="pane-header">
                    <h3>Request</h3>
                </div>
                <div class="request-form">
                    <div class="form-row">
                        <select class="input method-select" @bind="_draft.Method">
                            <option value="GET">GET</option>
                            <option value="POST">POST</option>
                            <option value="PUT">PUT</option>
                            <option value="PATCH">PATCH</option>
                            <option value="DELETE">DELETE</option>
                            <option value="HEAD">HEAD</option>
                            <option value="OPTIONS">OPTIONS</option>
                        </select>
                        <input type="text" class="input url-input" @bind="_draft.Url" placeholder="https://example.com/path" />
                        <button class="btn btn-primary" @onclick="SendRequest" disabled="@_sending">
                            @if (_sending)
                            {
                                <span>Sending...</span>
                            }
                            else
                            {
                                <span>Send</span>
                            }
                        </button>
                    </div>

                    <div class="form-section">
                        <h4>Headers</h4>
                        <div class="headers-list">
                            @foreach (var header in _draft.Headers)
                            {
                                <div class="header-row">
                                    <input type="checkbox" @bind="header.Enabled" />
                                    <input type="text" class="input" @bind="header.Name" placeholder="Header Name" />
                                    <input type="text" class="input" @bind="header.Value" placeholder="Value" />
                                    <button class="btn btn-icon btn-ghost" @onclick="() => RemoveHeader(header)">x</button>
                                </div>
                            }
                            <button class="btn btn-sm" @onclick="AddHeader">Add Header</button>
                        </div>
                    </div>

                    <div class="form-section">
                        <h4>Body</h4>
                        <textarea class="input body-textarea" @bind="_draft.Body" placeholder="Request body..."></textarea>
                        <div class="form-row">
                            <input type="text" class="input" @bind="_draft.ContentType" placeholder="Content-Type" style="width: 200px;" />
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="_draft.FollowRedirects" />
                                Follow Redirects
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="response-pane">
                <div class="pane-header">
                    <h3>Response</h3>
                    @if (_response is not null)
                    {
                        <div class="response-meta">
                            <span class="status-badge status-@(_response.ResponseStatusCode >= 200 && _response.ResponseStatusCode < 300 ? "success" : "error")">
                                @_response.ResponseStatusCode @_response.ResponseReasonPhrase
                            </span>
                            <span class="meta-item">@(_response.DurationMs ?? 0)ms</span>
                            <span class="meta-item">@FormatSize(_response.ResponseBodySizeBytes ?? 0)</span>
                        </div>
                    }
                </div>
                @if (_response is not null)
                {
                    <div class="response-content">
                        <div class="form-section">
                            <h4>Response Headers</h4>
                            <div class="headers-list">
                                @if (_response.ResponseHeaders is not null)
                                {
                                    @foreach (var header in _response.ResponseHeaders)
                                    {
                                        <div class="header-row readonly">
                                            <span class="header-name">@header.Key:</span>
                                            <span class="header-value">@string.Join(", ", header.Value)</span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                        <div class="form-section">
                            <h4>Response Body</h4>
                            <pre class="body-preview">@_response.ResponseBody</pre>
                        </div>
                    </div>
                }
                else if (_sending)
                {
                    <div class="loading-state">
                        <div class="app-loading-spinner"></div>
                        <p>Sending request...</p>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <p>Send a request to see the response</p>
                    </div>
                }
            </div>
        </div>
        } @* end else (non-fuzz mode) *@
    }
</div>

@if (_showCompareDialog)
{
    <div class="modal-overlay" @onclick="CloseCompareDialog">
        <div class="modal modal-lg" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Compare Exchanges</h3>
                <button class="btn btn-icon btn-ghost" @onclick="CloseCompareDialog">x</button>
            </div>
            <div class="modal-body">
                <div class="compare-result">
                    <p>Select two exchanges to compare using the API.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn" @onclick="CloseCompareDialog">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid AssetId { get; set; }

    private bool _loading = true;
    private string? _error;
    private RequestToolSessionDto? _session;
    private HttpExchangeDetailDto? _response;
    private Guid? _selectedExchangeId;
    private bool _sending;
    private bool _showCompareDialog;
    private RequestDraft _draft = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSession();
    }

    private async Task LoadSession()
    {
        _loading = true;
        _error = null;
        try
        {
            var response = await Http.PostAsJsonAsync($"/ui/request-tool/assets/{AssetId}/session", new { assetId = AssetId });
            if (response.IsSuccessStatusCode)
            {
                _session = await response.Content.ReadFromJsonAsync<RequestToolSessionDto>();
                if (_session?.Exchanges.Count > 0)
                {
                    await SelectExchange(_session.Exchanges.First().ExchangeId);
                }
            }
            else
            {
                _error = $"Failed to load session: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _error = $"Error loading session: {ex.Message}";
        }
        _loading = false;
    }

    private async Task SelectExchange(Guid exchangeId)
    {
        _selectedExchangeId = exchangeId;
        try
        {
            var response = await Http.GetAsync($"/ui/request-tool/exchanges/{exchangeId}");
            if (response.IsSuccessStatusCode)
            {
                _response = await response.Content.ReadFromJsonAsync<HttpExchangeDetailDto>();
                LoadExchangeIntoDraft(_response);
            }
        }
        catch { }
    }

    private void LoadExchangeIntoDraft(HttpExchangeDetailDto? exchange)
    {
        if (exchange is null) return;

        _draft = new RequestDraft
        {
            Method = exchange.RequestMethod,
            Url = exchange.RequestUrl,
            Body = exchange.RequestBody ?? "",
            ContentType = exchange.RequestContentType ?? "",
            FollowRedirects = true,
            Headers = exchange.RequestHeaders.Select(h => new HeaderItem
            {
                Name = h.Key,
                Value = string.Join(", ", h.Value),
                Enabled = true
            }).ToList()
        };
    }

    private async Task SendRequest()
    {
        if (_session is null) return;

        _sending = true;
        try
        {
            var request = new
            {
                parentExchangeId = _selectedExchangeId,
                method = _draft.Method,
                url = _draft.Url,
                headers = _draft.Headers.Where(h => h.Enabled && !string.IsNullOrWhiteSpace(h.Name))
                    .ToDictionary(h => h.Name, h => new[] { h.Value }),
                cookies = new Dictionary<string, string>(),
                body = _draft.Body,
                contentType = _draft.ContentType,
                followRedirects = _draft.FollowRedirects,
                tabTitle = $"{_draft.Method} {_draft.Url}"
            };

            var response = await Http.PostAsJsonAsync($"/ui/request-tool/sessions/{_session.SessionId}/send", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<HttpExchangeDetailDto>();
                // Reload so the new exchange shows up as its own tab, then focus that tab.
                await LoadSession();
                if (result is not null)
                {
                    await SelectExchange(result.ExchangeId);
                }
            }
        }
        catch { }
        _sending = false;
    }

    private void CloneSelected()
    {
        if (_response is not null)
        {
            LoadExchangeIntoDraft(_response);
        }
    }

    private void ShowCompareDialog()
    {
        _showCompareDialog = true;
    }

    private void CloseCompareDialog()
    {
        _showCompareDialog = false;
    }

    private void CreateNewTab()
    {
        _draft = new RequestDraft();
        _response = null;
        _selectedExchangeId = null;
    }

    private void AddHeader()
    {
        _draft.Headers.Add(new HeaderItem { Enabled = true });
    }

    private void RemoveHeader(HeaderItem header)
    {
        _draft.Headers.Remove(header);
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private class RequestToolSessionDto
    {
        public Guid SessionId { get; set; }
        public Guid AssetId { get; set; }
        public Guid ProgramId { get; set; }
        public string Title { get; set; } = "";
        public List<HttpExchangeSummaryDto> Exchanges { get; set; } = new();
    }

    private class HttpExchangeSummaryDto
    {
        public Guid ExchangeId { get; set; }
        // Serialized as enum names by the service (e.g. "OriginalEvidence", "NetworkError").
        public string Origin { get; set; } = "";
        public string Outcome { get; set; } = "";
        public string TabTitle { get; set; } = "";
        public bool IsPinned { get; set; }
        public string RequestMethod { get; set; } = "";
        public string RequestUrl { get; set; } = "";
    }

    private class HttpExchangeDetailDto
    {
        public Guid ExchangeId { get; set; }
        public Guid SessionId { get; set; }
        public string Origin { get; set; } = "";
