    // ── Fuzz mode state ───────────────────────────────────────────────────────

    private bool _fuzzMode;
    private string _fuzzAttackType = "Pitchfork";
    private int _fuzzThrottleMs;
    private int _fuzzMaxConcurrent = 10;
    private int _fuzzMaxRequests = 1000;
    private string? _fuzzError;
    private FuzzRunStatusDto? _currentRun;
    private List<FuzzResultDto> _fuzzResults = [];
    private List<FuzzVarState> _fuzzVariables = [];
    private List<ExtractPatternState> _extractPatterns = [];
    private FuzzVarState? _configureVar;
    private string _addTransformType = "";
    private List<string> _builtInNames = [];
    private System.Threading.Timer? _pollTimer;

    private void ToggleFuzzMode()
    {
        _fuzzMode = !_fuzzMode;
        if (_fuzzMode && _fuzzVariables.Count == 0)
            DetectVariables();
        if (!_fuzzMode)
            StopPolling();
    }

    private void SwitchToExchange(Guid id)
    {
        _fuzzMode = false;
        StopPolling();
        _ = SelectExchange(id);
    }

    private void DetectVariables()
    {
        var allText = $"{_draft.Url} {_draft.Body} " +
            string.Join(" ", _draft.Headers.Select(h => $"{h.Name} {h.Value}"));
        var names = Regex.Matches(allText, @"§([^§]+)§")
            .Select(m => m.Groups[1].Value.Trim())
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct()
            .ToList();

        // Preserve existing configs; add new; remove stale
        var existing = _fuzzVariables.ToDictionary(v => v.Name);
        _fuzzVariables = names.Select(n =>
            existing.TryGetValue(n, out var s) ? s : new FuzzVarState { Name = n }).ToList();
    }

    private async Task OpenVarConfig(FuzzVarState v)
    {
        _configureVar = v;
        _addTransformType = "";
        if (_builtInNames.Count == 0)
        {
            try
            {
                _builtInNames = await Http.GetFromJsonAsync<List<string>>("/ui/request-tool/fuzz/built-ins") ?? [];
                if (_configureVar.BuiltInName == "" && _builtInNames.Count > 0)
                    _configureVar.BuiltInName = _builtInNames[0];
            }
            catch { }
        }
        _configureVar.RefreshPreview();
    }

    private void CloseVarConfig() => _configureVar = null;

    private void SaveVarConfig()
    {
        _configureVar?.RefreshPreview();
        _configureVar = null;
    }

    private void AddTransform()
    {
        if (_configureVar is null || string.IsNullOrEmpty(_addTransformType)) return;
        _configureVar.Transforms.Add(new TransformState { Type = _addTransformType });
        _addTransformType = "";
        _configureVar.RefreshPreview();
    }

    private void RemoveTransform(int i)
    {
        _configureVar?.Transforms.RemoveAt(i);
        _configureVar?.RefreshPreview();
    }

    private void AddExtractPattern() =>
        _extractPatterns.Add(new ExtractPatternState());

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        if (_configureVar is null) return;
        using var reader = new System.IO.StreamReader(e.File.OpenReadStream(maxAllowedSize: 10_000_000));
        var text = await reader.ReadToEndAsync();
        _configureVar.ListText = text;
        _configureVar.RefreshPreview();
    }

    private void WrapSelectionAsVariable()
    {
        // Without browser JS interop we can't get the actual selection; prompt for a name instead
        var name = $"var{_fuzzVariables.Count + 1}";
        _fuzzVariables.Add(new FuzzVarState { Name = name });
        // Hint: replace selected text in URL with §name§
        _draft.Url += $"§{name}§";
    }

    private async Task StartAttack()
    {
        if (_session is null || _fuzzVariables.Count == 0) return;
        _fuzzError = null;
        _fuzzResults.Clear();

        DetectVariables();
        if (_fuzzVariables.Any(v => v.PayloadCount == 0))
        {
            _fuzzError = "One or more variables have no payloads configured.";
            return;
        }

        // Find the template exchange (use the currently selected one, or first)
        var templateId = _selectedExchangeId ?? _session.Exchanges.FirstOrDefault()?.ExchangeId;
        if (templateId is null) { _fuzzError = "No exchange to use as template."; return; }

        var request = new
        {
            templateExchangeId = templateId,
            attackType = _fuzzAttackType,
            throttleMs = _fuzzThrottleMs,
            maxConcurrent = _fuzzMaxConcurrent,
            maxRequests = _fuzzMaxRequests,
            variables = _fuzzVariables.Select(v => new
            {
                name = v.Name,
                source = v.BuildSource()
            }).ToList(),
            extractPatterns = _extractPatterns
                .Where(e => !string.IsNullOrWhiteSpace(e.Name) && !string.IsNullOrWhiteSpace(e.Regex))
                .Select(e => new { name = e.Name, regex = e.Regex, captureGroup1 = true })
                .ToList()
        };

        try
        {
            using var resp = await Http.PostAsJsonAsync($"/ui/request-tool/sessions/{_session.SessionId}/fuzz/runs", request);
            if (!resp.IsSuccessStatusCode)
            {
                _fuzzError = $"Failed to start attack: {resp.StatusCode}";
                return;
            }
            _currentRun = await resp.Content.ReadFromJsonAsync<FuzzRunStatusDto>();
            StartPolling();
        }
        catch (Exception ex) { _fuzzError = ex.Message; }
    }

    private async Task StopAttack()
    {
        if (_currentRun is null) return;
        try { await Http.PostAsync($"/ui/request-tool/fuzz/runs/{_currentRun.RunId}/stop", null); }
        catch { }
        StopPolling();
    }

    private void StartPolling()
    {
        _pollTimer?.Dispose();
        _pollTimer = new System.Threading.Timer(async _ =>
        {
            await PollResultsAsync();
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopPolling()
    {
        _pollTimer?.Dispose();
        _pollTimer = null;
    }

    private async Task PollResultsAsync()
    {
        if (_currentRun is null) return;
        try
        {
            // Update run status
            var run = await Http.GetFromJsonAsync<FuzzRunStatusDto>($"/ui/request-tool/fuzz/runs/{_currentRun.RunId}");
            if (run is not null) _currentRun = run;

            // Fetch new results (offset = current known count)
            var page = await Http.GetFromJsonAsync<FuzzResultsPageDto>(
                $"/ui/request-tool/fuzz/runs/{_currentRun.RunId}/results?offset={_fuzzResults.Count}&limit=200");

            if (page?.Results is { Count: > 0 })
                _fuzzResults.AddRange(page.Results);

            await InvokeAsync(StateHasChanged);

            if (_currentRun.Status is "Completed" or "Stopped" or "Error")
                StopPolling();
        }
        catch { }
    }

    private void ClearResults()
    {
        _fuzzResults.Clear();
        _currentRun = null;
        StopPolling();
    }

