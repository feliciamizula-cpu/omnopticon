    async Task OpenRequestTool(Guid assetId)
    {
        Navigation.NavigateTo($"/request-tool/{assetId}");
        await Task.CompletedTask;
    }

    async Task DeleteAssetAsync(AssetItem a)
    {
        try
        {
            var request = new { assetIds = new[] { a.AssetId }, action = "archive" };
            using var resp = await Http.PostAsJsonAsync("/ui/assets/bulk", request);
            if (resp.IsSuccessStatusCode)
            {
                _assets.RemoveAll(x => x.AssetId == a.AssetId);
                AddLog($"Asset '{a.Value}' archived.");
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                var errorBody = await resp.Content.ReadAsStringAsync();
                AddLog($"Failed to archive asset ({(int)resp.StatusCode}): {errorBody}", error: true);
            }
        }
        catch (Exception ex)
        {
            AddLog($"Archive error: {ex.Message}", error: true);
        }
    }

    async Task EditAssetAsync(AssetItem a)
    {
        var parameters = new DialogParameters
        {
            ["AssetId"] = a.AssetId
        };
        var dialog = await DialogService.ShowAsync<EditAssetDialog>($"Edit {a.Value}", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            if (_showingAllAssets)
                await LoadAllAssetsAsync();
            else
                await LoadAssetsAsync();
        }
    }

    // ── Program actions ───────────────────────────────────────────────────────────

    async Task DeleteProgramAsync(ProgramItem p)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            $"Delete {p.Name}?",
            "This will archive all assets for this program. This action cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirm != true) return;

        try
        {
            using var resp = await Http.DeleteAsync($"/ui/programs/{p.ProgramId}");
            if (resp.IsSuccessStatusCode)
            {
                _programs.RemoveAll(x => x.ProgramId == p.ProgramId);
                if (_selectedProgram?.ProgramId == p.ProgramId)
                {
                    _selectedProgram = _programs.FirstOrDefault();
                    if (_selectedProgram is not null)
                        await SelectProgram(_selectedProgram);
                    else
                    {
                        _assets.Clear();
                        await LoadAllAssetsAsync();
                    }
                }
                AddLog($"Program '{p.Name}' deleted.");
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                AddLog($"Failed to delete program ({(int)resp.StatusCode})", error: true);
            }
        }
        catch (Exception ex)
        {
            AddLog($"Delete error: {ex.Message}", error: true);
        }
    }

