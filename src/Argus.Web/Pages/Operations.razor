@page "/operations"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http

<PageHeader Title="Operations" Subtitle="@($"{_assets.Count:N0} assets loaded")" />

<div class="page-body ops-page">
    @if (_loading)
    {
        <div class="empty-state">
            <div class="app-loading-spinner"></div>
            <p>Loading programs...</p>
        </div>
    }
    else
    {
        <div class="ops-layout">

            <!-- Programs grid -->
            <div class="ops-programs-panel">
                <div class="ops-panel-header">
                    <span class="ops-panel-title">Programs</span>
                    <span class="ops-panel-count">@_programs.Count program@(_programs.Count != 1 ? "s" : "")</span>
                    <span class="ops-panel-hint">right-click to run</span>
                </div>
                <div class="ops-programs-table">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Source</th>
                                <th style="width:70px">Scopes</th>
                                <th style="width:80px">Assets</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_programs.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="ops-empty-row">No programs found — add one via the API</td>
                                </tr>
                            }
                            @foreach (var prog in _programs)
                            {
                                <tr class="@(_selectedProgramId == prog.ProgramId ? "selected" : "")"
                                    @onclick="() => SelectProgram(prog)"
                                    @oncontextmenu="@((e) => ShowProgramMenu(e, prog))"
                                    @oncontextmenu:preventDefault="true">
                                    <td class="mono">@prog.Name</td>
                                    <td class="text-muted">@prog.Source</td>
                                    <td>@prog.ScopeCount</td>
                                    <td>@(_assetCounts.TryGetValue(prog.ProgramId, out var cnt) ? cnt.ToString("N0") : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Assets grid -->
            <div class="ops-assets-panel">
                <div class="ops-panel-header">
                    <span class="ops-panel-title">Assets</span>
                    @if (_selectedProgram is not null)
                    {
                        <span class="ops-panel-count">@_selectedProgram.Name · @_assets.Count assets</span>
                    }
                    @if (_assetsLoading)
                    {
                        <span class="ops-loading-label">loading…</span>
                    }
                    <div class="ops-panel-actions">
                        @if (_polling)
                        {
                            <span class="ops-live-badge">● LIVE</span>
                        }
                        <button class="btn btn-sm btn-ghost" @onclick="RefreshAssetsAsync" title="Refresh">↻</button>
                        <button class="btn btn-sm @(_polling ? "btn-danger" : "btn-ghost")" @onclick="TogglePolling">
                            @(_polling ? "■ Stop" : "▶ Poll")
                        </button>
                    </div>
                </div>
                <div class="ops-assets-table">
                    @if (_selectedProgram is null)
                    {
                        <div class="empty-state" style="padding: 48px 24px;">
                            <div class="empty-state-title">Select a program</div>
                            <div class="empty-state-description">Click a row above, or right-click to run enumeration and spidering.</div>
                        </div>
                    }
                    else if (_assetsLoading && _assets.Count == 0)
                    {
                        <div class="empty-state" style="padding: 48px 24px;">
                            <div class="app-loading-spinner"></div>
                        </div>
                    }
                    else if (_assets.Count == 0)
                    {
                        <div class="empty-state" style="padding: 48px 24px;">
                            <div class="empty-state-icon">🔍</div>
                            <div class="empty-state-title">No assets yet</div>
                            <div class="empty-state-description">Right-click the program above to enumerate subdomains or spider URLs.</div>
                        </div>
                    }
                    else
                    {
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th style="width:110px">Type</th>
                                    <th>Value</th>
                                    <th style="width:90px">Status</th>
                                    <th style="width:60px">Risk</th>
                                    <th style="width:130px">Worker</th>
                                    <th style="width:90px">First Seen</th>
                                    <th style="width:90px">Last Seen</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var asset in _assets)
                                {
                                    <tr class="@(_selectedAssetId == asset.AssetId ? "selected" : "") @(_flashingIds.Contains(asset.AssetId) ? "row-new" : "")"
                                        @onclick="() => _selectedAssetId = asset.AssetId"
                                        @oncontextmenu="@((e) => ShowAssetMenu(e, asset))"
                                        @oncontextmenu:preventDefault="true">
                                        <td>
                                            <span class="asset-type">@asset.Type</span>
                                        </td>
                                        <td class="mono">@asset.Value</td>
                                        <td>
                                            <span class="status-badge status-@asset.Status.ToLowerInvariant()">@asset.Status</span>
                                        </td>
                                        <td>
                                            <span class="risk-score risk-@(asset.RiskScore >= 70 ? "high" : asset.RiskScore >= 40 ? "medium" : "low")">@asset.RiskScore</span>
                                        </td>
                                        <td class="text-muted mono" style="font-size:11px;">@(asset.SourceWorkerType ?? "—")</td>
                                        <td class="text-muted">@FmtAgo(asset.FirstSeenAt)</td>
                                        <td class="text-muted">@FmtAgo(asset.LastSeenAt)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <!-- Activity feed -->
            <div class="ops-activity-panel">
                <div class="ops-panel-header">
                    <span class="ops-panel-title">Activity</span>
                    <button class="btn btn-sm btn-ghost" @onclick="() => _log.Clear()" style="margin-left:auto;font-size:11px;">Clear</button>
                </div>
                <div class="ops-log">
                    @if (_log.Count == 0)
                    {
                        <div class="ops-log-empty">// no activity yet</div>
                    }
                    @foreach (var entry in _log)
                    {
                        <div class="ops-log-entry ops-log-@entry.Type">
                            <span class="ops-log-time">@entry.Time</span>
                            <span class="ops-log-msg">@entry.Message</span>
                        </div>
                    }
                </div>
            </div>

        </div>
    }
</div>

@if (_contextMenu is not null)
{
    <div class="ops-ctx-backdrop" @onclick="CloseMenu"></div>
    <div class="ops-ctx-menu" style="left:@(_contextMenu.X.ToString("F0"))px;top:@(_contextMenu.Y.ToString("F0"))px">
        @if (!string.IsNullOrEmpty(_contextMenu.Label))
        {
            <div class="ops-ctx-header">@_contextMenu.Label</div>
        }
        @foreach (var item in _contextMenu.Items)
        {
            @if (item.IsSeparator)
            {
                <div class="ops-ctx-sep"></div>
            }
            else
            {
                <button class="ops-ctx-item" @onclick="() => ExecuteMenuItemAsync(item)" disabled="@item.Disabled">
                    @item.Label
                </button>
            }
        }
    </div>
}

@code {
    // ── Inner types ───────────────────────────────────────────────────────────

    private sealed record ProgramItem(Guid ProgramId, string Name, string Source, int ScopeCount);

    private sealed record AssetItem(
        Guid AssetId,
        Guid ProgramId,
        string Type,
        string Value,
        string Status,
        int RiskScore,
        string? SourceWorkerType,
        DateTimeOffset FirstSeenAt,
        DateTimeOffset LastSeenAt);

    private sealed record LogEntry(string Time, string Message, string Type);

    private sealed class ContextMenuState
    {
        public double X { get; init; }
        public double Y { get; init; }
        public string? Label { get; init; }
        public List<ContextMenuItem> Items { get; init; } = new();
    }

    private sealed record ContextMenuItem(
        string Label,
        Func<Task> Handler,
        bool Disabled = false,
        bool IsSeparator = false)
    {
        public static ContextMenuItem Separator() =>
            new("", () => Task.CompletedTask, IsSeparator: true);
    }

    // ── State ─────────────────────────────────────────────────────────────────

    private List<ProgramItem> _programs = new();
    private Dictionary<Guid, int> _assetCounts = new();
    private List<AssetItem> _assets = new();
    private HashSet<Guid> _knownAssetIds = new();
    private HashSet<Guid> _flashingIds = new();
    private List<LogEntry> _log = new();

    private ProgramItem? _selectedProgram;
    private Guid? _selectedProgramId;
    private Guid? _selectedAssetId;

    private bool _loading = true;
    private bool _assetsLoading;
    private bool _polling;

    private ContextMenuState? _contextMenu;
    private CancellationTokenSource? _pollCts;

    private static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    private static readonly Dictionary<string, (string TaskType, string WorkerCapability)> ActionMap = new()
    {
        ["enum-sub"] = ("DomainDiscovery", "Subfinder"),
        ["spider"]   = ("HtmlSpider",      "HtmlDomSpider"),
        ["spider-hl"]= ("HeadlessSpider",  "HeadlessSpider"),
    };

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await LoadProgramsAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await StopPollingAsync();
    }

    // ── Data loading ──────────────────────────────────────────────────────────

    private async Task LoadProgramsAsync()
    {
        _loading = true;
        try
        {
            var resp = await Http.GetAsync("/ui/programs");
            if (!resp.IsSuccessStatusCode) return;

            var json = await resp.Content.ReadAsStringAsync();
            var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            var array = root.ValueKind == JsonValueKind.Array ? root
                : root.TryGetProperty("items", out var items) ? items
                : root.TryGetProperty("value", out var val) ? val
                : default;

            if (array.ValueKind != JsonValueKind.Array) return;

            var list = new List<ProgramItem>();
            foreach (var el in array.EnumerateArray())
            {
                if (!el.TryGetProperty("programId", out var pidEl) || !pidEl.TryGetGuid(out var id)) continue;
                var name   = el.TryGetProperty("name",   out var n) ? n.GetString() ?? "" : "";
                var source = el.TryGetProperty("source", out var s) ? s.GetString() ?? "" : "";
                var scopes = el.TryGetProperty("scopes", out var sc) && sc.ValueKind == JsonValueKind.Array
                    ? sc.GetArrayLength() : 0;
                list.Add(new ProgramItem(id, name, source, scopes));
            }
            _programs = list;
        }
        catch (Exception ex)
        {
            AddLog("Error loading programs: " + ex.Message, "error");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAssetsAsync(bool isPolling = false)
    {
        if (_selectedProgram is null) return;
        if (!isPolling) _assetsLoading = true;

        try
        {
            var resp = await Http.GetAsync($"/ui/ops/assets?programId={_selectedProgram.ProgramId}&take=500");
            if (!resp.IsSuccessStatusCode) return;

            var json = await resp.Content.ReadAsStringAsync();
            var doc  = JsonDocument.Parse(json);
            var root = doc.RootElement;

            var array = root.ValueKind == JsonValueKind.Array ? root
                : root.TryGetProperty("items", out var it) ? it
                : default;

            if (array.ValueKind != JsonValueKind.Array) return;

            var list = new List<AssetItem>();
            foreach (var el in array.EnumerateArray())
            {
                var a = ParseAsset(el);
                if (a is not null) list.Add(a);
            }

            var newIds = list
                .Select(a => a.AssetId)
                .Where(id => !_knownAssetIds.Contains(id))
                .ToList();

            foreach (var id in list.Select(a => a.AssetId)) _knownAssetIds.Add(id);

            _assets = list;
            _assetCounts[_selectedProgram.ProgramId] = list.Count;

            if (newIds.Count > 0 && isPolling)
                _ = FlashAssetsAsync(newIds);
        }
        catch (Exception ex)
        {
            if (!isPolling) AddLog("Error loading assets: " + ex.Message, "error");
        }
        finally
        {
            if (!isPolling) _assetsLoading = false;
        }
    }

    private static AssetItem? ParseAsset(JsonElement el)
    {
        try
        {
            if (!el.TryGetProperty("assetId", out var aidEl) || !aidEl.TryGetGuid(out var id)) return null;
            el.TryGetProperty("programId", out var pidEl);
            pidEl.TryGetGuid(out var programId);
            var type   = el.TryGetProperty("type",   out var t) ? t.GetString() ?? "" : "";
            var value  = el.TryGetProperty("value",  out var v) ? v.GetString() ?? "" : "";
            var status = el.TryGetProperty("status", out var s) ? s.GetString() ?? "Active" : "Active";
            var risk   = el.TryGetProperty("riskScore", out var r) && r.ValueKind == JsonValueKind.Number ? r.GetInt32() : 0;
            var worker = el.TryGetProperty("sourceWorkerType", out var w) && w.ValueKind == JsonValueKind.String ? w.GetString() : null;
            var firstSeen = el.TryGetProperty("firstSeenAt", out var fsEl) && fsEl.TryGetDateTimeOffset(out var fs) ? fs : DateTimeOffset.UtcNow;
            var lastSeen  = el.TryGetProperty("lastSeenAt",  out var lsEl) && lsEl.TryGetDateTimeOffset(out var ls) ? ls : DateTimeOffset.UtcNow;
            return new AssetItem(id, programId, type, value, status, risk, worker, firstSeen, lastSeen);
        }
        catch { return null; }
    }

    // ── Polling ───────────────────────────────────────────────────────────────

    private void TogglePolling()
    {
        if (_polling) _ = StopPollingAsync();
        else
        {
            _polling = true;
            _ = StartPollingAsync();
        }
    }

    private async Task StartPollingAsync()
    {
        await StopPollingAsync();
        _pollCts = new CancellationTokenSource();
        var token = _pollCts.Token;

        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            while (!token.IsCancellationRequested && await timer.WaitForNextTickAsync(token))
            {
                await LoadAssetsAsync(isPolling: true);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task StopPollingAsync()
    {
        if (_pollCts is { } cts)
        {
            await cts.CancelAsync();
            cts.Dispose();
            _pollCts = null;
        }
        _polling = false;
    }

    // ── Flash effect ──────────────────────────────────────────────────────────

    private async Task FlashAssetsAsync(IReadOnlyList<Guid> ids)
    {
        foreach (var id in ids) _flashingIds.Add(id);
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2500);
        foreach (var id in ids) _flashingIds.Remove(id);
        await InvokeAsync(StateHasChanged);
    }

    // ── Program selection ──────────────────────────────────────────────────────

    private async Task SelectProgram(ProgramItem prog)
    {
        if (_selectedProgramId == prog.ProgramId) return;

        await StopPollingAsync();
        _selectedProgram  = prog;
        _selectedProgramId = prog.ProgramId;
        _assets           = new();
        _knownAssetIds    = new();
        _flashingIds      = new();
        _selectedAssetId  = null;
        CloseMenu();

        await LoadAssetsAsync();
    }

    private async Task RefreshAssetsAsync()
    {
        await LoadAssetsAsync();
    }

    // ── Context menus ──────────────────────────────────────────────────────────

    private void ShowProgramMenu(MouseEventArgs e, ProgramItem prog)
    {
        var domainAssets = _assets.Where(a => a.Type == "Domain").ToList();
        var urlAssets    = _assets.Where(a => a.Type is "Subdomain" or "Url" or "HtmlPage").ToList();

        _contextMenu = new ContextMenuState
        {
            X = e.ClientX,
            Y = e.ClientY,
            Label = $"TARGET · {prog.Name}",
            Items =
            [
                new($"Enumerate Subdomains ({(domainAssets.Count > 0 ? domainAssets.Count : 1)} domain{((domainAssets.Count > 1) ? "s" : "")})",
                    async () =>
                    {
                        if (domainAssets.Count > 0)
                            foreach (var a in domainAssets) await EnqueueActionAsync(a, "enum-sub");
                        else
                            AddLog($"No Domain assets for {prog.Name} — run after assets are created.", "error");
                    }),
                new($"Spider All URLs ({urlAssets.Count} asset{(urlAssets.Count != 1 ? "s" : "")})",
                    async () => { foreach (var a in urlAssets) await EnqueueActionAsync(a, "spider"); },
                    Disabled: urlAssets.Count == 0),
                ContextMenuItem.Separator(),
                new(_polling ? "■ Stop Live Polling" : "▶ Start Live Polling",
                    () => { TogglePolling(); return Task.CompletedTask; }),
            ]
        };
        StateHasChanged();
    }

    private void ShowAssetMenu(MouseEventArgs e, AssetItem asset)
    {
        var items = new List<ContextMenuItem>();

        if (asset.Type == "Domain")
            items.Add(new("Enumerate Subdomains", () => EnqueueActionAsync(asset, "enum-sub")));

        if (asset.Type is "Subdomain" or "Url" or "HtmlPage" or "ApiEndpoint")
        {
            items.Add(new("Spider",           () => EnqueueActionAsync(asset, "spider")));
            items.Add(new("Spider (Headless)", () => EnqueueActionAsync(asset, "spider-hl")));
        }

        if (items.Count == 0)
            items.Add(new("No actions for this asset type", () => Task.CompletedTask, Disabled: true));

        var label = asset.Value.Length > 40 ? asset.Value[..40] + "…" : asset.Value;
        _contextMenu = new ContextMenuState
        {
            X = e.ClientX,
            Y = e.ClientY,
            Label = $"{asset.Type.ToUpperInvariant()} · {label}",
            Items = items
        };
        StateHasChanged();
    }

    private void CloseMenu() => _contextMenu = null;

    private async Task ExecuteMenuItemAsync(ContextMenuItem item)
    {
        CloseMenu();
        await item.Handler();
        await InvokeAsync(StateHasChanged);
    }

    // ── Task enqueueing ───────────────────────────────────────────────────────

    private async Task EnqueueActionAsync(AssetItem asset, string action)
    {
        if (!ActionMap.TryGetValue(action, out var mapping)) return;
        var (taskType, workerCap) = mapping;
        var label = action switch { "enum-sub" => "Enumerate Subdomains", "spider" => "Spider", _ => "Spider (Headless)" };

        AddLog($"Dispatching {label} on {asset.Value}…");

        if (!_polling)
        {
            _polling = true;
            _ = StartPollingAsync();
        }

        try
        {
            var request = new
            {
                assetIds = new[] { asset.AssetId },
                taskType,
                workerCapability = workerCap,
                programId = asset.ProgramId,
            };
            var resp = await Http.PostAsJsonAsync("/ui/assets/bulk/enqueue", request);
            if (resp.IsSuccessStatusCode)
                AddLog($"✓ {label} queued for {asset.Value}", "success");
            else
                AddLog($"Server error {(int)resp.StatusCode} for {asset.Value}", "error");
        }
        catch (Exception ex)
        {
            AddLog($"Error: {ex.Message}", "error");
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private void AddLog(string message, string type = "info")
    {
        _log.Add(new LogEntry(DateTime.Now.ToString("HH:mm:ss"), message, type));
        if (_log.Count > 200) _log = _log.TakeLast(200).ToList();
    }

    private static string FmtAgo(DateTimeOffset dt)
    {
        var diff = DateTimeOffset.UtcNow - dt;
        if (diff.TotalMinutes < 1)  return "just now";
        if (diff.TotalHours   < 1)  return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays    < 1)  return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }
}
