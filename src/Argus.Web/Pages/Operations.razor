@page "/operations"
@using System.Text.Json
@using System.Text.Json.Nodes
@using Argus.Web.Components
@using Argus.Web.Components.Dialogs
@using MudBlazor
@inject HttpClient Http
@inject ILogger<Operations> Logger
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject DevelopmentRealtimeClient Realtime
@implements IAsyncDisposable

<PageTitle>Operations</PageTitle>

<div class="ops-page">
<div class="ops-toolbar">
    <MudButton Variant="Variant.Filled"
               Color="@(_processingEnabled ? Color.Error : Color.Success)"
               Size="Size.Medium"
               OnClick="ToggleProcessing"
               aria-label="@(_processingEnabled ? "Stop Processing" : "Start Processing")">
        <MudIcon Icon="@(_processingEnabled ? Icons.Material.Filled.Stop : Icons.Material.Filled.PlayArrow)" Class="mr-2" />
        @(_processingEnabled ? "Stop" : "Start")
    </MudButton>
    @if (_processingToggling)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="ml-2" />
    }
</div>

@* ── Stats summary bar ── *@
<div class="ops-stats-bar">
    <div class="ops-stat-item">
        <span class="ops-stat-label">Total Assets:</span>
        <span class="ops-stat-value">@(_assetTotalCount?.ToString("N0") ?? "—")</span>
    </div>
    <div class="ops-stat-divider"></div>
    <div class="ops-stat-item">
        <span class="ops-stat-label">Technologies:</span>
        <span class="ops-stat-value">@_technologies.Count</span>
    </div>
    <div class="ops-stat-divider"></div>
    <div class="ops-stat-item">
        <span class="ops-stat-label">Programs:</span>
        <span class="ops-stat-value">@_programs.Count</span>
    </div>
    @if (_topAssetTypes.Any())
    {
        <div class="ops-stat-divider"></div>
        <div class="ops-stat-item">
            <span class="ops-stat-label">Top Types:</span>
            <span class="ops-stat-value">@string.Join(", ", _topAssetTypes.Select(kv => $"{kv.Key} ({kv.Value})"))</span>
        </div>
    }
</div>

<div class="ops-layout">

    @* ── Programs panel ── *@
    <MudPaper Class="ops-panel ops-row-short" Elevation="0" Square="true">
        <div class="ops-panel-header">
            <MudText Typo="Typo.subtitle2" Class="ops-panel-title">Programs</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ops-count-chip">@_programs.Count</MudChip>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Add"
                           Size="Size.Small"
                           aria-label="New Program"
                           OnClick="OpenNewProgramDialog" />
        </div>
        <ArgusGrid TItem="ProgramItem"
                   Items="_programs"
                   SelectedItem="_selectedProgram"
                   OnRowClick="SelectProgram"
                   ContextMenuItems="GetProgramMenuItems"
                   Virtualize="true"
                   EmptyMessage="No programs">
            <PropertyColumn T="ProgramItem" TProperty="string" Property="p => p.Name"        Title="Name" />
            <PropertyColumn T="ProgramItem" TProperty="string" Property="p => p.Asset"      Title="Asset" />
            <PropertyColumn T="ProgramItem" TProperty="string" Property="p => p.AssetType"  Title="Asset Type" />
            <PropertyColumn T="ProgramItem" TProperty="string" Property="p => p.Scope"      Title="Scope" />
            <PropertyColumn T="ProgramItem" TProperty="string" Property="p => p.Source"      Title="Source" />
            <TemplateColumn T="ProgramItem" Title="Date Added">
                <CellTemplate>@context.Item.CreatedAt.ToString("MM/dd/yy HH:mm")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="ProgramItem" Title="Assets" Sortable="true">
                <CellTemplate>@StatsFor(context.Item.ProgramId).Assets.ToString("N0")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="ProgramItem" Title="Subdomains" Sortable="true">
                <CellTemplate>@StatsFor(context.Item.ProgramId).Subdomains.ToString("N0")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="ProgramItem" Title="Urls" Sortable="true">
                <CellTemplate>@StatsFor(context.Item.ProgramId).Urls.ToString("N0")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="ProgramItem" Title="Scripts" Sortable="true">
                <CellTemplate>@StatsFor(context.Item.ProgramId).Scripts.ToString("N0")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="ProgramItem" Title="API Endpoints" Sortable="true">
                <CellTemplate>@StatsFor(context.Item.ProgramId).ApiEndpoints.ToString("N0")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="ProgramItem" Title="Forms" Sortable="true">
                <CellTemplate>@StatsFor(context.Item.ProgramId).Forms.ToString("N0")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="ProgramItem" Title="Login Pages" Sortable="true">
                <CellTemplate>@StatsFor(context.Item.ProgramId).LoginPages.ToString("N0")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="ProgramItem" Title="Identified Technologies" Sortable="true">
                <CellTemplate>@StatsFor(context.Item.ProgramId).Technologies.ToString("N0")</CellTemplate>
            </TemplateColumn>
        </ArgusGrid>
    </MudPaper>

    @* ── Assets panel ── *@
    <MudPaper Class="ops-panel ops-panel-wide ops-row-fill" Elevation="0" Square="true">
        <div class="ops-panel-header">
            <div class="ops-assets-header-left">
                <MudText Typo="Typo.subtitle2" Class="ops-panel-title">Assets</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ops-count-chip">@AssetCountLabel</MudChip>
                @if (_realtimeConnected)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="ops-live-chip">LIVE</MudChip>
                }
            </div>
            @if (_selectedProgram is not null)
            {
                <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined">
                    <MudButton OnClick="ClearProgramFilter"
                               Color="Color.Default"
                               Size="Size.Small"
                               title="Show all assets from all programs">
                        All
                    </MudButton>
                    <MudButton Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="true">
                        @_selectedProgram.Name
                    </MudButton>
                </MudButtonGroup>
            }
            else
            {
                <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mr-3">All programs</MudText>
            }
        </div>
        @if (_assetError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="ma-2">@_assetError</MudAlert>
        }

        @* Search toolbar for assets *@
        <div class="ops-search-bar">
            <MudTextField @bind-Value="_assetSearchText"
                          Placeholder="Search assets..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          DebounceInterval="300"
                          Class="ops-search-input" />
            <MudTooltip Text="Use regex">
                <MudSwitch @bind-Value="_assetSearchRegex"
                           Color="Color.Primary"
                           Label="Regex" />
            </MudTooltip>
            @if (_assetSearchText.Length > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2 align-self-center">
                    @FilteredAssets.Count().ToString("N0") of @_assets.Count.ToString("N0")
                </MudText>
            }
        </div>

        <ArgusGrid TItem="AssetItem"
                   Items="@FilteredAssets"
                   SelectedItem="_selectedAsset"
                   OnRowClick="SelectAsset"
                   ContextMenuItems="GetAssetMenuItems"
                   RowClassFunc="@((a, _) => RowClassFn(a))"
                   Virtualize="true"
                   Height="100%"
                   Loading="_loadingAssets"
                   EmptyMessage="@(_showingAllAssets ? "No assets found" : "Select a program to view assets")">
<PropertyColumn T="AssetItem" TProperty="string" Property="a => a.Type" Title="Type" Sortable="true" />
            <TemplateColumn T="AssetItem" Title="Value" Sortable="true">
                <CellTemplate>
                    @{
                        var value = context.Item.Value;
                        if (Uri.TryCreate(value, UriKind.Absolute, out var uri))
                        {
                            <a href="@uri.AbsoluteUri" target="_blank" class="asset-link" @onclick:stopPropagation>@value</a>
                        }
                        else
                        {
                            @value
                        }
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn T="AssetItem" TProperty="string" Property="a => a.Status" Title="Status" Sortable="true" />
            <TemplateColumn T="AssetItem" Title="Risk" Sortable="true">
                <CellTemplate>@(context.Item.RiskScore?.ToString("F1") ?? "—")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="AssetItem" Title="Size" Sortable="true">
                <CellTemplate>
                    @{
                        var size = context.Item.SizeBytes;
                        <span>@(size.HasValue ? FormatBytes(size.Value) : "—")</span>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="AssetItem" Title="Response" Sortable="true">
                <CellTemplate>
                    @{
                        var ms = context.Item.ResponseTimeMs;
                        <span>@(ms.HasValue ? $"{ms.Value}ms" : "—")</span>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="AssetItem" Title="Notes">
                <CellTemplate>@(context.Item.Notes ?? "—")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="AssetItem" Title="First Seen" Sortable="true">
                <CellTemplate>@FmtAgo(context.Item.FirstSeenAt)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="AssetItem" Title="Last Seen" Sortable="true">
                <CellTemplate>@FmtAgo(context.Item.LastSeenAt)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="AssetItem" Title="" Style="width: 50px;">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                   Size="Size.Small"
                                   aria-label="View Request/Response"
                                   OnClick="@(() => _ = OpenRequestTool(context.Item.AssetId))" />
                </CellTemplate>
            </TemplateColumn>
        </ArgusGrid>
    </MudPaper>

    @* ── Technologies panel ── *@
    <MudPaper Class="ops-panel ops-panel-wide ops-row-tech" Elevation="0" Square="true">
        <div class="ops-panel-header">
            <div class="ops-assets-header-left">
                <MudText Typo="Typo.subtitle2" Class="ops-panel-title">Technologies</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ops-count-chip">@_technologies.Count</MudChip>
            </div>
        </div>
        <ArgusGrid TItem="TechnologyItem"
                   Items="_technologies"
                   SelectedItem="_selectedTechnology"
                   OnRowClick="SelectTechnology"
                   Virtualize="true"
                   Height="100%"
                   Loading="_loadingTechnologies"
                   EmptyMessage="No technologies discovered">
            <PropertyColumn T="TechnologyItem" TProperty="string" Property="t => t.Name" Title="Name" />
            <PropertyColumn T="TechnologyItem" TProperty="string" Property="t => t.Category" Title="Category" />
            <PropertyColumn T="TechnologyItem" TProperty="string" Property="t => t.Target" Title="Target" />
            <TemplateColumn T="TechnologyItem" Title="Confidence" Sortable="true">
                <CellTemplate>@((context.Item.Confidence * 100).ToString("F0"))%</CellTemplate>
            </TemplateColumn>
            <PropertyColumn T="TechnologyItem" TProperty="DateTimeOffset" Property="t => t.DiscoveredAt" Title="Discovered" />
        </ArgusGrid>
    </MudPaper>

    @* ── Activity feed ── *@
    <MudPaper Class="ops-panel ops-row-activity" Elevation="0" Square="true">
        <div class="ops-panel-header">
            <MudText Typo="Typo.subtitle2" Class="ops-panel-title">Activity</MudText>
        </div>
        <div class="ops-log">
            @* Show only the most recent few so the panel can't grow unbounded (newest are at index 0). *@
            @foreach (var entry in _log.Take(5))
            {
                <div class="ops-log-entry @(entry.IsError ? "ops-log-error" : "ops-log-success")">
                    <span class="ops-log-time">@entry.When.ToString("HH:mm:ss")</span>
                    @entry.Message
                </div>
            }
            @if (_log.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="pa-3">No activity yet</MudText>
            }
        </div>
    </MudPaper>

</div>
</div>

@code {
    // ── Models ───────────────────────────────────────────────────────────────────

    sealed record ProgramItem(Guid ProgramId, string Name, string Asset, string AssetType, string Scope, string Source, DateTimeOffset CreatedAt);
    sealed record ProgramStats(int Assets, int Subdomains, int Urls, int Scripts, int ApiEndpoints, int Forms, int LoginPages, int Technologies);
    sealed record AssetItem(Guid AssetId, string Type, string Value, string Status,
        double? RiskScore, DateTimeOffset? FirstSeenAt, DateTimeOffset? LastSeenAt,
        long? SizeBytes, int? ResponseTimeMs, string? Notes);
    sealed record AssetResponse(List<JsonElement> Items, int TotalCount);
    sealed record TechnologyItem(Guid AssetId, string Name, string Category, string Target,
        double Confidence, DateTimeOffset DiscoveredAt);
    sealed record LogEntry(string Message, bool IsError, DateTimeOffset When = default)
    {
        public DateTimeOffset When { get; init; } = When == default ? DateTimeOffset.UtcNow : When;
    }

    static readonly Dictionary<string, (string TaskType, string WorkerCapability)> ActionMap = new()
    {
        ["enum-sub"]  = ("subdomain-enumeration", "SubfinderWorker"),
        ["spider"]    = ("spider",                "HtmlDomSpiderWorker"),
        ["spider-hl"] = ("headless-spider",       "HeadlessSpiderWorker"),
    };

    // Areas that indicate new assets may have appeared
    static readonly HashSet<string> AssetRefreshAreas =
        new(StringComparer.OrdinalIgnoreCase) { "assets", "agent-tasks", "tasks" };

    // ── State ───────────────────────────────────────────────────────────────────

    List<ProgramItem> _programs     = [];
    List<AssetItem>   _assets       = [];
    List<TechnologyItem> _technologies = [];
    List<LogEntry>    _log          = [];
    HashSet<Guid>     _flashingIds  = [];

    Dictionary<string, int> _topAssetTypes = [];

    // Per-program asset breakdown for the Programs grid count columns (computed client-side from a full
    // asset fetch, since the asset service exposes no per-program aggregation endpoint).
    Dictionary<Guid, ProgramStats> _programStats = [];
    ProgramStats StatsFor(Guid programId) =>
        _programStats.TryGetValue(programId, out var s) ? s : new ProgramStats(0, 0, 0, 0, 0, 0, 0, 0);

    ProgramItem? _selectedProgram;
    AssetItem?   _selectedAsset;
    TechnologyItem? _selectedTechnology;
    bool         _realtimeConnected;
    bool         _loadingAssets;
    bool         _loadingTechnologies;
    bool         _showingAllAssets;
    string?      _assetError;
    int?         _assetTotalCount;

    bool         _processingEnabled = true;
    bool         _processingToggling;

    string AssetCountLabel => (_assetTotalCount ?? _assets.Count).ToString("N0");

    string _assetSearchText = "";
    bool   _assetSearchRegex;

    IEnumerable<AssetItem> FilteredAssets
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_assetSearchText))
                return _assets;

            try
            {
                if (_assetSearchRegex)
                {
                    var regex = new System.Text.RegularExpressions.Regex(
                        _assetSearchText,
                        System.Text.RegularExpressions.RegexOptions.IgnoreCase,
                        TimeSpan.FromMilliseconds(500));
                    return _assets.Where(a =>
                        regex.IsMatch(a.Value) ||
                        regex.IsMatch(a.Type) ||
                        (a.Notes is not null && regex.IsMatch(a.Notes)));
                }
                else
                {
                    var searchLower = _assetSearchText.ToLowerInvariant();
                    return _assets.Where(a =>
                        a.Value.Contains(searchLower, StringComparison.OrdinalIgnoreCase) ||
                        a.Type.Contains(searchLower, StringComparison.OrdinalIgnoreCase) ||
                        (a.Notes is not null && a.Notes.Contains(searchLower, StringComparison.OrdinalIgnoreCase)));
                }
            }
            catch (System.Text.RegularExpressions.RegexParseException)
            {
                return _assets;
            }
        }
    }

    // ── Lifecycle ────────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await LoadProgramsAsync();
        await LoadProgramStatsAsync();
        await LoadAssetActionsAsync();
        await LoadProcessingStateAsync();
    }

    async Task LoadProcessingStateAsync()
    {
        try
        {
            using var resp = await Http.GetAsync("/ui/processing/state");
            if (resp.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(await resp.Content.ReadAsStringAsync());
                _processingEnabled = doc.RootElement.TryGetProperty("enabled", out var e) && e.GetBoolean();
            }
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        Realtime.Changed += OnRealtimeChangedAsync;
        try
        {
            await Realtime.StartAsync();
            _realtimeConnected = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Realtime hub failed to start");
        }

        await LoadAllAssetsAsync();
        await LoadTechnologiesAsync();

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Realtime.Changed -= OnRealtimeChangedAsync;
        await Realtime.DisposeAsync();
    }

    private async Task OnRealtimeChangedAsync(DevelopmentDataChangedEvent evt)
    {
        if (evt.Area != "assets") return;

        if (evt.Delta is not null)
        {
            if (string.Equals(evt.Delta.Type, "Technology", StringComparison.OrdinalIgnoreCase))
            {
                await LoadTechnologiesAsync();
            }
            else
            {
                await ApplyAssetDeltaAsync(evt.Delta);
            }
        }
        else if (evt.Reason.Equals("changed", StringComparison.OrdinalIgnoreCase))
        {
            await ThrottleReloadAsync();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyAssetDeltaAsync(AssetDelta delta)
    {
        // Only reflect deltas for the program currently in view (or when viewing all assets).
        if (!_showingAllAssets && _selectedProgram is not null
            && delta.ProgramId != Guid.Empty && delta.ProgramId != _selectedProgram.ProgramId)
            return;

        var existing = _assets.FirstOrDefault(a => a.AssetId == delta.AssetId);

        switch (delta.Action.ToLowerInvariant())
        {
            case "created":
            case "discovered":
            case "confirmed":
                if (existing is null)
                {
                    var newAsset = new AssetItem(
                        delta.AssetId,
                        delta.Type,
                        delta.Value,
                        "Active",
                        delta.RiskScore,
                        delta.FirstSeenAt,
                        delta.LastSeenAt,
                        null,
                        null,
                        null);
                    _assets.Insert(0, newAsset);
                    _assetTotalCount = (_assetTotalCount ?? _assets.Count - 1) + 1;
                    AddLog($"New asset: {delta.Value}");
                }
                break;

            case "updated":
                if (existing is not null)
                {
                    var index = _assets.IndexOf(existing);
                    var updated = existing with
                    {
                        Type = string.IsNullOrEmpty(delta.Type) ? existing.Type : delta.Type,
                        Value = string.IsNullOrEmpty(delta.Value) ? existing.Value : delta.Value,
                        RiskScore = delta.RiskScore ?? existing.RiskScore,
                        FirstSeenAt = delta.FirstSeenAt ?? existing.FirstSeenAt,
                        LastSeenAt = delta.LastSeenAt ?? existing.LastSeenAt
                    };
                    _assets[index] = updated;
                }
                break;

            case "archived":
            case "deleted":
                if (existing is not null)
                {
                    _assets.Remove(existing);
                    _assetTotalCount = Math.Max(0, (_assetTotalCount ?? _assets.Count + 1) - 1);
                    AddLog($"Asset removed: {existing.Value}");
                }
                break;
        }
    }

    private DateTime _lastReloadAt = DateTime.MinValue;
    private static readonly TimeSpan ReloadCooldown = TimeSpan.FromSeconds(2);

    private async Task ThrottleReloadAsync()
    {
        if (DateTime.UtcNow - _lastReloadAt < ReloadCooldown)
        {
            return;
        }

        _lastReloadAt = DateTime.UtcNow;

        if (_selectedProgram is not null && !_showingAllAssets)
            await LoadAssetsAsync();
        else
            await LoadAllAssetsAsync();

        await LoadTechnologiesAsync();
    }

    // ── Context menu builders ─────────────────────────────────────────────────────

    List<ArgusMenuItem> GetProgramMenuItems(ProgramItem p) =>
    [
        new("Edit Program",           () => OpenEditProgramDialog(p)),
        new("Delete Program",         () => DeleteProgramAsync(p)),
        ArgusMenuItem.Separator(),
        new("Enumerate Subdomains",   () => RunProgramActionAsync("enum-sub", p)),
        new("Spider All Assets",       () => RunProgramActionAsync("spider",   p)),
    ];

    List<ArgusMenuItem> GetAssetMenuItems(AssetItem a)
    {
        var t = a.Type.ToLowerInvariant();
        var items = new List<ArgusMenuItem>
        {
            new("Edit Asset", () => EditAssetAsync(a)),
            new("Delete Asset", () => DeleteAssetAsync(a)),
            new ArgusMenuItem { IsSeparator = true },
            new("Send to Request Tool", () => OpenRequestTool(a.AssetId)),
            new ArgusMenuItem { IsSeparator = true },
        };
        // Data-driven, per-asset-type actions loaded from asset-service (configurable, stored in Postgres).
        var actions = _assetActions
            .Where(x => string.Equals(x.AssetType, a.Type, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.SortOrder)
            .ToList();
        if (actions.Count > 0)
        {
            items.Add(new ArgusMenuItem { IsSeparator = true });
            foreach (var act in actions)
                items.Add(new(act.Label, () => EnqueueActionAsync(a, act.TaskType, act.WorkerCapability, act.Label)));
        }
        return items;
    }

    sealed record AssetActionItem(string AssetType, string Label, string TaskType, string WorkerCapability, int SortOrder);
    List<AssetActionItem> _assetActions = new();

    async Task LoadAssetActionsAsync()
    {
        try
        {
            _assetActions = await Http.GetFromJsonAsync<List<AssetActionItem>>("/ui/asset-type-actions") ?? new();
        }
        catch (Exception ex)
        {
            AddLog($"Failed to load asset actions: {ex.Message}", error: true);
        }
    }

    async Task EnqueueActionAsync(AssetItem asset, string taskType, string workerCapability, string label)
    {
        if (_selectedProgram?.ProgramId is not { } programId) return;
        var payload = new JsonObject
        {
            ["assetIds"]         = new JsonArray(JsonValue.Create(asset.AssetId)),
            ["taskType"]         = taskType,
            ["workerCapability"] = workerCapability,
            ["programId"]        = programId,
        };
        try
        {
            using var resp = await Http.PostAsJsonAsync("/ui/assets/bulk/enqueue", payload);
            AddLog(resp.IsSuccessStatusCode ? $"Queued: {label}" : $"Enqueue failed ({(int)resp.StatusCode})", error: !resp.IsSuccessStatusCode);
        }
        catch (Exception ex)
        {
            AddLog($"Enqueue error: {ex.Message}", error: true);
        }
    }

    async Task ToggleProcessing()
    {
        _processingToggling = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var newState = !_processingEnabled;
            using var resp = await Http.PostAsJsonAsync("/ui/processing/toggle", new { enabled = newState });
            if (resp.IsSuccessStatusCode)
            {
                _processingEnabled = newState;
                AddLog(newState ? "Processing started" : "Processing stopped");
            }
            else
            {
                AddLog($"Failed to toggle processing: {resp.StatusCode}", error: true);
            }
        }
        catch (Exception ex)
        {
            AddLog($"Error toggling processing: {ex.Message}", error: true);
        }
        finally
        {
            _processingToggling = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Data loading ─────────────────────────────────────────────────────────────

    async Task LoadProgramsAsync()
    {
        try
        {
            using var resp = await Http.GetAsync("/ui/programs");
            if (!resp.IsSuccessStatusCode)
            {
                AddLog($"Programs endpoint failed ({resp.StatusCode})", error: true);
                return;
            }
            using var doc = JsonDocument.Parse(await resp.Content.ReadAsStringAsync());
            var root = doc.RootElement;
            var arr = root.ValueKind == JsonValueKind.Array
                ? root.EnumerateArray().ToList()
                : root.TryGetProperty("items", out var items)
                    ? items.EnumerateArray().ToList()
                    : [];

            _programs = arr.Select(e =>
            {
                var scopes = e.TryGetProperty("scopes", out var sc) && sc.ValueKind == JsonValueKind.Array
                    ? sc.EnumerateArray().ToList()
                    : new List<JsonElement>();

                static string ScopeField(JsonElement s, string name) =>
                    s.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";

                // Include scopes define the program's in-scope assets; exclusions are filtered out.
                var includes = scopes
                    .Where(s => !string.Equals(ScopeField(s, "action"), "Exclude", StringComparison.OrdinalIgnoreCase))
                    .ToList();

                // Primary asset: prefer a concrete domain/IP scope; fall back to the first include.
                var primaryIdx = includes.FindIndex(s =>
                    ScopeField(s, "scopeType") is "Domain" or "IpRange" or "IpAddress" or "Cidr");
                if (primaryIdx < 0 && includes.Count > 0) primaryIdx = 0;

                var asset     = primaryIdx >= 0 ? ScopeField(includes[primaryIdx], "pattern") : "";
                var assetType = primaryIdx >= 0 ? ScopeField(includes[primaryIdx], "scopeType") : "";
                var scope     = string.Join("  |  ", includes
                    .Select(s => ScopeField(s, "pattern"))
                    .Where(pat => pat.Length > 0)
                    .Select(PatternToRegex));

                return new ProgramItem(
                    ProgramId:   e.TryGetProperty("programId", out var id)  ? id.GetGuid()  :
                                e.TryGetProperty("id",        out var id2) ? id2.GetGuid() : Guid.Empty,
                    Name:        e.TryGetProperty("name",      out var n)  ? n.GetString()  ?? "" : "",
                    Asset:       asset,
                    AssetType:   assetType,
                    Scope:       scope,
                    Source:      e.TryGetProperty("source",    out var so) ? so.GetString() ?? "" : "",
                    CreatedAt:   e.TryGetProperty("createdAt", out var ca) && ca.ValueKind != JsonValueKind.Null
                                    ? ca.GetDateTimeOffset() : DateTimeOffset.MinValue);
            })
            .Where(p => p.ProgramId != Guid.Empty)
            .ToList();

            if (_programs.Count == 0)
                AddLog("No programs returned from server", error: true);
            else
                _selectedProgram ??= _programs[0];
        }
        catch (Exception ex)
        {
            AddLog($"Load programs error: {ex.Message}", error: true);
        }
    }

    // Builds the per-program asset breakdown shown in the Programs grid count columns. Fetches the full
    // (unfiltered) asset set once and groups by program + type, since there is no aggregation endpoint.
    async Task LoadProgramStatsAsync()
    {
        try
        {
            using var resp = await Http.GetAsync("/ui/ops/assets");
            if (!resp.IsSuccessStatusCode) return;

            using var doc = JsonDocument.Parse(await resp.Content.ReadAsStringAsync());
            var root = doc.RootElement;
            var arr = root.ValueKind == JsonValueKind.Array
                ? root.EnumerateArray()
                : root.TryGetProperty("items", out var items) ? items.EnumerateArray()
                : Enumerable.Empty<JsonElement>();

            var acc = new Dictionary<Guid, int[]>(); // [total, sub, url, js, api, form, login, tech]
            foreach (var e in arr)
            {
                if (!e.TryGetProperty("programId", out var pidEl) || pidEl.ValueKind != JsonValueKind.String) continue;
                if (!Guid.TryParse(pidEl.GetString(), out var pid)) continue;
                var type = e.TryGetProperty("type", out var t) ? t.GetString() ?? "" : "";

                if (!acc.TryGetValue(pid, out var c)) { c = new int[8]; acc[pid] = c; }
                c[0]++;
                switch (type.ToLowerInvariant())
                {
                    case "subdomain":      c[1]++; break;
                    case "url":            c[2]++; break;
                    case "javascriptfile": c[3]++; break;
                    case "apiendpoint":    c[4]++; break;
                    case "form":           c[5]++; break;
                    case "loginpage":      c[6]++; break;
                    case "technology":     c[7]++; break;
                }
            }

            _programStats = acc.ToDictionary(
                kv => kv.Key,
                kv => new ProgramStats(kv.Value[0], kv.Value[1], kv.Value[2], kv.Value[3], kv.Value[4], kv.Value[5], kv.Value[6], kv.Value[7]));
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            AddLog($"Program stats load error: {ex.Message}", error: true);
        }
    }

    async Task LoadAllAssetsAsync()
    {
        _loadingAssets = true;
        _showingAllAssets = true;
        _assetError = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            using var resp = await Http.GetAsync("/ui/ops/assets");
            if (!resp.IsSuccessStatusCode)
            {
                _assetError = $"Asset service unavailable ({(int)resp.StatusCode}). Retry shortly.";
                AddLog(_assetError, error: true);
                return;
            }
            var prev = _assets.Select(a => a.AssetId).ToHashSet();
            var response = await ReadAssetResponseAsync(resp);
            _assets = response.Items.Select(ParseAsset)
                .Where(a => a is not null && !string.Equals(a!.Status, "Archived", StringComparison.OrdinalIgnoreCase))
                .Cast<AssetItem>().ToList();
            _assetTotalCount = response.TotalCount;

            _topAssetTypes = _assets
                .GroupBy(a => a.Type)
                .OrderByDescending(g => g.Count())
                .Take(5)
                .ToDictionary(g => g.Key, g => g.Count());

            var newIds = _assets.Select(a => a.AssetId).ToHashSet();
            newIds.ExceptWith(prev);
            if (newIds.Count > 0)
            {
                _flashingIds.UnionWith(newIds);
                _ = Task.Run(async () =>
                {
                    await Task.Delay(2500);
                    _flashingIds.ExceptWith(newIds);
                    await InvokeAsync(StateHasChanged);
                });
            }
        }
        catch (Exception ex)
        {
            _assetError = $"Load assets error: {ex.Message}";
            AddLog(_assetError, error: true);
        }
        finally
        {
            _loadingAssets = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task LoadAssetsAsync()
    {
        if (_selectedProgram?.ProgramId is not { } programId) return;
        _loadingAssets = true;
        _showingAllAssets = false;
        _assetError = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            using var resp = await Http.GetAsync($"/ui/ops/assets?programId={programId}");
            if (!resp.IsSuccessStatusCode)
            {
                _assetError = $"Asset service unavailable ({(int)resp.StatusCode}). Retry shortly.";
                AddLog(_assetError, error: true);
                return;
            }
            var prev = _assets.Select(a => a.AssetId).ToHashSet();
            var response = await ReadAssetResponseAsync(resp);
            _assets = response.Items.Select(ParseAsset)
                .Where(a => a is not null && !string.Equals(a!.Status, "Archived", StringComparison.OrdinalIgnoreCase))
                .Cast<AssetItem>().ToList();
            _assetTotalCount = _assets.Count;

            var newIds = _assets.Select(a => a.AssetId).ToHashSet();
            newIds.ExceptWith(prev);
            if (newIds.Count > 0)
            {
                _flashingIds.UnionWith(newIds);
                _ = Task.Run(async () =>
                {
                    await Task.Delay(2500);
                    _flashingIds.ExceptWith(newIds);
                    await InvokeAsync(StateHasChanged);
                });
            }
        }
        catch (Exception ex)
        {
            _assetError = $"Load assets error: {ex.Message}";
            AddLog(_assetError, error: true);
        }
        finally
        {
            _loadingAssets = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    static AssetItem? ParseAsset(JsonElement e)
    {
        if (!e.TryGetProperty("assetId", out var idEl)) return null;
        return new AssetItem(
            AssetId:     idEl.GetGuid(),
            Type:        e.TryGetProperty("type",        out var t)  ? t.GetString()  ?? "" : "",
            Value:       e.TryGetProperty("value",       out var v)  ? v.GetString()  ?? "" : "",
            Status:      e.TryGetProperty("status",      out var s)  ? s.GetString()  ?? "" : "",
            RiskScore:   e.TryGetProperty("riskScore",   out var rs) && rs.ValueKind != JsonValueKind.Null ? rs.GetDouble() : null,
            FirstSeenAt: e.TryGetProperty("firstSeenAt", out var fs) && fs.ValueKind != JsonValueKind.Null ? fs.GetDateTimeOffset() : null,
            LastSeenAt:  e.TryGetProperty("lastSeenAt",  out var ls) && ls.ValueKind != JsonValueKind.Null ? ls.GetDateTimeOffset() : null,
            SizeBytes:   e.TryGetProperty("sizeBytes",   out var sb) && sb.ValueKind != JsonValueKind.Null ? sb.GetInt64() : null,
            ResponseTimeMs: e.TryGetProperty("responseTimeMs", out var rt) && rt.ValueKind != JsonValueKind.Null ? rt.GetInt32() : null,
            Notes:       e.TryGetProperty("notes",       out var n)  ? n.GetString()  ?? "" : "");
    }

    async Task<AssetResponse> ReadAssetResponseAsync(HttpResponseMessage response)
    {
        using var doc = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
        var root = doc.RootElement;
        // Clone each element: the JsonElements are backed by `doc`, which is disposed when this method
        // returns. Without cloning, the caller hits "Cannot access a disposed object: JsonDocument".
        var items = root.ValueKind == JsonValueKind.Array
            ? root.EnumerateArray().Select(e => e.Clone()).ToList()
            : root.TryGetProperty("items", out var itemArray)
                ? itemArray.EnumerateArray().Select(e => e.Clone()).ToList()
                : [];

        var totalCount = root.ValueKind == JsonValueKind.Object
            && root.TryGetProperty("totalCount", out var total)
            && total.ValueKind == JsonValueKind.Number
            ? total.GetInt32()
            : items.Count;

        return new AssetResponse(items, totalCount);
    }

    static TechnologyItem? ParseTechnology(JsonElement e)
    {
        if (!e.TryGetProperty("assetId", out var idEl)) return null;
        var type = e.TryGetProperty("type", out var t) ? t.GetString() ?? "" : "";
        if (!type.Equals("Technology", StringComparison.OrdinalIgnoreCase)) return null;
        var metadata = e.TryGetProperty("metadata", out var m) && m.ValueKind == JsonValueKind.Object ? m : default;
        return new TechnologyItem(
            AssetId:     idEl.GetGuid(),
            Name:        e.TryGetProperty("value", out var v) ? v.GetString() ?? "" : "",
            Category:    e.TryGetProperty("subtype", out var st) ? st.GetString() ?? "Technology" : "Technology",
            Target:      metadata.ValueKind != default && metadata.TryGetProperty("target", out var tg) ? tg.GetString() ?? "" : "",
            Confidence:  e.TryGetProperty("confidence", out var cs) && cs.ValueKind != JsonValueKind.Null ? (double)cs.GetDecimal() : 0.8,
            DiscoveredAt: e.TryGetProperty("firstSeenAt", out var fsa) && fsa.ValueKind != JsonValueKind.Null ? fsa.GetDateTimeOffset() : DateTimeOffset.UtcNow);
    }

    async Task LoadTechnologiesAsync()
    {
        _loadingTechnologies = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            using var resp = await Http.GetAsync("/ui/ops/assets?type=Technology");
            if (!resp.IsSuccessStatusCode)
            {
                AddLog($"Technology load failed: {(int)resp.StatusCode}", error: true);
                return;
            }
            using var doc = JsonDocument.Parse(await resp.Content.ReadAsStringAsync());
            var root = doc.RootElement;
            var arr = root.ValueKind == JsonValueKind.Array
                ? root.EnumerateArray().ToList()
                : root.TryGetProperty("items", out var items)
                    ? items.EnumerateArray().ToList()
                    : [];

            _technologies = arr.Select(ParseTechnology)
                .Where(t => t is not null)
                .Cast<TechnologyItem>()
                .OrderByDescending(t => t.Confidence)
                .ThenBy(t => t.Name)
                .ToList();
        }
        catch (Exception ex)
        {
            AddLog($"Technology load error: {ex.Message}", error: true);
        }
        finally
        {
            _loadingTechnologies = false;
            await InvokeAsync(StateHasChanged);
        }
    }

