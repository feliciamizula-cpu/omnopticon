            var refreshed = _programs.FirstOrDefault(x => x.ProgramId == p.ProgramId) ?? _selectedProgram;
            if (refreshed is not null)
                await SelectProgram(refreshed);
        }
    }

    // ── Helpers ──────────────────────────────────────────────────────────────────

    void AddLog(string msg, bool error = false)
    {
        _log.Insert(0, new LogEntry(msg, error));
        if (_log.Count > 100) _log.RemoveAt(_log.Count - 1);
    }

    string RowClassFn(AssetItem a) => _flashingIds.Contains(a.AssetId) ? "row-new" : "";

    static string FmtAgo(DateTimeOffset? dt)
    {
        if (dt is null) return "—";
        var ago = DateTimeOffset.UtcNow - dt.Value;
        if (ago.TotalMinutes < 1) return "just now";
        if (ago.TotalHours   < 1) return $"{(int)ago.TotalMinutes}m ago";
        if (ago.TotalDays    < 1) return $"{(int)ago.TotalHours}h ago";
        return $"{(int)ago.TotalDays}d ago";
    }

    // Turns a scope pattern (e.g. "*.att.com") into an anchored matching regex for the Scope column.
    static string PatternToRegex(string pattern)
    {
        if (string.IsNullOrWhiteSpace(pattern)) return "";
        var escaped = System.Text.RegularExpressions.Regex.Escape(pattern).Replace("\\*", ".*");
        return $"^{escaped}$";
    }

    static string FormatBytes(long bytes)
    {
        string[] suffixes = ["B", "KB", "MB", "GB", "TB"];
        int i;
        double dblBytes = bytes;
        for (i = 0; i < suffixes.Length - 1 && dblBytes >= 1024; i++)
            dblBytes /= 1024;
        return $"{dblBytes:F1} {suffixes[i]}";
    }
