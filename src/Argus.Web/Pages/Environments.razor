        string DeploymentSpendUsd,
        string CapStatus,
        string Source,
        bool IsOverCap);

    private sealed record EnvironmentDeployment(string Sha, string Branch, string Workflow, string DeployedAt);
    private sealed record EnvironmentComponent(string Name, string Status, string Detail);
    private sealed record EnvironmentService(string Name, string Url, string Health);
    private sealed record EnvironmentVmOpResult(bool Success, string Action, string Message, string Command);
