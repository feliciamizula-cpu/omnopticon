@page "/agents"
@page "/development/agents"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@using System.Net.Http.Json
@using System.Text.Json
@using Argus.Contracts.Agents
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject DevelopmentRealtimeClient Realtime

<PageHeader Title="Agents" Subtitle="@($"{FilteredAgents.Count:N0} visible · {_agents.Count:N0} total")" />

<div class="page-body dev-page">
    <div class="dev-main">
        <div class="page-tabs">
            @foreach (var tab in RoleTabs)
            {
                <button class="page-tab @( _roleFilter == tab.Id ? "active" : "" )" @onclick="() => SetRoleFilter(tab.Id)">
                    <span>@tab.Label</span>
                    <span class="tab-count">@tab.Count</span>
                </button>
            }
            <div class="page-tab-spacer"></div>
            <div class="page-tab-actions">
                <button class="btn primary tiny" @onclick="OpenCreateModal">+ Spawn Agent</button>
                <button class="btn ghost tiny" @onclick="() => LoadData()">Refresh</button>
                <button class="btn danger tiny" @onclick="PauseActiveFleet" disabled="@(!_agents.Any(a => IsActive(a)))">Pause Fleet</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="dev-alert">@_error</div>
        }

        @if (!string.IsNullOrWhiteSpace(_notice))
        {
            <div class="dev-alert" style="background: var(--green-bg); color: var(--green);">@_notice</div>
        }

        <div class="dev-stats-strip">
            <DevStat Label="Total agents" Value='@(_agents.Count.ToString("N0"))' Sub='@($"{_agents.Count(a => !IsActive(a)):N0} paused/disabled")' />
            <DevStat Label="Working" Value='@(_agents.Count(a => IsWorking(a)).ToString("N0"))' Tone="cyan" Sub="active claims" />
            <DevStat Label="Idle" Value='@(_agents.Count(a => IsIdle(a)).ToString("N0"))' Sub="awaiting tasks" />
            <DevStat Label="Stalled" Value='@(_agents.Count(a => IsStalled(a)).ToString("N0"))' Tone='@(_agents.Any(IsStalled) ? "red" : "")' Sub='@(_agents.Any(IsStalled) ? "needs attention" : "ok")' />
            <DevStat Label="CLIs in use" Value='@(_agents.Select(a => NormalizeTool(a.Tool)).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString("N0"))' Sub='@(string.Join(", ", _agents.Select(a => NormalizeTool(a.Tool)).Distinct(StringComparer.OrdinalIgnoreCase).Take(3)))' />
            <DevStat Label="Tasks pending" Value='@(_tasks.Count(t => IsPending(t)).ToString("N0"))' Tone="amber" Sub="agent backlog" />
            <DevStat Label="Tasks active" Value='@(_tasks.Count(t => IsTaskActive(t)).ToString("N0"))' Tone="magenta" Sub="claimed/in progress" />
            <DevStat Label="Attempts" Value='@(_tasks.Sum(t => t.Attempts).ToString("N0"))' Sub="queue retry load" />
        </div>

        @if (_loading)
        {
            <div class="dev-empty">
                <div>
                    <div class="app-loading-spinner" style="margin: 0 auto 12px;"></div>
                    <div>// loading agent fleet</div>
                </div>
            </div>
        }
        else
        {
            <div class="dev-two-pane">
                <div class="dev-list-pane">
                    <div class="mono-label">FLEET · @FilteredAgents.Count agents</div>

                    @if (FilteredAgents.Count == 0)
                    {
                        <div class="dev-empty">// no agents match this filter</div>
                    }
                    else
                    {
                        <div class="agent-table">
                            <div class="at-head">
                                <div class="at-cell at-status"></div>
                                <div class="at-cell at-name">Name</div>
                                <div class="at-cell at-tool">CLI</div>
                                <div class="at-cell at-role">Role</div>
                                <div class="at-cell at-status-col">Status</div>
                                <div class="at-cell at-tasks">Tasks</div>
                                <div class="at-cell at-heartbeat">Heartbeat</div>
                                <div class="at-cell at-workstatus">Work</div>
                            </div>
                            <div class="at-body">
                                @foreach (var agent in FilteredAgents)
                                {
                                    var currentTask = CurrentTask(agent);
                                    <div class="at-row @(SelectedAgent?.AgentId == agent.AgentId ? "selected" : "") @(!IsActive(agent) ? "disabled" : "")"
                                         @onclick="() => SelectAgent(agent)">
                                        <div class="at-cell at-status">
                                            <span class="dot @StatusDot(agent) @(IsWorking(agent) ? "pulse" : "")"></span>
                                        </div>
                                        <div class="at-cell at-name">
                                            <span class="tone-@RoleTone(agent.Role) mono">@RoleGlyph(agent.Role)</span>
                                            <span class="at-agent-name">@agent.Name</span>
                                            <span class="at-agent-id">@ShortId(agent.AgentId)</span>
                                        </div>
                                        <div class="at-cell at-tool">
                                            <span class="tone-@ToolTone(agent.Tool)">@ToolLabel(agent.Tool)</span>
                                            <span class="at-model">@agent.Model</span>
                                        </div>
                                        <div class="at-cell at-role">
                                            <span class="dev-pill @RoleTone(agent.Role)">@RoleLabel(agent.Role)</span>
                                        </div>
                                        <div class="at-cell at-status-col">
                                            <span class="dev-pill @StatusTone(agent)">@AgentStatusLabel(agent)</span>
                                        </div>
                                        <div class="at-cell at-tasks">
                                            @AssignedTaskCount(agent)
                                        </div>
                                        <div class="at-cell at-heartbeat">
                                            <span class="@HeartbeatTone(agent)">@Relative(agent.LastHeartbeatAt)</span>
                                        </div>
                                        <div class="at-cell at-workstatus">
                                            @if (currentTask is not null)
                                            {
                                                <span class="at-current-task" title="@currentTask.Description">@currentTask.TaskId</span>
                                            }
                                            else
                                            {
                                                <span class="at-idle">idle</span>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(agent.LastError))
                                    {
                                        <div class="at-error-row">
                                            <span class="dev-error">⚠ @agent.LastError</span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="dev-inspector">
                    @if (SelectedAgent is null)
                    {
                        <div class="dev-empty">// select an agent</div>
                    }
                    else
                    {
                        var selectedAgent = SelectedAgent!;
                        <div class="dev-inspector-head">
                            <div class="type-row">
                                <span class="tone-@RoleTone(selectedAgent.Role) mono">@RoleGlyph(selectedAgent.Role)</span>
                                <span class="dev-pill @RoleTone(selectedAgent.Role)">@RoleLabel(selectedAgent.Role)</span>
                                <span class="dev-pill @StatusTone(selectedAgent)">@AgentStatusLabel(selectedAgent)</span>
                                <span class="asset-id">@ShortId(selectedAgent.AgentId)</span>
                            </div>
                            <div class="value-big">@selectedAgent.Name</div>
                            <div class="submeta">
                                <span><span class="tone-@ToolTone(selectedAgent.Tool)">@ToolLabel(selectedAgent.Tool)</span> · <b>@selectedAgent.Model</b></span>
                                <span>heartbeat <b class="@HeartbeatTone(selectedAgent)">@Relative(selectedAgent.LastHeartbeatAt)</b></span>
                                <span>created <b>@Relative(selectedAgent.CreatedAt)</b></span>
                            </div>
                        </div>

                        <div class="inspector-tabs">
                            @foreach (var tab in DetailTabs)
                            {
                                <button class="insp-tab @( _detailTab == tab ? "active" : "" )" @onclick="() => _detailTab = tab">@tab</button>
                            }
                        </div>

                        <div class="dev-inspector-body">
                            @if (_detailTab == "config")
                            {
                                <div class="section-label">RUNTIME</div>
                                <table class="kv-table">
                                    <tbody>
                                        <tr><td>Agent ID</td><td class="mono">@selectedAgent.AgentId</td></tr>
                                        <tr><td>Status</td><td><span class="dev-pill @StatusTone(selectedAgent)">@AgentStatusLabel(selectedAgent)</span></td></tr>
                                        <tr><td>Role</td><td><span class="dev-pill @RoleTone(selectedAgent.Role)">@RoleLabel(selectedAgent.Role)</span></td></tr>
                                        <tr><td>CLI</td><td><span class="tone-@ToolTone(selectedAgent.Tool)">@ToolLabel(selectedAgent.Tool)</span></td></tr>
                                        <tr><td>Model</td><td class="mono">@selectedAgent.Model</td></tr>
                                        <tr><td>Work status</td><td>@(string.IsNullOrWhiteSpace(selectedAgent.WorkStatus) ? "—" : selectedAgent.WorkStatus)</td></tr>
                                        <tr><td>Current task</td><td>@(selectedAgent.CurrentTaskId ?? "—")</td></tr>
                                        <tr><td>Last heartbeat</td><td class="@HeartbeatTone(selectedAgent)">@Relative(selectedAgent.LastHeartbeatAt)</td></tr>
                                    </tbody>
                                </table>

                                <div class="section-label">RESPONSIBILITIES</div>
                                <div class="dev-chipline" style="padding: 0 12px 10px; margin-top: 0;">
                                    @if (selectedAgent.Responsibilities.Length == 0)
                                    {
                                        <span class="dev-chip">// none configured</span>
                                    }
                                    else
                                    {
                                        @foreach (var item in selectedAgent.Responsibilities)
                                        {
                                            <span class="dev-chip">@item</span>
                                        }
                                    }
                                </div>

                                <div class="section-label">CURRENT WORK</div>
                                @if (CurrentTask(selectedAgent) is AgentTaskDto task)
                                {
                                    <div class="dev-note">
Task @task.TaskId · @task.Priority · @task.Status
@task.Description
                                    </div>
                                }
                                else
                                {
                                    <div class="dev-note">// agent is idle</div>
                                }

                                @if (!string.IsNullOrWhiteSpace(selectedAgent.LastError))
                                {
                                    <div class="section-label">LAST ERROR</div>
                                    <div class="dev-note warn">@selectedAgent.LastError</div>
                                }

                                <div class="section-label">CONTROLS</div>
                                <div class="dev-action-row">
                                    @if (IsActive(selectedAgent))
                                    {
                                        <button class="btn primary tiny" @onclick="() => PauseAgent(selectedAgent.AgentId)">Disable</button>
                                    }
                                    else
                                    {
                                        <button class="btn primary tiny" @onclick="() => ResumeAgent(selectedAgent.AgentId)">Enable</button>
                                    }
                                    <button class="btn ghost tiny" @onclick="() => OpenEditModal(selectedAgent)">Edit Config</button>
                                    <button class="btn ghost tiny" @onclick="() => LoadData()">Refresh</button>
                                    <a class="btn ghost tiny" href="/agent-tasks">Open Tasks</a>
                                    <button class="btn danger tiny" @onclick="() => DeleteAgent(selectedAgent.AgentId)">Remove</button>
                                </div>
                            }
                            else if (_detailTab == "tasks")
                            {
                                <div class="section-label">ASSIGNED TASKS · @AssignedTasks(selectedAgent).Count</div>
                                @if (AssignedTasks(selectedAgent).Count == 0)
                                {
                                    <div class="dev-note">// no assigned tasks</div>
                                }
                                else
                                {
                                    <table class="kv-table">
                                        <thead>
                                            <tr><th>Task</th><th>Status</th><th>Priority</th><th>Created</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var task in AssignedTasks(selectedAgent))
                                            {
                                                <tr>
                                                    <td><a href="/agent-tasks" class="mono">@task.TaskId</a><div style="color: var(--fg-2);">@task.Description</div></td>
                                                    <td><span class="dev-pill @TaskStatusTone(task.Status)">@TaskStatusLabel(task.Status)</span></td>
                                                    <td><span class="dev-pill @PriorityTone(task.Priority)">@task.Priority</span></td>
                                                    <td>@Relative(task.CreatedAt)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            }
                            else
                            {
                                <div class="section-label">LIVE LOG · synthesized from agent state</div>
                                <div class="dev-event-row">
                                    <span class="t">@DateTimeOffset.Now.ToString("HH:mm:ss")</span>
                                    <span class="k cyan">STATE</span>
                                    <span class="body">@selectedAgent.Name is @(AgentStatusLabel(selectedAgent).ToLowerInvariant()) with @AssignedTaskCount(selectedAgent) assigned tasks.</span>
                                </div>
                                <div class="dev-event-row">
                                    <span class="t">@selectedAgent.UpdatedAt.ToLocalTime().ToString("HH:mm:ss")</span>
                                    <span class="k amber">CONFIG</span>
                                    <span class="body">tool=@selectedAgent.Tool model=@selectedAgent.Model role=@selectedAgent.Role</span>
                                </div>
                                @if (selectedAgent.LastHeartbeatAt is not null)
                                {
                                    <div class="dev-event-row">
                                        <span class="t">@selectedAgent.LastHeartbeatAt.Value.ToLocalTime().ToString("HH:mm:ss")</span>
                                        <span class="k green">HEART</span>
                                        <span class="body">heartbeat received @Relative(selectedAgent.LastHeartbeatAt)</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(selectedAgent.LastError))
                                {
                                    <div class="dev-event-row">
                                        <span class="t">@selectedAgent.UpdatedAt.ToLocalTime().ToString("HH:mm:ss")</span>
                                        <span class="k red">ERROR</span>
                                        <span class="body">@selectedAgent.LastError</span>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@if (_showAgentModal)
{
    <div class="dev-page">
        <div class="dev-modal-overlay" @onclick="CloseAgentModal">
            <div class="dev-modal" @onclick:stopPropagation="true">
                <div class="dev-modal-head">
                    <span class="dot amber"></span>
                    @(_editingAgentId is null ? "Spawn New Agent" : "Edit Agent")
                    <button class="dev-icon-btn" @onclick="CloseAgentModal">×</button>
                </div>
                <div class="dev-modal-body">
                    <div class="dev-form-grid">
                        <div class="dev-form-field">
                            <label>Name</label>
                            <input class="dev-input" @bind="_agentForm.Name" @bind:event="oninput" placeholder="Agent name" />
                        </div>
                        <div class="dev-form-field">
                            <label>Role</label>
                            <select class="dev-input" @bind="_agentForm.Role">
                                <option value="product_manager">Product Manager</option>
                                <option value="chief_technology_officer">Chief Technology Officer</option>
                                <option value="junior_developer">Junior Developer</option>
                                <option value="devops">DevOps</option>
                                <option value="developer">Developer</option>
                                <option value="senior_developer">Senior Developer</option>
                                <option value="system_architect">System Architect</option>
                                <option value="junior_designer">Junior Designer</option>
                                <option value="senior_designer">Senior Designer</option>
                            </select>
                        </div>
                        <div class="dev-form-field">
                            <label>CLI</label>
                            <select class="dev-input" @bind="_agentForm.Tool">
                                <option value="claude">Claude</option>
                                <option value="codex">Codex</option>
                                <option value="gemini">Gemini</option>
                                <option value="openai">OpenAI</option>
                                <option value="opencode">Opencode</option>
                            </select>
                        </div>
                        <div class="dev-form-field">
                            <label>Model</label>
                            <input class="dev-input" @bind="_agentForm.Model" @bind:event="oninput" placeholder="claude-sonnet-4-6" />
                        </div>
                        <div class="dev-form-field">
                            <label>Priority order</label>
                            <input class="dev-input" type="number" min="0" @bind="_agentForm.SortOrder" />
                        </div>
                        <div class="dev-form-field full">
                            <label>Role description</label>
                            <textarea class="dev-input" rows="3" @bind="_agentForm.RoleDescription" @bind:event="oninput" placeholder="Describe what this agent is responsible for."></textarea>
                        </div>
                        <div class="dev-form-field full">
                            <label>Responsibilities</label>
                            <textarea class="dev-input" rows="5" @bind="_agentForm.ResponsibilitiesText" @bind:event="oninput" placeholder="implementation, tests, code review"></textarea>
                        </div>
                        <div class="dev-form-field full">
                            <label>Spawn command</label>
                            <div class="dev-note" style="margin: 0;">@ToolCommand(_agentForm.Tool) --model @_agentForm.Model ...</div>
                        </div>
                    </div>
                </div>
                <div class="dev-modal-foot">
                    <button class="btn ghost" @onclick="CloseAgentModal">Cancel</button>
                    <button class="btn primary" @onclick="SaveAgent" disabled="@(!CanSaveAgent)">Save Agent</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly JsonSerializerOptions _jsonOptions = new(JsonSerializerDefaults.Web)
    {
        PropertyNameCaseInsensitive = true
    };

    private List<AgentDto> _agents = new();
    private List<AgentTaskDto> _tasks = new();
    private bool _loading = true;
    private string _roleFilter = "all";
    private string _detailTab = "config";
    private string? _error;
    private string? _notice;
    private Guid? _selectedAgentId;

    private bool _showAgentModal;
    private Guid? _editingAgentId;
    private AgentForm _agentForm = new();

    private static readonly string[] DetailTabs = ["config", "tasks", "logs"];

    private AgentDto? SelectedAgent =>
        _agents.FirstOrDefault(a => a.AgentId == _selectedAgentId) ?? _agents.FirstOrDefault();

    private List<AgentDto> FilteredAgents
    {
        get
        {
            var agents = _roleFilter == "all"
                ? _agents
                : _agents.Where(a => RoleMatches(a.Role, _roleFilter));
            return agents.OrderByDescending(IsWorking)
                .ThenByDescending(IsActive)
                .ThenBy(a => RoleLabel(a.Role))
                .ThenBy(a => a.Name)
                .ToList();
        }
    }

    private List<RoleTab> RoleTabs =>
    [
        new("all", "All Agents", _agents.Count),
        new("junior_developer", "Junior Dev", _agents.Count(a => RoleMatches(a.Role, "junior_developer"))),
        new("developer", "Developer", _agents.Count(a => RoleMatches(a.Role, "developer"))),
        new("senior_developer", "Senior Dev", _agents.Count(a => RoleMatches(a.Role, "senior_developer"))),
        new("system_architect", "Architect", _agents.Count(a => RoleMatches(a.Role, "system_architect"))),
        new("devops", "DevOps", _agents.Count(a => RoleMatches(a.Role, "devops"))),
        new("design", "Design", _agents.Count(a => RoleMatches(a.Role, "design")))
    ];

    private bool CanSaveAgent =>
        !string.IsNullOrWhiteSpace(_agentForm.Name)
        && !string.IsNullOrWhiteSpace(_agentForm.Role)
        && !string.IsNullOrWhiteSpace(_agentForm.Tool)
        && !string.IsNullOrWhiteSpace(_agentForm.Model);

    protected override async Task OnInitializedAsync()
    {
        Realtime.Changed += OnDevelopmentDataChanged;
        await Realtime.StartAsync();
        await LoadData();
    }

    private async Task LoadData(bool showLoading = true)
    {
        _loading = showLoading && _agents.Count == 0 && _tasks.Count == 0;
        _error = null;
        _notice = null;

        try
        {
            await Task.WhenAll(LoadAgentsAsync(), LoadTasksAsync());
        }
        catch (Exception ex)
        {
            _error = $"Unable to load agent development data: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAgentsAsync()
    {
        var agentsResponse = await Http.GetAsync(Ui("/ui/agents"));
        _agents = await ReadItemsAsync<AgentDto>(agentsResponse);
        if (_selectedAgentId is null || !_agents.Any(a => a.AgentId == _selectedAgentId))
        {
            _selectedAgentId = _agents.FirstOrDefault()?.AgentId;
        }
        StateHasChanged();
    }

    private async Task LoadTasksAsync()
    {
        var tasksResponse = await Http.GetAsync(Ui("/ui/agent-tasks"));
        _tasks = await ReadItemsAsync<AgentTaskDto>(tasksResponse);
        StateHasChanged();
    }

    private Task OnDevelopmentDataChanged(DevelopmentDataChangedEvent change)
    {
        if (change.Area is "agents" or "agent-tasks" or "todos")
        {
            return InvokeAsync(() => LoadData(showLoading: false));
        }

        return Task.CompletedTask;
    }

    public ValueTask DisposeAsync()
    {
        Realtime.Changed -= OnDevelopmentDataChanged;
        return ValueTask.CompletedTask;
    }

    private string Ui(string path) => Nav.ToAbsoluteUri(path).ToString();

    private async Task<List<T>> ReadItemsAsync<T>(HttpResponseMessage response)
    {
        if (!response.IsSuccessStatusCode)
        {
            var body = await response.Content.ReadAsStringAsync();
            _error = $"Backend returned {(int)response.StatusCode}: {body}";
            return new List<T>();
        }

        await using var stream = await response.Content.ReadAsStreamAsync();
        using var document = await JsonDocument.ParseAsync(stream);

        if (document.RootElement.ValueKind == JsonValueKind.Array)
        {
            return JsonSerializer.Deserialize<List<T>>(document.RootElement.GetRawText(), _jsonOptions) ?? new List<T>();
        }

        if (document.RootElement.ValueKind == JsonValueKind.Object
            && document.RootElement.TryGetProperty("items", out var items)
            && items.ValueKind == JsonValueKind.Array)
        {
            return JsonSerializer.Deserialize<List<T>>(items.GetRawText(), _jsonOptions) ?? new List<T>();
        }

        return new List<T>();
    }

    private void SetRoleFilter(string id)
    {
        _roleFilter = id;
        var first = FilteredAgents.FirstOrDefault();
        if (first is not null)
        {
            _selectedAgentId = first.AgentId;
        }
    }

    private void SelectAgent(AgentDto agent)
    {
        _selectedAgentId = agent.AgentId;
    }

    private void OpenCreateModal()
    {
        _editingAgentId = null;
        _agentForm = new AgentForm
        {
            Name = $"Agent {_agents.Count + 1}",
            Role = "developer",
            Tool = "claude",
            Model = "claude-sonnet-4-6",
            SortOrder = 10,
            ResponsibilitiesText = "implementation, tests, code review"
        };
        _showAgentModal = true;
    }

    private void OpenEditModal(AgentDto agent)
    {
        _editingAgentId = agent.AgentId;
        _agentForm = new AgentForm
        {
            Name = agent.Name,
            Role = agent.Role,
            RoleDescription = agent.RoleDescription ?? "",
            SortOrder = agent.SortOrder,
            Tool = agent.Tool,
            Model = agent.Model,
            ResponsibilitiesText = string.Join(", ", agent.Responsibilities)
        };
        _showAgentModal = true;
    }

    private void CloseAgentModal()
    {
        _showAgentModal = false;
        _editingAgentId = null;
    }

    private async Task SaveAgent()
    {
        if (!CanSaveAgent)
        {
            return;
        }

        _error = null;
        _notice = null;
        var responsibilities = SplitResponsibilities(_agentForm.ResponsibilitiesText);

        try
        {
            HttpResponseMessage response;
            var wasEdit = _editingAgentId is not null;

            if (_editingAgentId is Guid id)
            {
                var request = new UpdateAgentRequest(
                    Name: _agentForm.Name.Trim(),
                    Role: _agentForm.Role.Trim(),
                    RoleDescription: string.IsNullOrWhiteSpace(_agentForm.RoleDescription) ? null : _agentForm.RoleDescription.Trim(),
                    SortOrder: _agentForm.SortOrder,
                    Responsibilities: responsibilities,
                    Tool: _agentForm.Tool.Trim(),
                    Model: _agentForm.Model.Trim());

                response = await Http.PutAsJsonAsync(Ui($"/ui/agents/{id}"), request);
            }
            else
            {
                var request = new CreateAgentRequest(
                    _agentForm.Name.Trim(),
                    _agentForm.Role.Trim(),
                    responsibilities,
                    _agentForm.Tool.Trim(),
                    _agentForm.Model.Trim(),
                    string.IsNullOrWhiteSpace(_agentForm.RoleDescription) ? null : _agentForm.RoleDescription.Trim(),
                    _agentForm.SortOrder);

                response = await Http.PostAsJsonAsync(Ui("/ui/agents"), request);
            }

            if (!response.IsSuccessStatusCode)
            {
                _error = $"Save failed with status {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
                return;
            }

            CloseAgentModal();
            await LoadData();
            _notice = wasEdit ? "Agent updated." : "Agent saved.";
        }
        catch (Exception ex)
        {
            _error = $"Unable to save agent: {ex.Message}";
        }
    }

    private async Task PauseAgent(Guid agentId)
    {
        await PatchAgent(agentId, "pause");
    }

    private async Task ResumeAgent(Guid agentId)
    {
        await PatchAgent(agentId, "resume");
    }

    private async Task PatchAgent(Guid agentId, string operation)
    {
        _error = null;
        try
        {
            var response = await Http.PatchAsync(Ui($"/ui/agents/{agentId}/{operation}"), null);
            if (!response.IsSuccessStatusCode)
            {
                _error = $"{operation} failed with status {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
            }
            await LoadData();
        }
        catch (Exception ex)
        {
            _error = $"Unable to {operation} agent: {ex.Message}";
        }
    }

    private async Task PauseActiveFleet()
    {
        var activeAgents = _agents.Where(IsActive).Select(a => a.AgentId).ToList();
        foreach (var agentId in activeAgents)
        {
            try
            {
                await Http.PatchAsync(Ui($"/ui/agents/{agentId}/pause"), null);
            }
            catch
            {
                // Keep pausing the rest; the final refresh surfaces current state.
            }
        }

        await LoadData();
    }

    private async Task DeleteAgent(Guid agentId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Remove this agent from the development fleet?"))
        {
            return;
        }

        _error = null;
        try
        {
            var response = await Http.DeleteAsync(Ui($"/ui/agents/{agentId}"));
            if (!response.IsSuccessStatusCode)
            {
                _error = $"Delete failed with status {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
            }
            await LoadData();
        }
        catch (Exception ex)
        {
            _error = $"Unable to delete agent: {ex.Message}";
        }
    }

    private List<AgentTaskDto> AssignedTasks(AgentDto agent) =>
        _tasks.Where(t => string.Equals(t.AssignedTo, agent.AgentId.ToString(), StringComparison.OrdinalIgnoreCase)
                          || string.Equals(t.AssignedTo, agent.Name, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(t => IsTaskActive(t))
            .ThenByDescending(t => t.CreatedAt)
            .ToList();

    private AgentTaskDto? CurrentTask(AgentDto agent)
    {
        if (!string.IsNullOrWhiteSpace(agent.CurrentTaskId))
        {
            var exact = _tasks.FirstOrDefault(t => string.Equals(t.TaskId, agent.CurrentTaskId, StringComparison.OrdinalIgnoreCase));
            if (exact is not null)
            {
                return exact;
            }
        }

        return AssignedTasks(agent).FirstOrDefault(IsTaskActive);
    }

    private int AssignedTaskCount(AgentDto agent) => AssignedTasks(agent).Count;

    private static string[] SplitResponsibilities(string value) =>
        value.Split([',', '\n', ';'], StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private static bool IsActive(AgentDto agent) =>
        agent.Status.Equals("active", StringComparison.OrdinalIgnoreCase)
        || agent.Status.Equals("enabled", StringComparison.OrdinalIgnoreCase)
        || string.IsNullOrWhiteSpace(agent.Status);

    private static bool IsWorking(AgentDto agent) =>
        agent.WorkStatus.Equals("working", StringComparison.OrdinalIgnoreCase)
        || agent.WorkStatus.Equals("busy", StringComparison.OrdinalIgnoreCase)
        || !string.IsNullOrWhiteSpace(agent.CurrentTaskId);

    private static bool IsIdle(AgentDto agent) =>
        IsActive(agent) && !IsWorking(agent) && !IsStalled(agent);

    private static bool IsStalled(AgentDto agent) =>
        agent.WorkStatus.Equals("stalled", StringComparison.OrdinalIgnoreCase)
        || !string.IsNullOrWhiteSpace(agent.LastError)
        || (agent.LastHeartbeatAt is { } heartbeat && DateTimeOffset.UtcNow - heartbeat > TimeSpan.FromMinutes(2) && IsActive(agent));

    private static bool IsPending(AgentTaskDto task) =>
        task.Status.Equals("pending", StringComparison.OrdinalIgnoreCase)
        || task.Status.Equals("queued", StringComparison.OrdinalIgnoreCase)
        || string.IsNullOrWhiteSpace(task.Status);

    private static bool IsTaskActive(AgentTaskDto task) =>
        task.Status.Equals("claimed", StringComparison.OrdinalIgnoreCase)
        || task.Status.Equals("in_progress", StringComparison.OrdinalIgnoreCase)
        || task.Status.Equals("running", StringComparison.OrdinalIgnoreCase);

    private static bool RoleMatches(string role, string filter)
    {
        var normalized = NormalizeRole(role);
        return filter switch
        {
            "design" => normalized is "junior_designer" or "senior_designer",
            _ => string.Equals(normalized, filter, StringComparison.OrdinalIgnoreCase)
        };
    }

    private static string NormalizeRole(string role) =>
        string.IsNullOrWhiteSpace(role) ? "developer" : role.Trim().ToLowerInvariant();

    private static string NormalizeTool(string tool) =>
        string.IsNullOrWhiteSpace(tool) ? "cli" : tool.Trim().ToLowerInvariant();

