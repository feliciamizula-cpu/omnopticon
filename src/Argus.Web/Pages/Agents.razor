    private static string AgentStatusLabel(AgentDto agent)
    {
        if (!IsActive(agent))
        {
            return agent.Status.ToUpperInvariant();
        }

        if (IsStalled(agent))
        {
            return "STALLED";
        }

        return IsWorking(agent) ? "WORKING" : "IDLE";
    }

    private static string StatusTone(AgentDto agent)
    {
        if (!IsActive(agent))
        {
            return "dim";
        }

        if (IsStalled(agent))
        {
            return "red";
        }

        return IsWorking(agent) ? "cyan" : "dim";
    }

    private static string StatusDot(AgentDto agent)
    {
        if (!IsActive(agent))
        {
            return "";
        }

        if (IsStalled(agent))
        {
            return "red";
        }

        return IsWorking(agent) ? "cyan" : "green";
    }

    private static string TaskStatusTone(string status) => status.ToLowerInvariant() switch
    {
        "completed" or "succeeded" => "green",
        "failed" => "red",
        "blocked" => "amber",
        "claimed" or "in_progress" or "running" => "cyan",
        _ => "dim"
    };

    private static string TaskStatusLabel(string status) =>
        string.IsNullOrWhiteSpace(status) ? "pending" : status.Replace("_", " ");

    private static string PriorityTone(string priority) => priority.ToLowerInvariant() switch
    {
        "critical" => "red",
        "high" => "amber",
        "medium" or "normal" => "cyan",
        _ => "dim"
    };

    private static string HeartbeatTone(AgentDto agent) => HeartbeatTone(agent.LastHeartbeatAt);

    private static string HeartbeatTone(DateTimeOffset? heartbeat)
    {
        if (heartbeat is null)
        {
            return "tone-dim";
        }

        return DateTimeOffset.UtcNow - heartbeat > TimeSpan.FromMinutes(2) ? "tone-red" : "tone-green";
    }

    private static string ShortId(Guid id) => id.ToString("N")[..8];

    private static string Relative(DateTimeOffset? value)
    {
        if (value is null)
        {
            return "never";
        }

        return Relative(value.Value);
    }

    private static string Relative(DateTimeOffset value)
    {
        var span = DateTimeOffset.UtcNow - value.ToUniversalTime();
        if (span < TimeSpan.Zero)
        {
            span = TimeSpan.Zero;
        }

        if (span.TotalSeconds < 60)
        {
            return $"{Math.Max(1, (int)span.TotalSeconds)}s ago";
        }

        if (span.TotalMinutes < 60)
        {
            return $"{(int)span.TotalMinutes}m ago";
        }

        if (span.TotalHours < 24)
        {
            return $"{(int)span.TotalHours}h ago";
        }

        return $"{(int)span.TotalDays}d ago";
    }

